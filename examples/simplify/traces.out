(declare-const J (Seq Int))

(declare-const n Int)

(declare-fun f (Int) Int)

(declare-const K (Seq Int))

(assert
  (=
    (trace
      (s 0)
      ((j J))
      (eps ((< j n) (+ j s)) ((<= n j) s)))
    (trace (s 0) ((j J)) s)))

(assert
  (= (map ((j J)) j) J))

(assert
  (all ((j J)) (< (* 2 j) n)))

(assert
  (all ((k K)) (< 0 n)))

