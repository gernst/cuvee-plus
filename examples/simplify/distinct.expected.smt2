; distinct is n-ary, two arguments are simplified to a negated equation
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (not (= x y)))
(assert (distinct x y z))
(assert false)
(assert true)
(assert false)
(assert true)
(assert (=> (= x y) (distinct x y z)))
(assert (forall ((a Int) (b Int)) (not (= a b))))
