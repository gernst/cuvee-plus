const x: int;

const y: int;

const p: bool;

const q: bool;

const a: [int]int;

const m: [int, int]int;

axiom x + y + 0 == x + (y + 0);

axiom (x + y) * (x - y) == 0;

axiom p ==> q ==> p;

axiom (p ==> q) ==> p;

axiom (p || q) && x < y;

axiom x != y;

axiom !(p && q);

axiom m[x, y] == 0;

axiom m[x, y := 0] == m;

axiom (lambda x: int, y: int :: x + y) == m;

axiom (lambda x: int :: y) == a;

axiom a[x := 0][y := 0] == a;

axiom (forall x: int :: x < y) && p;

axiom (if p then x else y) + 0 == 0;

