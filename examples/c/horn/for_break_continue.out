(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-const main_pre Bool)

(declare-fun main_post (Int) Bool)

(declare-fun main_assign_1 (Int Int Int Int) Bool)

(declare-fun main_assign_2 (Int Int Int Int) Bool)

(declare-fun main_inv_3 (Int Int Int Int) Bool)

(declare-fun main_exit_4 (Int Int Int Int) Bool)

(declare-fun
  main_spec_5
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_6
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_join_7
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_8
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_9
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_inv_10
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_exit_11
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_spec_12
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_13
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_join_14
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_15
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_16
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_spec_17
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_join_18
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_19
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_20
  (Int Int Int Int Int)
  Bool)

(declare-fun main_spec_21 (Int Int Int Int) Bool)

(declare-fun main_assign_22 (Int Int Int Int) Bool)

(assert (=> true main_pre))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      main_pre
      (main_assign_1 result i$1 j$2 0))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int))
    (=>
      (main_assign_1 result i$1 j$2 k$3)
      (main_assign_2 result 0 j$2 k$3))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int))
    (=>
      (main_assign_2 result i$1 j$2 k$3)
      (main_inv_3 result i$1 j$2 k$3))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int))
    (=>
      (and
        (main_inv_3 result i$1 j$2 k$3)
        (< i$1 10))
      (= k$3 i$1))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_inv_3 result i$1 j$2 k$3)
        (< i$1 10)
        true)
      (main_spec_5 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_spec_5 result i$1 j$2 k$3 m$4)
      (main_assign_6 result i$1 j$2 (+ k$3 1) m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_assign_6 result i$1 j$2 k$3 m$4)
        (= i$1 7))
      (main_exit_4 result i$1 j$2 k$3))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_assign_6 result i$1 j$2 k$3 m$4)
        (not (= i$1 7)))
      (main_join_7 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_join_7 result i$1 j$2 k$3 m$4)
      (main_assign_8 result i$1 j$2 k$3 0))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_assign_8 result i$1 j$2 k$3 m$4)
      (main_assign_9 result i$1 0 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_assign_9 result i$1 j$2 k$3 m$4)
      (main_inv_10 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_inv_10 result i$1 j$2 k$3 m$4)
        (< j$2 3))
      (= m$4 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_inv_10 result i$1 j$2 k$3 m$4)
        (< j$2 3)
        true)
      (main_spec_12 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_spec_12 result i$1 j$2 k$3 m$4)
      (main_assign_13 result i$1 j$2 k$3 (+ m$4 1)))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_assign_13 result i$1 j$2 k$3 m$4)
        (= j$2 1))
      (main_assign_15 result i$1 (+ j$2 1) k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_assign_15 result i$1 j$2 k$3 m$4)
      (main_inv_10 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_assign_13 result i$1 j$2 k$3 m$4)
        (not (= j$2 1)))
      (main_join_14 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_join_14 result i$1 j$2 k$3 m$4)
      (main_assign_16 result i$1 (+ j$2 1) k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_assign_16 result i$1 j$2 k$3 m$4)
      (main_inv_10 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_inv_10 result i$1 j$2 k$3 m$4)
        (not (< j$2 3)))
      (main_exit_11 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_exit_11 result i$1 j$2 k$3 m$4)
      (and (= m$4 3) (= j$2 3) (= k$3 (+ i$1 1))))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_exit_11 result i$1 j$2 k$3 m$4)
        true)
      (main_spec_17 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_spec_17 result i$1 j$2 k$3 m$4)
        (=
          (ite (<= 0 i$1) (mod i$1 2) (- (mod i$1 2)))
          0))
      (main_assign_19 result (+ i$1 1) j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_assign_19 result i$1 j$2 k$3 m$4)
      (main_inv_3 result i$1 j$2 k$3))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (and
        (main_spec_17 result i$1 j$2 k$3 m$4)
        (not
          (=
            (ite (<= 0 i$1) (mod i$1 2) (- (mod i$1 2)))
            0)))
      (main_join_18 result i$1 j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_join_18 result i$1 j$2 k$3 m$4)
      (main_assign_20 result (+ i$1 1) j$2 k$3 m$4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int) (m$4 Int))
    (=>
      (main_assign_20 result i$1 j$2 k$3 m$4)
      (main_inv_3 result i$1 j$2 k$3))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int))
    (=>
      (and
        (main_inv_3 result i$1 j$2 k$3)
        (not (< i$1 10)))
      (main_exit_4 result i$1 j$2 k$3))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int))
    (=>
      (main_exit_4 result i$1 j$2 k$3)
      (= i$1 7))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int))
    (=>
      (and
        (main_exit_4 result i$1 j$2 k$3)
        true)
      (main_spec_21 result i$1 j$2 k$3))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int))
    (=>
      (main_spec_21 result i$1 j$2 k$3)
      (main_assign_22 0 i$1 j$2 k$3))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int) (k$3 Int))
    (=>
      (main_assign_22 result i$1 j$2 k$3)
      (main_post result))))

(check-sat)

(get-model)

