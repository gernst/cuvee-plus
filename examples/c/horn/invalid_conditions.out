(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-fun f_pre (Int) Bool)

(declare-fun f_post (Int Int Int) Bool)

(declare-fun f_assign_1 (Int Int Int) Bool)

(declare-fun f_assign_2 (Int Int Int) Bool)

(assert
  (forall
    ((result Int) (c Int))
    (=>
      (f_pre c)
      (f_assign_1 c result (+ c 1)))))

(assert
  (forall
    ((c$3 Int) (result Int) (c Int))
    (=>
      (f_assign_1 c$3 result c)
      (f_assign_2 c$3 1 c))))

(assert
  (forall
    ((c$3 Int) (result Int) (c Int))
    (=>
      (f_assign_2 c$3 result c)
      (f_post c$3 result c))))

(declare-fun main_pre (Int) Bool)

(declare-fun main_post (Int Int Int) Bool)

(declare-fun
  main_join_1
  (Int Int Int Int Bool Int)
  Bool)

(declare-fun
  main_assign_2
  (Int Int Int Int Bool Int)
  Bool)

(declare-fun
  main_call_3
  (Int Int Int Int Bool Int)
  Bool)

(declare-fun
  main_assign_4
  (Int Int Int Int Bool Int)
  Bool)

(declare-fun
  main_assign_5
  (Int Int Int Int Bool Int)
  Bool)

(declare-fun
  main_spec_6
  (Int Int Int Int Bool Int)
  Bool)

(declare-fun
  main_assign_7
  (Int Int Int Int Bool Int)
  Bool)

(assert (main_pre 0))

(assert
  (forall
    ((c$4 Int) (result Int) (c Int) (tmp$5 Int) (tmp$6 Bool) (r$7 Int))
    (=>
      (main_assign_2 c$4 result c tmp$5 tmp$6 r$7)
      (main_join_1 c$4 result c tmp$5 tmp$6 r$7))))

(assert
  (forall
    ((c Int))
    (=> (main_pre c) (f_pre c))))

(assert
  (forall
    ((result Int) (c Int) (tmp$6 Bool) (r$7 Int) (tmp$8 Int) (c$9 Int))
    (=>
      (and (main_pre c) (f_post c tmp$8 c$9))
      (main_call_3 c result c$9 tmp$8 tmp$6 r$7))))

(assert
  (forall
    ((c$4 Int) (result Int) (c Int) (tmp$5 Int) (tmp$6 Bool) (r$7 Int))
    (=>
      (main_call_3 c$4 result c tmp$5 tmp$6 r$7)
      (main_assign_4 c$4 result c tmp$5 (not (= tmp$5 0)) r$7))))

(assert
  (forall
    ((c$4 Int) (result Int) (c Int) (tmp$5 Int) (tmp$6 Bool) (r$7 Int))
    (=>
      (main_assign_4 c$4 result c tmp$5 tmp$6 r$7)
      (main_join_1 c$4 result c tmp$5 tmp$6 r$7))))

(assert
  (forall
    ((c$4 Int) (result Int) (c Int) (tmp$5 Int) (tmp$6 Bool) (r$7 Int))
    (=>
      (main_join_1 c$4 result c tmp$5 tmp$6 r$7)
      (main_assign_5 c$4 result c tmp$5 tmp$6 (ite tmp$6 1 0)))))

(assert
  (forall
    ((c$4 Int) (result Int) (c Int) (tmp$5 Int) (tmp$6 Bool) (r$7 Int))
    (=>
      (main_assign_5 c$4 result c tmp$5 tmp$6 r$7)
      (= c 0))))

(assert
  (forall
    ((c$4 Int) (result Int) (c Int) (tmp$5 Int) (tmp$6 Bool) (r$7 Int))
    (=>
      (main_assign_5 c$4 result c tmp$5 tmp$6 r$7)
      (main_spec_6 c$4 result c tmp$5 tmp$6 r$7))))

(assert
  (forall
    ((c$4 Int) (result Int) (c Int) (tmp$5 Int) (tmp$6 Bool) (r$7 Int))
    (=>
      (main_spec_6 c$4 result c tmp$5 tmp$6 r$7)
      (main_assign_7 c$4 0 c tmp$5 tmp$6 r$7))))

(assert
  (forall
    ((c$4 Int) (result Int) (c Int) (tmp$5 Int) (tmp$6 Bool) (r$7 Int))
    (=>
      (main_assign_7 c$4 result c tmp$5 tmp$6 r$7)
      (main_post c$4 result c))))

(check-sat)

(get-model)

