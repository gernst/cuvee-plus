(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-fun main_pre (Int) Bool)

(declare-fun main_post (Int Int Int) Bool)

(declare-fun
  main_spec_1
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_2
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_spec_3
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_4
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_5
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_inv_6
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_exit_7
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_join_8
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_9
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_10
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_11
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_spec_12
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_13
  (Int Int Int Int Int Int)
  Bool)

(assert
  (forall
    ((counter Int))
    (=> (= counter 0) (main_pre counter))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (n$4 Int) (i$5 Int) (tmp$6 Int))
    (=>
      (and
        (main_pre counter$2)
        (= counter counter$2)
        (<= 0 (+ tmp$6 2147483648))
        (<= tmp$6 2147483647))
      (main_spec_1 counter$2 result counter tmp$6 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_spec_1 counter$2 result counter tmp$3 n$4 i$5)
      (main_assign_2 counter$2 result counter tmp$3 tmp$3 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (and
        (main_assign_2 counter$2 result counter tmp$3 n$4 i$5)
        (<= 0 n$4))
      (main_spec_3 counter$2 result counter tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_spec_3 counter$2 result counter tmp$3 n$4 i$5)
      (main_assign_4 counter$2 result 0 tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_assign_4 counter$2 result counter tmp$3 n$4 i$5)
      (main_assign_5 counter$2 result counter tmp$3 n$4 0))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_assign_5 counter$2 result counter tmp$3 n$4 i$5)
      (main_inv_6 counter$2 result counter tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (and
        (main_inv_6 counter$2 result counter tmp$3 n$4 i$5)
        (< i$5 n$4)
        (=
          (ite (<= 0 i$5) (mod i$5 2) (- (mod i$5 2)))
          1))
      (main_assign_9 counter$2 result counter tmp$3 n$4 (+ i$5 1)))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_assign_9 counter$2 result counter tmp$3 n$4 i$5)
      (main_inv_6 counter$2 result counter tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (and
        (main_inv_6 counter$2 result counter tmp$3 n$4 i$5)
        (< i$5 n$4)
        (not
          (=
            (ite (<= 0 i$5) (mod i$5 2) (- (mod i$5 2)))
            1)))
      (main_join_8 counter$2 result counter tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_join_8 counter$2 result counter tmp$3 n$4 i$5)
      (main_assign_10 counter$2 result (+ counter 1) tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_assign_10 counter$2 result counter tmp$3 n$4 i$5)
      (main_assign_11 counter$2 result counter tmp$3 n$4 (+ i$5 1)))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_assign_11 counter$2 result counter tmp$3 n$4 i$5)
      (main_inv_6 counter$2 result counter tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (and
        (main_inv_6 counter$2 result counter tmp$3 n$4 i$5)
        (not (< i$5 n$4)))
      (main_exit_7 counter$2 result counter tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_exit_7 counter$2 result counter tmp$3 n$4 i$5)
      (<= counter n$4))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (and
        (main_exit_7 counter$2 result counter tmp$3 n$4 i$5)
        true)
      (main_spec_12 counter$2 result counter tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_spec_12 counter$2 result counter tmp$3 n$4 i$5)
      (main_assign_13 counter$2 0 counter tmp$3 n$4 i$5))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$5 Int))
    (=>
      (main_assign_13 counter$2 result counter tmp$3 n$4 i$5)
      (main_post counter$2 result counter))))

(check-sat)

(get-model)

