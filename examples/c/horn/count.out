(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-fun main_pre (Int) Bool)

(declare-fun main_post (Int Int Int) Bool)

(declare-fun
  main_spec_1
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_2
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_spec_3
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_4
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_block_5
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_6
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_inv_7
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_block_8
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_join_9
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_10
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_11
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_12
  (Int Int Int Int Int Int)
  Bool)

(declare-fun
  main_spec_13
  (Int Int Int Int Int)
  Bool)

(declare-fun
  main_assign_14
  (Int Int Int Int Int)
  Bool)

(assert (main_pre 0))

(assert
  (forall
    ((result Int) (counter Int) (n$4 Int) (tmp$5 Int))
    (=>
      (and
        (main_pre counter)
        (<= 0 (+ tmp$5 2147483648))
        (<= tmp$5 2147483647))
      (main_spec_1 counter result counter tmp$5 n$4))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int))
    (=>
      (main_spec_1 counter$2 result counter tmp$3 n$4)
      (main_assign_2 counter$2 result counter tmp$3 tmp$3))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int))
    (=>
      (and
        (main_assign_2 counter$2 result counter tmp$3 n$4)
        (<= 0 n$4))
      (main_spec_3 counter$2 result counter tmp$3 n$4))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int))
    (=>
      (main_spec_3 counter$2 result counter tmp$3 n$4)
      (main_assign_4 counter$2 result 0 tmp$3 n$4))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int))
    (=>
      (main_assign_4 counter$2 result counter tmp$3 n$4)
      (main_assign_6 counter$2 result counter tmp$3 n$4 0))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (main_assign_6 counter$2 result counter tmp$3 n$4 i$6)
      (main_inv_7 counter$2 result counter tmp$3 n$4 i$6))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (and
        (main_inv_7 counter$2 result counter tmp$3 n$4 i$6)
        (< i$6 n$4)
        (=
          (ite (<= 0 i$6) (mod i$6 2) (- (mod i$6 2)))
          1))
      (main_assign_10 counter$2 result counter tmp$3 n$4 (+ i$6 1)))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (main_assign_10 counter$2 result counter tmp$3 n$4 i$6)
      (main_inv_7 counter$2 result counter tmp$3 n$4 i$6))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (and
        (main_inv_7 counter$2 result counter tmp$3 n$4 i$6)
        (< i$6 n$4)
        (not
          (=
            (ite (<= 0 i$6) (mod i$6 2) (- (mod i$6 2)))
            1)))
      (main_join_9 counter$2 result counter tmp$3 n$4 i$6))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (main_join_9 counter$2 result counter tmp$3 n$4 i$6)
      (main_assign_11 counter$2 result (+ counter 1) tmp$3 n$4 i$6))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (main_assign_11 counter$2 result counter tmp$3 n$4 i$6)
      (main_block_8 counter$2 result counter tmp$3 n$4 i$6))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (main_block_8 counter$2 result counter tmp$3 n$4 i$6)
      (main_assign_12 counter$2 result counter tmp$3 n$4 (+ i$6 1)))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (main_assign_12 counter$2 result counter tmp$3 n$4 i$6)
      (main_inv_7 counter$2 result counter tmp$3 n$4 i$6))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int) (i$6 Int))
    (=>
      (and
        (main_inv_7 counter$2 result counter tmp$3 n$4 i$6)
        (<= n$4 i$6))
      (main_block_5 counter$2 result counter tmp$3 n$4))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int))
    (=>
      (main_block_5 counter$2 result counter tmp$3 n$4)
      (<= counter n$4))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int))
    (=>
      (main_block_5 counter$2 result counter tmp$3 n$4)
      (main_spec_13 counter$2 result counter tmp$3 n$4))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int))
    (=>
      (main_spec_13 counter$2 result counter tmp$3 n$4)
      (main_assign_14 counter$2 0 counter tmp$3 n$4))))

(assert
  (forall
    ((counter$2 Int) (result Int) (counter Int) (tmp$3 Int) (n$4 Int))
    (=>
      (main_assign_14 counter$2 result counter tmp$3 n$4)
      (main_post counter$2 result counter))))

(check-sat)

(get-model)

