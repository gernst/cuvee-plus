(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-const main_pre Bool)

(declare-fun main_post (Int) Bool)

(declare-fun main_assign_1 (Int Bool Int) Bool)

(declare-fun main_inv_2 (Int Bool Int) Bool)

(declare-fun main_exit_3 (Int Bool Int) Bool)

(declare-fun main_spec_4 (Int Bool Int) Bool)

(declare-fun main_join_5 (Int Bool Int) Bool)

(declare-fun main_assign_6 (Int Bool Int) Bool)

(declare-fun main_spec_7 (Int Bool Int) Bool)

(declare-fun main_assign_8 (Int Bool Int) Bool)

(assert (=> true main_pre))

(assert
  (forall
    ((result Int) (tmp$2 Bool))
    (=>
      main_pre
      (main_assign_1 result tmp$2 0))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (main_assign_1 result tmp$2 i$3)
      (main_inv_2 result tmp$2 i$3))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (tmp$4 Bool))
    (=>
      (and
        (main_inv_2 result tmp$2 i$3)
        true
        true)
      (main_spec_4 result tmp$4 i$3))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (and
        (main_spec_4 result tmp$2 i$3)
        tmp$2)
      (main_join_5 result tmp$2 i$3))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (and
        (main_spec_4 result tmp$2 i$3)
        (not tmp$2))
      (main_exit_3 result tmp$2 i$3))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (main_join_5 result tmp$2 i$3)
      (main_assign_6 result tmp$2 (+ i$3 1)))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (main_assign_6 result tmp$2 i$3)
      (main_inv_2 result tmp$2 i$3))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (and
        (main_inv_2 result tmp$2 i$3)
        (not true))
      (main_exit_3 result tmp$2 i$3))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (main_exit_3 result tmp$2 i$3)
      (= i$3 0))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (and
        (main_exit_3 result tmp$2 i$3)
        true)
      (main_spec_7 result tmp$2 i$3))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (main_spec_7 result tmp$2 i$3)
      (main_assign_8 0 tmp$2 i$3))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      (main_assign_8 result tmp$2 i$3)
      (main_post result))))

(set-info :status sat)

(check-sat)

(get-model)

