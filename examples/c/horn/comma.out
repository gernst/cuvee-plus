(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-const main_pre Bool)

(declare-fun main_post (Int) Bool)

(declare-fun main_block_1 (Int Int Int) Bool)

(declare-fun main_block_2 (Int Int Int) Bool)

(declare-fun main_assign_3 (Int Int Int) Bool)

(declare-fun main_assign_4 (Int Int Int) Bool)

(declare-fun main_inv_5 (Int Int Int) Bool)

(declare-fun main_assign_6 (Int Int Int) Bool)

(declare-fun main_assign_7 (Int Int Int) Bool)

(declare-fun main_spec_8 (Int Int Int) Bool)

(declare-fun main_assign_9 (Int Int Int) Bool)

(assert main_pre)

(assert
  (forall
    ((result Int) (j$2 Int))
    (=>
      main_pre
      (main_assign_3 result 0 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_assign_3 result i$1 j$2)
      (main_assign_4 result i$1 4))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_assign_4 result i$1 j$2)
      (main_block_2 result i$1 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_block_2 result i$1 j$2)
      (main_inv_5 result i$1 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (and
        (main_inv_5 result i$1 j$2)
        (< i$1 j$2))
      (main_assign_6 result (+ i$1 1) j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_assign_6 result i$1 j$2)
      (main_assign_7 result i$1 (+ j$2 (- 1))))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_assign_7 result i$1 j$2)
      (main_inv_5 result i$1 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (and
        (main_inv_5 result i$1 j$2)
        (<= j$2 i$1))
      (main_block_1 result i$1 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_block_1 result i$1 j$2)
      (= i$1 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_block_1 result i$1 j$2)
      (main_spec_8 result i$1 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_spec_8 result i$1 j$2)
      (main_assign_9 0 i$1 j$2))))

(assert
  (forall
    ((result Int) (i$1 Int) (j$2 Int))
    (=>
      (main_assign_9 result i$1 j$2)
      (main_post result))))

(check-sat)

(get-model)

