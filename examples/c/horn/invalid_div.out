(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-const main_pre Bool)

(declare-fun main_post (Int) Bool)

(declare-fun main_assign_1 (Int Int) Bool)

(declare-fun main_spec_2 (Int Int) Bool)

(declare-fun main_assign_3 (Int Int) Bool)

(assert (=> true main_pre))

(assert
  (forall
    ((result Int))
    (=>
      main_pre
      (main_assign_1 result (- 7)))))

(assert
  (forall
    ((result Int) (x$1 Int))
    (=>
      (main_assign_1 result x$1)
      (=
        (+
          (ite (<= 0 x$1) (div x$1 2) (- (div (- x$1) 2)))
          4)
        0))))

(assert
  (forall
    ((result Int) (x$1 Int))
    (=>
      (and
        (main_assign_1 result x$1)
        true)
      (main_spec_2 result x$1))))

(assert
  (forall
    ((result Int) (x$1 Int))
    (=>
      (main_spec_2 result x$1)
      (main_assign_3 0 x$1))))

(assert
  (forall
    ((result Int) (x$1 Int))
    (=>
      (main_assign_3 result x$1)
      (main_post result))))

(set-info :status sat)

(check-sat)

(get-model)

