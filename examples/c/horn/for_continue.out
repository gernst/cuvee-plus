(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-const main_pre Bool)

(declare-fun main_post (Int) Bool)

(declare-fun main_assign_1 (Int Bool Int Int) Bool)

(declare-fun main_block_2 (Int Bool Int Int) Bool)

(declare-fun main_assign_3 (Int Bool Int Int) Bool)

(declare-fun main_inv_4 (Int Bool Int Int) Bool)

(declare-fun main_spec_5 (Int Bool Int Int) Bool)

(declare-fun main_join_6 (Int Bool Int Int) Bool)

(declare-fun main_block_7 (Int Bool Int Int) Bool)

(declare-fun main_join_8 (Int Bool Int Int) Bool)

(declare-fun main_assign_9 (Int Bool Int Int) Bool)

(declare-fun main_assign_10 (Int Bool Int Int) Bool)

(declare-fun main_assign_11 (Int Bool Int Int) Bool)

(declare-fun main_spec_12 (Int Bool Int Int) Bool)

(declare-fun main_assign_13 (Int Bool Int Int) Bool)

(assert main_pre)

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int))
    (=>
      main_pre
      (main_assign_1 result tmp$2 i$3 0))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_assign_1 result tmp$2 i$3 j$4)
      (main_assign_3 result tmp$2 0 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_assign_3 result tmp$2 i$3 j$4)
      (main_inv_4 result tmp$2 i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int) (tmp$5 Bool))
    (=>
      (main_inv_4 result tmp$2 i$3 j$4)
      (main_spec_5 result tmp$5 i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (and
        (main_spec_5 result false i$3 j$4)
        (not tmp$2))
      (main_block_2 result false i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (and
        (main_spec_5 result true i$3 j$4)
        tmp$2)
      (main_join_6 result true i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (and
        (main_join_6 result tmp$2 i$3 j$4)
        (< 2 i$3))
      (main_assign_9 result tmp$2 (+ i$3 1) j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_assign_9 result tmp$2 i$3 j$4)
      (main_inv_4 result tmp$2 i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (and
        (main_join_6 result tmp$2 i$3 j$4)
        (<= i$3 2))
      (main_join_8 result tmp$2 i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_join_8 result tmp$2 i$3 j$4)
      (main_assign_10 result tmp$2 i$3 (+ j$4 1)))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_assign_10 result tmp$2 i$3 j$4)
      (main_block_7 result tmp$2 i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_block_7 result tmp$2 i$3 j$4)
      (main_assign_11 result tmp$2 (+ i$3 1) j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_assign_11 result tmp$2 i$3 j$4)
      (main_inv_4 result tmp$2 i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_block_2 result tmp$2 i$3 j$4)
      (and (<= j$4 3) (<= j$4 i$3)))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_block_2 result tmp$2 i$3 j$4)
      (main_spec_12 result tmp$2 i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_spec_12 result tmp$2 i$3 j$4)
      (main_assign_13 0 tmp$2 i$3 j$4))))

(assert
  (forall
    ((result Int) (tmp$2 Bool) (i$3 Int) (j$4 Int))
    (=>
      (main_assign_13 result tmp$2 i$3 j$4)
      (main_post result))))

(check-sat)

(get-model)

