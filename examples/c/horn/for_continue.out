(set-logic HORN)

(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(declare-const main_pre Bool)

(declare-fun main_post (Int) Bool)

(declare-fun
  main_assign_1
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_assign_2
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_assign_3
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_inv_4
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_exit_5
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_spec_6
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_join_7
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_inv_8
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_exit_9
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_join_10
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_assign_11
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_join_12
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_assign_13
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_spec_14
  (Int Bool Bool Int Int)
  Bool)

(declare-fun
  main_assign_15
  (Int Bool Bool Int Int)
  Bool)

(assert (=> true main_pre))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int))
    (=>
      main_pre
      (main_assign_1 result tmp$3 tmp$4 i$5 0))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_assign_1 result tmp$3 tmp$4 i$5 j$6)
      (main_assign_2 result tmp$3 tmp$4 0 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_assign_2 result tmp$3 tmp$4 i$5 j$6)
      (main_assign_3 result tmp$3 false i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_assign_3 result tmp$3 tmp$4 i$5 j$6)
      (main_inv_4 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int) (tmp$7 Bool))
    (=>
      (and
        (main_inv_4 result tmp$3 tmp$4 i$5 j$6)
        true
        true)
      (main_spec_6 result tmp$7 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_spec_6 result tmp$3 tmp$4 i$5 j$6)
        tmp$3)
      (main_join_7 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_spec_6 result tmp$3 tmp$4 i$5 j$6)
        (not tmp$3))
      (main_exit_5 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_join_7 result tmp$3 tmp$4 i$5 j$6)
      (main_inv_8 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_inv_8 result tmp$3 tmp$4 i$5 j$6)
        true
        (< 2 i$5))
      (main_exit_9 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_inv_8 result tmp$3 tmp$4 i$5 j$6)
        true
        (not (< 2 i$5)))
      (main_join_10 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_join_10 result tmp$3 tmp$4 i$5 j$6)
      (main_assign_11 result tmp$3 tmp$4 i$5 (+ j$6 1)))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_assign_11 result tmp$3 tmp$4 i$5 j$6)
      (main_exit_9 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_inv_8 result tmp$3 tmp$4 i$5 j$6)
        (not true))
      (main_exit_9 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_exit_9 result tmp$3 tmp$4 i$5 j$6)
        tmp$4)
      (main_exit_5 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_exit_9 result tmp$3 tmp$4 i$5 j$6)
        (not tmp$4))
      (main_join_12 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_join_12 result tmp$3 tmp$4 i$5 j$6)
      (main_assign_13 result tmp$3 tmp$4 (+ i$5 1) j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_assign_13 result tmp$3 tmp$4 i$5 j$6)
      (main_inv_4 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_inv_4 result tmp$3 tmp$4 i$5 j$6)
        (not true))
      (main_exit_5 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_exit_5 result tmp$3 tmp$4 i$5 j$6)
      (and (<= j$6 3) (<= j$6 i$5)))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (and
        (main_exit_5 result tmp$3 tmp$4 i$5 j$6)
        true)
      (main_spec_14 result tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_spec_14 result tmp$3 tmp$4 i$5 j$6)
      (main_assign_15 0 tmp$3 tmp$4 i$5 j$6))))

(assert
  (forall
    ((result Int) (tmp$3 Bool) (tmp$4 Bool) (i$5 Int) (j$6 Int))
    (=>
      (main_assign_15 result tmp$3 tmp$4 i$5 j$6)
      (main_post result))))

(set-info :status sat)

(check-sat)

(get-model)

