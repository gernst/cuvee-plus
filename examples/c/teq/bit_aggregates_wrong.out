(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(goal
  (forall
    ((x$15 (Array Int Int))
      (x$36 (Array Int Int))
      (K$31 (Trace Int))
      (X$34
        (Trace (Array Int Int)))
      (Tmp?$28 (List Int))
      (res$49 Int)
      (K$46 (Trace Int))
      (res$61 Int)
      (x$95 (Array Int Int))
      (X$94
        (Trace (Array Int Int)))
      (res$107 Int)
      (res$119 Int))
    (=>
      (and
        (= K$31 (counter 0 1 10))
        (=
          X$34
          (stores x$15 (butlast K$31) Tmp?$28))
        (= x$36 (current X$34))
        (invs
          ((k$30 (butlast K$31))
            (tmp$27 Tmp?$28))
          (<=
            0
            (+ tmp$27 2147483648)))
        (invs
          ((k$30 (butlast K$31))
            (tmp$27 Tmp?$28))
          (<= tmp$27 2147483647))
        (= (length Tmp?$28) 10)
        (= K$46 (counter 0 1 9))
        (=
          res$49
          (band (elems Tmp?$28)))
        (=
          res$61
          (bor (elems Tmp?$28)))
        (=
          X$94
          (shifts
            (store
              (store x$36 0 (earlier 1 Tmp?$28))
              1
              (earlier 0 Tmp?$28))
            (butlast K$46)))
        (= x$95 (current X$94))
        (=
          res$107
          (band
            (elems
              (selects
                (store x$95 9 (earlier 0 Tmp?$28))
                (butlast (counter 0 1 10))))))
        (=
          res$119
          (bor
            (elems
              (selects
                (store x$95 9 (earlier 0 Tmp?$28))
                (butlast (counter 0 1 10)))))))
      (and (= res$49 res$107) (= res$61 res$119)))))

