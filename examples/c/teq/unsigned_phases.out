(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(goal
  (forall
    ((x$7 Int) (n$3 Nat) (K$5 (Trace Int)) (X$6 (Trace Int)))
    (not
      (and
        (= K$5 (counter 0 1 n$3))
        (=
          X$6
          (trace
            (x$2 0)
            ((k$4 (butlast K$5)))
            (eps
              ((< x$2 10000000) (+ x$2 1))
              ((<= 10000000 x$2) (+ x$2 2)))))
        (= x$7 (current X$6))
        (invs
          ((k$4 (butlast K$5)) (x$2 (butlast X$6)))
          (< x$2 100000000))
        (<= 0 (integer n$3))
        (< 100000000 x$7)))))

