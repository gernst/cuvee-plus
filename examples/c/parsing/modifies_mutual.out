datatype {:c} Ptr<a>
  = null | ptr(addr: int)

datatype {:c} Void
  = void

function {:c} {:rw} truth(x: int): bool {
  x != 0
}

function {:c} {:rw} number(b: bool): int {
  if b then 1 else 0
}

function {:c} {:rw} uchar(x: int): int {
  x % 256
}

function {:c} {:rw} ushort(x: int): int {
  x % 65536
}

function {:c} {:rw} uint(x: int): int {
  x % 4294967296
}

function {:c} {:rw} ulonglong(x: int): int {
  x % 18446744073709551616
}

function {:c} {:abstract} bitand(a: int, b: int): int

function {:c} {:abstract} bitor(a: int, b: int): int

function {:c} {:abstract} bitxor(a: int, b: int): int

function {:c} {:abstract} bitnot(a: int): int

function {:c} {:abstract} shl(a: int, b: int): int

function {:c} {:abstract} shr(a: int, b: int): int

axiom {:c} {:smt2} {:rw}
  forall c: bool, d: bool ::
    bitand(if c then 1 else 0, if d then 1 else 0) == (if c && d then 1 else 0)

axiom {:c} {:smt2} {:rw}
  forall c: bool, d: bool ::
    bitor(if c then 1 else 0, if d then 1 else 0) == (if c || d then 1 else 0)

axiom {:c} {:smt2} {:rw}
  forall c: bool, d: bool ::
    bitxor(if c then 1 else 0, if d then 1 else 0) == (if c != d then 1 else 0)

axiom {:c} {:smt2} {:rw} forall x: int :: bitand(0, x) == 0

axiom {:c} {:smt2} {:rw} forall x: int :: bitand(x, 0) == 0

axiom {:c} {:smt2} {:rw} bitand(1, 1) == 1

axiom {:c} {:smt2} {:rw} forall x: int :: bitor(0, x) == x

axiom {:c} {:smt2} {:rw} forall x: int :: bitor(x, 0) == x

axiom {:c} {:smt2} {:rw} bitor(1, 1) == 1

axiom {:c} {:smt2} {:rw} forall x: int :: bitxor(0, x) == x

axiom {:c} {:smt2} {:rw} forall x: int :: bitxor(x, 0) == x

axiom {:c} {:smt2} {:rw} bitxor(1, 1) == 0

var g: int

var h: int

method even(n: int) returns (result: int)
  modifies g, h
{
  var tmp₂: int;
  {
    while {:location (7, 19, even)} h < n {
      h := h + 1;
    }
    if n == 0 {
      result := 1;
      return;
    }
    tmp₂ := odd(n - 1);
    result := tmp₂;
    return;
  }
}

method odd(n: int) returns (result: int)
  modifies g, h
{
  var tmp₃: int;
  {
    g := n;
    if n == 0 {
      result := 0;
      return;
    }
    tmp₃ := even(n - 1);
    result := tmp₃;
    return;
  }
}

method get(g₁: int) returns (result: int) {
  {
    result := g₁ + h;
    return;
  }
}

