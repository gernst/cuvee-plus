(declare-datatype
  Ptr
  (par
    (a)
    ((null) (ptr (addr Int)))))

(declare-datatype Void ((void)))

(define-fun truth ((x Int)) Bool (not (= x 0)))

(define-fun number ((b Bool)) Int (ite b 1 0))

(define-fun
  quot
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (div a b) (- (div (- a) b))))

(define-fun
  rem
  ((a Int) (b Int))
  Int
  (ite (<= 0 a) (mod a b) (- (mod (- a) b))))

(define-fun uchar ((x Int)) Int (mod x 256))

(define-fun ushort ((x Int)) Int (mod x 65536))

(define-fun uint ((x Int)) Int (mod x 4294967296))

(define-fun
  ulonglong
  ((x Int))
  Int
  (mod x 18446744073709551616))

(declare-fun bitand (Int Int) Int)

(declare-fun bitor (Int Int) Int)

(declare-fun bitxor (Int Int) Int)

(declare-fun bitnot (Int) Int)

(declare-fun shl (Int Int) Int)

(declare-fun shr (Int Int) Int)

(define-proc
  sum
  ((n Int))
  ((result Int))
  ()
  (sequence
    (block
      (locals (s Int) (i Int))
      (assign (s 0))
      (assign (i 0))
      (!
        (while
          (< i n)
          (sequence (assign (s (+ s i))) (assign (i (+ i 1)))))
        :location
        (8 3 sum))
      (assign (result s))
      (return))))

(define-proc
  main
  ()
  ((result Int))
  ((tmp$1 Bool) (tmp$2 Int))
  (sequence
    (block
      (locals (x Int))
      (assign (x 0))
      (assign (tmp$1 true))
      (!
        (while
          (or tmp$1 (< x 10))
          (sequence
            (assign (tmp$1 false))
            (sequence (assign (x (+ x 1))))))
        :location
        (14 3 main))
      (block
        (locals (i Int))
        (assign (i 0))
        (!
          (while
            (< i 10)
            (sequence
              (sequence
                (!
                  (while (> x 0) (assign (x (- x 1))))
                  :location
                  (19 2 main)))
              (assign (i (+ i 1)))))
          :location
          (18 3 main)))
      (block
        (locals (j Int))
        (assign (j 0))
        (!
          (while
            (< j 10)
            (sequence
              (sequence
                (if
                  (= j 5)
                  (sequence (assign (j (+ j 1))) (continue)))
                (assign (x (+ x 1))))
              (assign (j (+ j 1)))))
          :location
          (22 3 main)))
      (call sum (x) (tmp$2))
      (assign (result tmp$2))
      (return))))

