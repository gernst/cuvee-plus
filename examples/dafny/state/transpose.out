lemma {:rw} current_transpose(B0: array<int, array<int, int>>,
                              A: array<int, array<int, int>>, m: int, n: int,
                              i: int, j: int)
  requires 0 <= i
  requires i < m
  requires 0 <= j
  requires j < n
  ensures
    current(trace(B0, for ⌊counter(0, 1, natural(m))⌋
                  do B, k ::
                    current(trace(B, for ⌊counter(0, 1, natural(n))⌋
                                  do Bi, ki ::
                                    Bi[ki := Bi[ki][k := A[k][ki]]]))))[j][i]
      == A[i][j]

