function sorted(ar: array<int, int>, len: int): bool

function lower(ar: array<int, int>, len: int, y: int): int

function upper(ar: array<int, int>, len: int, y: int): int

lemma {:rw} lower_def(ar: array<int, int>, len: int, y: int, m: int)
  requires sorted(ar, len)
  requires 0 <= m
  requires m < len
  ensures ar[m] < y <==> m < lower(ar, len, y)

lemma {:rw} upper_def(ar: array<int, int>, len: int, y: int, m: int)
  requires sorted(ar, len)
  requires 0 <= m
  requires m < len
  ensures y < ar[m] <==> upper(ar, len, y) <= m

lemma {:rw} equal_def(ar: array<int, int>, len: int, y: int, m: int)
  requires sorted(ar, len)
  requires 0 <= m
  requires m < len
  ensures ar[m] == y <==> lower(ar, len, y) <= m < upper(ar, len, y)

lemma {:rw} lower_bound(ar: array<int, int>, len: int, y: int)
  requires sorted(ar, len)
  requires 0 <= len
  ensures 0 <= lower(ar, len, y) <==> true

lemma {:rw} upper_bound(ar: array<int, int>, len: int, y: int)
  requires sorted(ar, len)
  requires 0 <= len
  ensures upper(ar, len, y) <= len <==> true

lemma {:fw} bounds(ar: array<int, int>, len: int, y: int)
  requires sorted(ar, len)
  requires 0 <= len
  ensures 0 <= lower(ar, len, y)
  ensures lower(ar, len, y) <= upper(ar, len, y)
  ensures upper(ar, len, y) <= len

lemma {:fw} up_1<a>(x0: int, i: int, c: int, m: Nat, hs: List<a>,
                    C: (int, a) -> bool, D: (int, a) -> bool,
                    F: (int, a) -> int)
  ensures
    invs(for ⌊trace(x0, for ⌊counter(i, c, m)⌋, hs
                    do v, k, h ::
                      case C(v, h) => v case D(v, h) && v < F(v, h) => F(v, h))⌋
         check w ::
           x0 <= w)

lemma {:fw} up_2<a>(x0: int, i: int, c: int, m: Nat, hs: List<a>,
                    C: (int, a) -> bool, D: (int, a) -> bool,
                    F: (int, a) -> int)
  ensures
    x0
      <= current(trace(x0, for ⌊counter(i, c, m)⌋, hs
                       do v, k, h ::
                         case C(v, h) => v
                         case D(v, h) && v < F(v, h) => F(v, h)))

lemma {:fw} down_1<a>(x0: int, i: int, c: int, m: Nat, ls: List<a>,
                      C: (int, a) -> bool, D: (int, a) -> bool,
                      F: (int, a) -> int)
  ensures
    invs(for ⌊trace(x0, for ⌊counter(i, c, m)⌋, ls
                    do v, k, l ::
                      case C(v, l) => v case D(v, l) && F(v, l) < v => F(v, l))⌋
         check w ::
           w <= x0)

lemma {:fw} down_2<a>(x0: int, i: int, c: int, m: Nat, ls: List<a>,
                      C: (int, a) -> bool, D: (int, a) -> bool,
                      F: (int, a) -> int)
  ensures
    current(trace(x0, for ⌊counter(i, c, m)⌋, ls
                  do v, k, l ::
                    case C(v, l) => v case D(v, l) && F(v, l) < v => F(v, l)))
      <= x0

function incs<a>(x0: int, b: int, ks: List<int>, hs: List<a>,
                 D: (int, a) -> bool, C: (int, a) -> bool,
                 F: (int, a) -> int): Trace<int>

lemma {:rw} trace_1<a>(x0: int, b: int, i: int, c: int, m: Nat, hs: List<a>,
                       C: (int, a) -> bool, D: (int, a) -> bool,
                       F: (int, a) -> int)
  ensures
    trace(x0, for ⌊counter(i, c, m)⌋, hs
          do v, k, h ::
            case C(v, h) => v case D(v, h) && v < F(v, h) <= b => F(v, h))
      == incs(x0, b, ⌊counter(i, c, m)⌋, hs, D, C, F)

lemma {:fw} current_1<a>(x0: int, b: int, ks: List<int>, hs: List<a>,
                         D: (int, a) -> bool, C: (int, a) -> bool,
                         F: (int, a) -> int)
  requires x0 <= b
  ensures current(incs(x0, b, ks, hs, D, C, F)) <= b

function decs<a>(x0: int, b: int, ks: List<int>, ls: List<a>,
                 D: (int, a) -> bool, C: (int, a) -> bool,
                 F: (int, a) -> int): Trace<int>

lemma {:rw} trace_2<a>(x0: int, b: int, i: int, c: int, m: Nat, ls: List<a>,
                       C: (int, a) -> bool, D: (int, a) -> bool,
                       F: (int, a) -> int)
  ensures
    trace(x0, for ⌊counter(i, c, m)⌋, ls
          do v, k, l ::
            case C(v, l) => v
            case D(v, l) && F(v, l) < v && b <= F(v, l) => F(v, l))
      == decs(x0, b, ⌊counter(i, c, m)⌋, ls, D, C, F)

lemma {:fw} current_2<a>(x0: int, b: int, ks: List<int>, ls: List<a>,
                         D: (int, a) -> bool, C: (int, a) -> bool,
                         F: (int, a) -> int)
  requires b <= x0
  ensures b <= current(decs(x0, b, ks, ls, D, C, F))

