function sorted(ar: array<int, int>, len: int): bool

function lower(ar: array<int, int>, len: int, y: int): int

function upper(ar: array<int, int>, len: int, y: int): int

lemma {:rw} lower_def(ar: array<int, int>, len: int, y: int, m: int)
  requires sorted(ar, len)
  requires 0 <= m
  requires m < len
  ensures ar[m] < y <==> m < lower(ar, len, y)

lemma {:rw} upper_def(ar: array<int, int>, len: int, y: int, m: int)
  requires sorted(ar, len)
  requires 0 <= m
  requires m < len
  ensures y < ar[m] <==> upper(ar, len, y) <= m

lemma {:rw} equal_def(ar: array<int, int>, len: int, y: int, m: int)
  requires sorted(ar, len)
  requires 0 <= m
  requires m < len
  ensures ar[m] == y <==> lower(ar, len, y) <= m < upper(ar, len, y)

lemma {:fw} bounds(ar: array<int, int>, len: int, y: int)
  requires sorted(ar, len)
  requires 0 <= len
  ensures 0 <= lower(ar, len, y)
  ensures lower(ar, len, y) <= upper(ar, len, y)
  ensures upper(ar, len, y) <= len

function cut(G: int -> bool, l: int, h: int): int

function cut2(H: int -> bool, l: int, h: int): int

lemma {:rw} cut_lower(ar: array<int, int>, len: int, y: int)
  requires sorted(ar, len)
  requires 0 <= len
  ensures cut((j: int) => ar[j] < y, 0, len) == lower(ar, len, y)

lemma {:rw} cut_upper(ar: array<int, int>, len: int, y: int)
  requires sorted(ar, len)
  requires 0 <= len
  ensures cut2((j: int) => y < ar[j], 0, len) == upper(ar, len, y)

lemma {:fw} bisect_1(l0: int, h0: int, i: int, c: int, m: Nat, G: int -> bool,
                     H: int -> bool)
  requires l0 <= h0
  requires forall p: int, q: int :: l0 <= p <= q < h0 && G(q) ==> G(p)
  ensures
    l0
      <= current(trace(l0, h0,
                       for ⌊counter(i, c, m)⌋
                       do lo, hi, k ::
                         case G((hi + lo) / 2) && lo < hi => (hi + lo) / 2 + 1
                         case H((hi + lo) / 2) && lo < hi => lo,
                         case G((hi + lo) / 2) && lo < hi => hi
                         case H((hi + lo) / 2) && lo < hi => (hi + lo) / 2)).0
  ensures
    current(trace(l0, h0,
                  for ⌊counter(i, c, m)⌋
                  do lo, hi, k ::
                    case G((hi + lo) / 2) && lo < hi => (hi + lo) / 2 + 1
                    case H((hi + lo) / 2) && lo < hi => lo,
                    case G((hi + lo) / 2) && lo < hi => hi
                    case H((hi + lo) / 2) && lo < hi => (hi + lo) / 2)).0
      <= cut(G, l0, h0)

lemma {:fw} bisect_2(l0: int, h0: int, i: int, c: int, m: Nat, G: int -> bool,
                     H: int -> bool)
  requires l0 <= h0
  requires forall p: int, q: int :: l0 <= p <= q < h0 && H(p) ==> H(q)
  ensures
    cut2(H, l0, h0)
      <= current(trace(l0, h0,
                       for ⌊counter(i, c, m)⌋
                       do lo, hi, k ::
                         case G((hi + lo) / 2) && lo < hi => (hi + lo) / 2 + 1
                         case H((hi + lo) / 2) && lo < hi => lo,
                         case G((hi + lo) / 2) && lo < hi => hi
                         case H((hi + lo) / 2) && lo < hi => (hi + lo) / 2)).1
  ensures
    current(trace(l0, h0,
                  for ⌊counter(i, c, m)⌋
                  do lo, hi, k ::
                    case G((hi + lo) / 2) && lo < hi => (hi + lo) / 2 + 1
                    case H((hi + lo) / 2) && lo < hi => lo,
                    case G((hi + lo) / 2) && lo < hi => hi
                    case H((hi + lo) / 2) && lo < hi => (hi + lo) / 2)).1
      <= h0

