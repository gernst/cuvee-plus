lemma exits(a: array<int, int>, b: array<int, int>, n: int,
            S: Trace<(array<int, int>, array<int, int>, int)>)
  requires 0 <= n
  requires
    S
      == trace(a, b, 0,
               for ⌊counter(0, 1, n)⌋
               do x, y, i, k ::
                 x[i := y[i]],
                 y[i := x[i]],
                 i + 1)
  ensures current(S).2 == n
  ensures invs(for ⌊counter(0, 1, n)⌋, ⌊S⌋.2 check k, i :: i == k)

lemma guarded(n: int, S: Trace<(int, bool)>)
  requires
    S
      == trace(0, n <= 0,
               for ⌊counter(0, 1, n)⌋
               do x, b, k ::
                 case b => x case !b => x + 1,
                 b)
  ensures current(S).0 == 0 || current(S).0 == n

