datatype {:implement} set<a>
  = Nil | Cons(head: a, tail: set<a>)

function {:implement x in this} Set_member<a>(this: set<a>, x: a): bool

function {:implement |this|} Set_card<a>(this: set<a>): int

function {:implement this + t} Set_union<a>(this: set<a>, t: set<a>): set<a>

function {:implement {x}} singleton<a>(x: a): set<a> {
  Cons(x, Nil)
}

