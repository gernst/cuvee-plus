datatype {:implements} set<a>
  = Nil | Cons(head: a, tail: set<a>)

function {:implements x in this} Set_member<a>(this: set<a>, x: a): bool

function {:implements |this|} Set_card<a>(this: set<a>): int

function {:implements this + t} Set_union<a>(this: set<a>, t: set<a>): set<a>

function {:implements {x}} singleton<a>(x: a): set<a> {
  Cons(x, Nil)
}

