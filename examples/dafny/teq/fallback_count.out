function C₁₂(x₀: int): int

goal {:abstract}
  forall a: array<int, int>, n: int, c₉: int ::
    0 <= n
      && C₁₂(0) == 0
      && (forall j₁₃: int ::
            0 <= j₁₃ < n
              ==> (a[0 + j₁₃ * 1] < 0 ==> C₁₂(j₁₃ + 1) == C₁₂(j₁₃) + 1)
                && (0 <= a[0 + j₁₃ * 1] ==> C₁₂(j₁₃ + 1) == C₁₂(j₁₃)))
      && c₉ == C₁₂(n)
      ==> c₉ <= n

