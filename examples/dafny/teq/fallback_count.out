function C₁₂(x₀: int): int

function `=₁₄`(x₀: int, x₁: int): bool

goal {:abstract}
  forall a: array<int, int>, c₉: int, i₁₀: int, n₄: int ::
    0 <= n₄
      ==> 0 <= i₁₀
        && C₁₂(0) == 0
        && (forall j₁₃: int ::
              0 <= j₁₃ < n₄
                ==> (a[0 + j₁₃ * 1] < 0 ==> C₁₂(j₁₃ + 1) == C₁₂(j₁₃) + 1)
                  && (0 <= a[0 + j₁₃ * 1] ==> C₁₂(j₁₃ + 1) == C₁₂(j₁₃)))
        && c₉ == C₁₂(n₄)
        && `=₁₄`(i₁₀, n₄)
      ==> c₉ <= i₁₀

