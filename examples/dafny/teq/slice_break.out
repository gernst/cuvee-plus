method search(len: int, key: int) returns (res: int)
  requires 0 <= len
{
  var idx: int;
  idx := 0;
  while idx < len
    invariant
      exists K₁₁: Trace<int> ::
        K₁₁ == counter(0, 1, idx)
          && idx <= len
          && invs(for ⌊K₁₁⌋ check k₁₀ :: k₁₀ != key)
          && 0 <= idx
  {
    if idx == key {
      break;
    }
    idx := idx + 1;
  }
  res := idx;
}

