type Trace<a₀>

function current<a₀>(x₀: Trace<a₀>): a₀

function earlier<a₀>(x₀: int, x₁: seq<a₀>): a₀

function occurs<a>(x: a, xs: seq<a>): bool

function indexof<a>(x: a, xs: seq<a>): int

function lows(lo: int, ms: seq<int>, bs: seq<bool>): Trace<int>

function highs(hi: int, ms: seq<int>, bs: seq<bool>): Trace<int>

lemma {:rw} trace_1(lo: int, ms: seq<int>, bs: seq<bool>, cs: seq<bool>,
                    ds: seq<bool>)
  ensures
    trace(lo, for ms, bs, cs, ds
              do l, m, b, c, d ::
                case b => m + 1 case c => l case d => l)
      == lows(lo, ms, bs)

lemma {:rw} trace_2(hi: int, ms: seq<int>, bs: seq<bool>, cs: seq<bool>,
                    ds: seq<bool>)
  ensures
    trace(hi, for ms, bs, cs, ds
              do h, m, b, c, d ::
                case b => h case c => m case d => h)
      == highs(hi, ms, cs)

lemma {:rw} current_1(lo: int, ms: seq<int>, bs: seq<bool>)
  ensures
    current(lows(lo, ms, bs))
      == (if occurs(true, bs) then earlier(indexof(true, bs), ms) + 1 else lo)

lemma {:rw} current_2(hi: int, ms: seq<int>, bs: seq<bool>)
  ensures
    current(highs(hi, ms, bs))
      == (if occurs(true, bs) then earlier(indexof(true, bs), ms) else hi)

function lts(a: array<int, int>, ms: seq<int>, x: int): seq<bool>

function gts(a: array<int, int>, ms: seq<int>, x: int): seq<bool>

function eqs(a: array<int, int>, ms: seq<int>, x: int): seq<bool>

lemma {:rw} maps_1(a: array<int, int>, ms: seq<int>, x: int)
  ensures maps(for ms yield m :: a[m] < x) == lts(a, ms, x)

lemma {:rw} maps_2(a: array<int, int>, ms: seq<int>, x: int)
  ensures maps(for ms yield m :: x < a[m]) == gts(a, ms, x)

lemma {:rw} maps_3(a: array<int, int>, ms: seq<int>, x: int)
  ensures maps(for ms yield m :: x == a[m]) == eqs(a, ms, x)

lemma {:rw} earlier_1(a: array<int, int>, ms: seq<int>, x: int)
  requires occurs(true, lts(a, ms, x))
  ensures a[earlier(indexof(true, lts(a, ms, x)), ms)] < x

lemma {:rw} earlier_2(a: array<int, int>, ms: seq<int>, x: int)
  requires occurs(true, gts(a, ms, x))
  ensures x < a[earlier(indexof(true, gts(a, ms, x)), ms)]

lemma {:rw} earlier_3(a: array<int, int>, ms: seq<int>, x: int)
  requires occurs(true, eqs(a, ms, x))
  ensures x == a[earlier(indexof(true, eqs(a, ms, x)), ms)] <==> true

function sorted(a: array<int, int>): bool {
  forall j: int, k: int :: j <= k ==> a[j] <= a[k]
}

lemma {:rw} earlier_4(a: array<int, int>, ms: seq<int>, x: int)
  requires sorted(a)
  requires occurs(true, lts(a, ms, x))
  requires occurs(true, gts(a, ms, x))
  ensures
    earlier(indexof(true, lts(a, ms, x)), ms)
      < earlier(indexof(true, gts(a, ms, x)), ms)

lemma {:rw} earlier_5(a: array<int, int>, ms: seq<int>, x: int, k: int)
  requires sorted(a)
  requires occurs(true, lts(a, ms, x))
  requires a[k] == x
  ensures earlier(indexof(true, lts(a, ms, x)), ms) < k

lemma {:rw} earlier_6(a: array<int, int>, ms: seq<int>, x: int, k: int)
  requires sorted(a)
  requires occurs(true, gts(a, ms, x))
  requires a[k] == x
  ensures k < earlier(indexof(true, gts(a, ms, x)), ms)

function mids(m0: int, ks: seq<int>, ls: seq<int>, hs: seq<int>, B: int -> bool,
              C: int -> bool, D: int -> bool, V: (int, int) -> int,
              W: (int, int) -> int, U: (int, int) -> int): Trace<int>

lemma {:rw} trace_3(m0: int, K: Trace<int>, ls: seq<int>, hs: seq<int>,
                    B: int -> bool, C: int -> bool, D: int -> bool,
                    V: (int, int) -> int, W: (int, int) -> int,
                    U: (int, int) -> int)
  ensures
    trace(m0, for ⌊K⌋, ls, hs
              do y, k, l, h ::
                case B(y) => V(y, h) case C(y) => W(l, y) case D(y) => U(l, h))
      == mids(m0, ⌊K⌋, ls, hs, B, C, D, V, W, U)

method search(a: array<int, int>, n: int, x: int) returns (i: int)
  requires 0 <= n
  requires sorted(a)
  ensures 0 <= i ==> i < n && a[i] == x
  ensures i < 0 ==> (forall k: int :: 0 <= k < n ==> a[k] != x)
{
  var lo: int, hi: int, mid: int;
  lo := 0;
  hi := n;
  i := -1;
  mid := (lo + hi) / 2;
  while lo < hi && i < 0 {
    if a[mid] < x {
      lo := mid + 1;
    } else if x < a[mid] {
      hi := mid;
    } else {
      i := mid;
    }
    mid := (lo + hi) / 2;
  }
}

