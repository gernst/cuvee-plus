method squares_below(len: int) returns (res: int)
  requires 0 <= len
{
  var tot: int, idx: int;
  tot := 0;
  idx := 0;
  while idx < len
    invariant tot == squares(0, idx) && idx <= len && 0 <= idx
  {
    tot := tot + idx * idx;
    idx := idx + 1;
  }
  if 0 <= tot {
    res := tot;
  } else {
    res := -1;
  }
}

