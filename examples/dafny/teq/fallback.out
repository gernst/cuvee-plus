function I₁₈(x₀: int): int

function V₁₉(x₀: int): int

function S₂₀(x₀: int): int

function V?₂₁(x₀: int): int

goal {:abstract}
  forall a: array<int, int>, n: int, i: int, s: int ::
    0 <= n
      ==> (forall v₁: int ::
             forall v₁₃: int, s₁₄: int, i₁₅: int, n₇: int ::
               I₁₈(0) == 0
                 && (forall j₂₂: int ::
                       0 <= j₂₂ < n₇
                         ==> a[I₁₈(j₂₂)] != 0
                         ==> I₁₈(j₂₂ + 1) == I₁₈(j₂₂) + 1)
                 && V₁₉(0) == v₁
                 && (forall j₂₃: int ::
                       0 <= j₂₃ < n₇
                         ==> a[I₁₈(j₂₃)] != 0
                         ==> V₁₉(j₂₃ + 1) == V?₂₁(j₂₃))
                 && S₂₀(0) == 0
                 && (forall j₂₄: int ::
                       0 <= j₂₄ < n₇
                         ==> a[I₁₈(j₂₄)] != 0
                         ==> S₂₀(j₂₄ + 1) == S₂₀(j₂₄) + V?₂₁(j₂₄))
                 && v₁₃ == V₁₉(n₇)
                 && s₁₄ == S₂₀(n₇)
                 && i₁₅ == I₁₈(n₇)
                 && (forall j₂₅: int ::
                       0 <= j₂₅ < n₇
                         ==> I₁₈(j₂₅) < n
                           && a[I₁₈(j₂₅)] != 0
                           && (a[I₁₈(j₂₅)] != 0 ==> true))
                 && 0 <= n₇ == n₇
                 ==> (i₁₅ < n
                        ==> (a[i₁₅] == 0 ==> true)
                          && (a[i₁₅] != 0
                                ==> (forall v₁₆: int :: true ==> true)))
                   && (!(i₁₅ < n) ==> 0 <= i₁₅ <= n)
                   && (i₁₅ < n ==> a[i₁₅] == 0 ==> 0 <= i₁₅ <= n))

