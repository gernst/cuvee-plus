function S_0₁₈₂(x₀: int): int

function S_1₁₈₂(x₀: int): int

goal {:abstract}
  forall n: int, a₁₅: int ::
    0 <= n
      && S_0₁₈₂(0) == 0
      && (forall j₁₈₃: int ::
            0 <= j₁₈₃ < n ==> S_0₁₈₂(j₁₈₃ + 1) == S_1₁₈₂(j₁₈₃))
      && S_1₁₈₂(0) == 1
      && (forall j₁₈₃: int ::
            0 <= j₁₈₃ < n ==> S_1₁₈₂(j₁₈₃ + 1) == S_0₁₈₂(j₁₈₃) + S_1₁₈₂(j₁₈₃))
      && a₁₅ == S_0₁₈₂(n)
      ==> 0 <= a₁₅

