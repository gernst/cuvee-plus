function S_0₂₈₂(x₀: int): int

function S_1₂₈₂(x₀: int): int

goal {:abstract}
  forall a₁₅: int, i₁₇: int, n₈: int ::
    0 <= n₈
      ==> 0 <= i₁₇
        && S_0₂₈₂(0) == 0
        && (forall j₂₈₄: int ::
              0 <= j₂₈₄ < n₈ ==> S_0₂₈₂(j₂₈₄ + 1) == S_1₂₈₂(j₂₈₄))
        && S_1₂₈₂(0) == 1
        && (forall j₂₈₄: int ::
              0 <= j₂₈₄ < n₈
                ==> S_1₂₈₂(j₂₈₄ + 1) == S_0₂₈₂(j₂₈₄) + S_1₂₈₂(j₂₈₄))
        && a₁₅ == S_0₂₈₂(n₈)
        && n₈ == (if 0 <= i₁₇ then i₁₇ else 0)
      ==> 0 <= a₁₅

