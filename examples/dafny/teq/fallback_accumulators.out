function S_0₃₃₄(x₀: int): int

function S_1₃₃₄(x₀: int): int

goal {:abstract}
  forall n: int, a₁₅: int ::
    0 <= n
      && S_0₃₃₄(0) == 0
      && (forall j₃₃₅: int ::
            0 <= j₃₃₅ < n ==> S_0₃₃₄(j₃₃₅ + 1) == S_1₃₃₄(j₃₃₅))
      && S_1₃₃₄(0) == 1
      && (forall j₃₃₅: int ::
            0 <= j₃₃₅ < n ==> S_1₃₃₄(j₃₃₅ + 1) == S_0₃₃₄(j₃₃₅) + S_1₃₃₄(j₃₃₅))
      && a₁₅ == S_0₃₃₄(n)
      ==> 0 <= a₁₅

