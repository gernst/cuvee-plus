function S_0₂₇₆(x₀: int): int

function S_1₂₇₆(x₀: int): int

function `=₂₇₉`(x₀: int, x₁: int): bool

goal {:abstract}
  forall a₁₅: int, i₁₇: int, n₈: int ::
    0 <= n₈
      ==> 0 <= i₁₇
        && S_0₂₇₆(0) == 0
        && (forall j₂₇₈: int ::
              0 <= j₂₇₈ < n₈ ==> S_0₂₇₆(j₂₇₈ + 1) == S_1₂₇₆(j₂₇₈))
        && S_1₂₇₆(0) == 1
        && (forall j₂₇₈: int ::
              0 <= j₂₇₈ < n₈
                ==> S_1₂₇₆(j₂₇₈ + 1) == S_0₂₇₆(j₂₇₈) + S_1₂₇₆(j₂₇₈))
        && a₁₅ == S_0₂₇₆(n₈)
        && `=₂₇₉`(i₁₇, n₈)
      ==> 0 <= a₁₅

