goal {:used (counter_def 1)} {:used (counts_true_def 1)} {:used
  (current_counter 1)} {:used (current_counts 1)} {:used
  (earlier_counter 7)} {:used (earlier_counts 1)} {:used
  (integer_natural 7)} {:used
  (invs_counter_upper_nonnegative
    1)}
  forall a: array<int, int>, n: int, c₁₉: int, n₁₄: Nat, K₁₆: Trace<int>,
         I₁₈: Trace<int> ::
    K₁₆ == counter(0, 1, n₁₄)
      && c₁₉ == count(true, maps(for ⌊K₁₆⌋, ⌊I₁₈⌋ yield k₁₅, i₁₃ :: a[k₁₅] < 0))
      && I₁₈ == counter(0, 1, n₁₄)
      && integer(n₁₄) == n
      && 0 <= integer(n₁₄)
      ==> c₁₉ <= n

