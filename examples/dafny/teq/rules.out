info :used :=
  ((counter_def 1)
    (current_counter 1)
    (current_stores 1)
    (earlier_counter 3)
    (earlier_selects 1)
    (indexof_counter_up 1)
    (invs_counter_upper_nonnegative
      1)
    (occurs_counter_up 2)
    (selects 1)
    (stores 1))

goal
  forall a: array<int, int>, n: int, c₁₉: int, K₁₆: Trace<int>,
         C₁₈: Trace<int> ::
    0 <= n
      && K₁₆ == counter(0, 1, n)
      && C₁₈
        == trace(0, for ⌊K₁₆⌋
                 do c₁₂, k₁₅ ::
                   case a[k₁₅] < 0 => c₁₂ + 1 case 0 <= a[k₁₅] => c₁₂)
      && c₁₉ == current(C₁₈)
      ==> c₁₉ <= n

info :used :=
  ((counter_def 1)
    (current_counter 1)
    (earlier_counter 2)
    (invs_counter_upper_nonnegative
      1))

