goal
  forall a: array<int, int>, c₁₉: int, i₂₀: int, n₁₄: Nat, I₁₇: Trace<int>,
         C₁₈: Trace<int> ::
    0 <= i₂₀
      && I₁₇ == counter(0, 1, n₁₄)
      && C₁₈
        == trace(0, for ⌊I₁₇⌋
                 do c₁₂, k₁₅ ::
                   case a[k₁₅] < 0 => c₁₂ + 1 case 0 <= a[k₁₅] => c₁₂)
      && c₁₉ == current(C₁₈)
      && n₁₄ == natural(i₂₀)
      ==> c₁₉ <= i₂₀

