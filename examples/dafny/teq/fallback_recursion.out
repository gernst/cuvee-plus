const xs_length₂: int

function xs₁(x₀: int): int

const sum₃: int

function occurs_from₅(x₀: int, x₁: int): bool

function elems_from₈(x₀: int): multiset<int>

function pow_upto₁₂(x₀: int, x₁: int): int

goal {:abstract}
  0 <= xs_length₂
    && (forall x: int ::
          occurs_from₅(x, xs_length₂) == false
            && (forall j₆: int ::
                  0 <= j₆ < xs_length₂
                    ==> occurs_from₅(x, j₆)
                      == (xs₁(j₆) == x || occurs_from₅(x, j₆ + 1))))
    && (elems_from₈(xs_length₂) == multiset{}
          && (forall j₉: int ::
                0 <= j₉ < xs_length₂
                  ==> elems_from₈(j₉)
                    == multiset{xs₁(j₉)} + elems_from₈(j₉ + 1)))
    && (forall n: int ::
          (forall j₁₃: int :: j₁₃ <= 0 ==> pow_upto₁₂(n, j₁₃) == 1)
            && (forall j₁₃: int ::
                  0 <= j₁₃ < n
                    ==> pow_upto₁₂(n, j₁₃ + 1) == 2 * pow_upto₁₂(n, j₁₃)))
    ==> (forall x: int, n: int, r: int ::
           true
             ==> (0 <= sum₃ || occurs_from₅(x, 0))
               && elems_from₈(0)[x] <= pow_upto₁₂(n, n))

