function sorted(a: array<int, int>, lo: int, hi: int): bool

function perm(a: array<int, int>, b: array<int, int>): bool

lemma {:rw} perm_refl(a: array<int, int>)
  ensures perm(a, a) <==> true

function {:fold} insert_pass(b: array<int, int>, i: int, p: int,
                             nn: Nat): Trace<array<int, int>> {
  trace(b, for ⌊counter(0, 1, nn)⌋, ⌊counter(i, -1, nn)⌋
        do x, kk, j ::
          x[j := x[-kk + p]][-kk + p := x[j]])
}

lemma {:rw} perm_insert_pass(b: array<int, int>, c: array<int, int>, i: int,
                             p: int, nn: Nat)
  ensures perm(current(insert_pass(b, i, p, nn)), c) <==> perm(b, c)

lemma {:rw} perm_steps_three(a: array<int, int>, c: array<int, int>,
                             ks: List<int>, ns: List<Nat>, is: List<int>,
                             F: (array<int, int>, int, Nat, int) -> array<int, int>)
  requires
    forall b: array<int, int>, k: int, nn: Nat, i: int ::
      perm(F(b, k, nn, i), b)
  ensures
    perm(current(trace(a, for ks, ns, is do b, k, nn, i :: F(b, k, nn, i))), c)
      <==> perm(a, c)

lemma {:rw} sorted_insert_pass(b: array<int, int>, i: int, p: int, nn: Nat)
  requires p + 1 == i
  requires 0 <= p
  requires integer(nn) <= p + 1
  requires sorted(b, 0, p + 1)
  requires
    invs(for ⌊counter(0, 1, nn)⌋,
             ⌊insert_pass(b, i, p, nn)⌋,
             ⌊counter(i, -1, nn)⌋
         check kk, y, j ::
           y[j] < y[-kk + p])
  requires
    !(integer(nn) <= p
        && current(insert_pass(b, i, p, nn))[-integer(nn) + p + 1]
          < current(insert_pass(b, i, p, nn))[-integer(nn) + p])
  ensures sorted(current(insert_pass(b, i, p, nn)), 0, p + 2) <==> true

lemma {:rw} sorted_insert_steps(a: array<int, int>, len: int, m: Nat,
                                ns: List<Nat>,
                                F: (array<int, int>, int, Nat, int) -> array<int, int>,
                                C: (int, int, array<int, int>, Nat) -> bool,
                                D: (int, array<int, int>, int, Nat) -> bool)
  requires len <= integer(m) + 1
  requires
    invs(for ⌊counter(0, 1, m)⌋,
             ⌊counter(1, 1, m)⌋,
             ⌊trace(a, for ⌊counter(0, 1, m)⌋, ns, ⌊counter(1, 1, m)⌋
                    do b, k, nn, i ::
                      F(b, k, nn, i))⌋,
             ns
         check k, i, b, nn ::
           C(k, i, b, nn))
  requires
    invs(for ⌊counter(0, 1, m)⌋,
             ⌊trace(a, for ⌊counter(0, 1, m)⌋, ns, ⌊counter(1, 1, m)⌋
                    do b, k, nn, i ::
                      F(b, k, nn, i))⌋,
             ⌊counter(1, 1, m)⌋,
             ns
         check k, b, i, nn ::
           D(k, b, i, nn))
  requires
    forall b: array<int, int>, k: int, nn: Nat, i: int ::
      0 <= k < integer(m)
        && i == k + 1
        && integer(nn) <= k + 1
        && sorted(b, 0, k + 1)
        && C(k, i, b, nn)
        && D(k, b, i, nn)
        ==> sorted(F(b, k, nn, i), 0, k + 2)
  ensures
    sorted(current(trace(a, for ⌊counter(0, 1, m)⌋, ns, ⌊counter(1, 1, m)⌋
                         do b, k, nn, i ::
                           F(b, k, nn, i))), 0, len)
      <==> true

