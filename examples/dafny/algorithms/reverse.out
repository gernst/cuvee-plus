lemma {:rw} invs_pairs(n: Nat, m: int, hs: List<int>, gs: List<int>)
  ensures
    invs(for ⌊counter(0, 1, n)⌋, hs, gs check k, h, g :: 2 * k + 1 < m)
      <==> n == zero || 2 * integer(n) - 1 < m

lemma {:rw} current_reversal_exit(a: array<int, int>, c: int, d: int, n: Nat,
                                  j: int, m: int)
  requires n == zero || integer(n) < m + 2
  requires integer(n) + m == c
  requires m <= integer(n)
  requires d == -1
  ensures
    current(trace(a, for ⌊counter(0, 1, n)⌋, ⌊counter(c, d, n)⌋
                  do b, k, l ::
                    b[k := b[l]][l := b[k]]))[j]
      == (if 0 <= j <= c then a[c - j] else a[j])

