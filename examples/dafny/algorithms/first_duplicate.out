function {:fold} scan(x: bool, a: array<int, int>, i: int,
                      nn: Nat): Trace<bool> {
  trace(x, for ⌊counter(0, 1, nn)⌋, ⌊counter(i + 1, 1, nn)⌋
        do r, kk, j ::
          case a[i] == a[j] => true case a[i] != a[j] => r)
}

lemma {:rw} distincts_flag_set(a: array<int, int>, n: int, m: Nat,
                               ns: List<Nat>, Kv: Trace<int>)
  requires Kv == counter(0, 1, m)
  requires
    current(trace(false, for ⌊Kv⌋, ns, ⌊counter(0, 1, m)⌋
                  do x, k, nn, i ::
                    current(scan(x, a, i, nn))))
  requires
    invs(for ⌊Kv⌋, ⌊counter(0, 1, m)⌋, ns
         check k, i, nn ::
           nn == zero || i + 1 < n && integer(nn) + i < n)
  ensures distincts(selects(a, ⌊counter(0, 1, natural(n))⌋)) <==> false

lemma {:rw} distincts_flags_reset(a: array<int, int>, n: int, m: Nat,
                                  ns: List<Nat>, i0: int, Kv: Trace<int>)
  requires Kv == counter(0, 1, m)
  requires
    !current(trace(false, for ⌊Kv⌋, ns, ⌊counter(0, 1, m)⌋
                   do x, k, nn, i ::
                     current(scan(x, a, i, nn))))
  requires
    invs(for ⌊Kv⌋,
             ⌊trace(false, for ⌊Kv⌋, ns, ⌊counter(0, 1, m)⌋
                    do x, k, nn, i ::
                      current(scan(x, a, i, nn)))⌋,
             ⌊counter(0, 1, m)⌋
         check k, x, i ::
           !x)
  requires
    invs(for ⌊Kv⌋, ⌊counter(0, 1, m)⌋, ns
         check k, i, nn ::
           !(integer(nn) + i + 1 < n && !current(scan(false, a, i, nn))))
  requires m == natural(i0)
  requires n <= i0
  ensures distincts(selects(a, ⌊counter(0, 1, natural(n))⌋)) <==> true

