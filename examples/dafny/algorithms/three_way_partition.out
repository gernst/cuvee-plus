function perm(a: array<int, int>, b: array<int, int>): bool

function threeway(a: array<int, int>, p: int, n: Nat, es: List<int>,
                  ls: List<int>): Trace<array<int, int>>

lemma {:rw} threeway_def(a: array<int, int>, p: int, n: Nat, es: List<int>,
                         js: List<int>, ls: List<int>)
  ensures
    trace(a, for ⌊counter(0, 1, n)⌋, es, js, ls
          do b, k, eq, j, lt ::
            case b[k] < p => b[k := b[eq]][eq := b[k := b[eq]][lt]][lt := b[k]]
            case b[k] == p => b[k := b[eq]][eq := b[k]]
            case p < b[k] => b)
      == threeway(a, p, n, es, ls)

lemma {:rw} maps_threeway_read(a: array<int, int>, p: int, n: Nat,
                               es: List<int>, ls: List<int>, hs: List<int>,
                               P: (int, int, int) -> bool)
  ensures
    maps(for ⌊counter(0, 1, n)⌋, ⌊threeway(a, p, n, es, ls)⌋, hs
         yield k, b, h ::
           P(b[k], k, h))
      == maps(for ⌊counter(0, 1, n)⌋, hs yield k, h :: P(a[k], k, h))

lemma {:rw} maps_threeway_read_one(a: array<int, int>, p: int, n: Nat,
                                   es: List<int>, ls: List<int>,
                                   P: (int, int) -> bool)
  ensures
    maps(for ⌊counter(0, 1, n)⌋, ⌊threeway(a, p, n, es, ls)⌋
         yield k, b ::
           P(b[k], k))
      == maps(for ⌊counter(0, 1, n)⌋ yield k :: P(a[k], k))

function {:fold} below(a: array<int, int>, p: int, n: Nat): int {
  count(true, maps(for ⌊counter(0, 1, n)⌋ yield k :: a[k] < p))
}

function {:fold} beloweq(a: array<int, int>, p: int, n: Nat,
                         hs: List<int>): int {
  count(true, maps(for ⌊counter(0, 1, n)⌋, hs
                   yield k, h ::
                     a[k] < p || a[k] == p))
}

lemma {:rw} below_nonnegative(a: array<int, int>, p: int, n: Nat)
  ensures 0 <= below(a, p, n)

lemma {:rw} below_le_beloweq(a: array<int, int>, p: int, n: Nat, hs: List<int>)
  ensures below(a, p, n) <= beloweq(a, p, n, hs)

lemma {:rw} threeway_lt(a: array<int, int>, p: int, n: Nat, k: int)
  requires 0 <= k
  requires k < below(a, p, n)
  ensures
    current(trace(a, 0, 0, 0,
                  for ⌊counter(0, 1, n)⌋
                  do b, e, j, l, kk ::
                    case b[j] < p => b[j := b[e]][e := b[j := b[e]][l]][
                      l :=
                      b[j]]
                    case b[j] == p => b[j := b[e]][e := b[j]]
                    case p < b[j] => b,
                    case b[j] < p || b[j] == p => e + 1 case p < b[j] => e,
                    j + 1,
                    case b[j] < p => l + 1
                    case b[j] == p || p < b[j] => l)).0[k]
      < p
      <==> true

lemma {:rw} threeway_eq(a: array<int, int>, p: int, n: Nat, k: int)
  requires below(a, p, n) <= k
  requires k < beloweq(a, p, n, ⌊counter(0, 1, n)⌋)
  ensures
    current(trace(a, 0, 0, 0,
                  for ⌊counter(0, 1, n)⌋
                  do b, e, j, l, kk ::
                    case b[j] < p => b[j := b[e]][e := b[j := b[e]][l]][
                      l :=
                      b[j]]
                    case b[j] == p => b[j := b[e]][e := b[j]]
                    case p < b[j] => b,
                    case b[j] < p || b[j] == p => e + 1 case p < b[j] => e,
                    j + 1,
                    case b[j] < p => l + 1
                    case b[j] == p || p < b[j] => l)).0[k]
      == p
      <==> true

lemma {:rw} threeway_gt(a: array<int, int>, p: int, n: Nat, k: int)
  requires beloweq(a, p, n, ⌊counter(0, 1, n)⌋) <= k
  requires k < integer(n)
  ensures
    p
      < current(trace(a, 0, 0, 0,
                      for ⌊counter(0, 1, n)⌋
                      do b, e, j, l, kk ::
                        case b[j] < p => b[j := b[e]][e := b[j := b[e]][l]][
                          l :=
                          b[j]]
                        case b[j] == p => b[j := b[e]][e := b[j]]
                        case p < b[j] => b,
                        case b[j] < p || b[j] == p => e + 1 case p < b[j] => e,
                        j + 1,
                        case b[j] < p => l + 1
                        case b[j] == p || p < b[j] => l)).0[k]
      <==> true

lemma {:rw} beloweq_le_natural(a: array<int, int>, p: int, n: Nat,
                               hs: List<int>, m: int)
  requires n == natural(m)
  requires 0 <= m
  ensures beloweq(a, p, n, hs) <= m <==> true

lemma {:rw} perm_threeway(a: array<int, int>, c: array<int, int>, p: int,
                          n: Nat, es: List<int>, ls: List<int>)
  ensures perm(current(threeway(a, p, n, es, ls)), c) <==> perm(a, c)

lemma {:rw} perm_refl(a: array<int, int>)
  ensures perm(a, a) <==> true

