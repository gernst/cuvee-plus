function perm(a: array<int, int>, b: array<int, int>): bool

function threeway(a: array<int, int>, p: int, n: Nat, es: List<int>,
                  ls: List<int>): Trace<array<int, int>>

lemma {:rw} threeway_def(a: array<int, int>, p: int, n: Nat, es: List<int>,
                         js: List<int>, ls: List<int>)
  ensures
    trace(a, for ⌊counter(0, 1, n)⌋, es, js, ls
          do b, k, eq, j, lt ::
            case b[k] < p => b[k := b[eq]][eq := b[k := b[eq]][lt]][lt := b[k]]
            case b[k] == p => b[k := b[eq]][eq := b[k]]
            case p < b[k] => b)
      == threeway(a, p, n, es, ls)

lemma {:rw} maps_threeway_read(a: array<int, int>, p: int, n: Nat,
                               es: List<int>, ls: List<int>, hs: List<int>,
                               P: (int, int, int) -> bool)
  ensures
    maps(for ⌊counter(0, 1, n)⌋, ⌊threeway(a, p, n, es, ls)⌋, hs
         yield k, b, h ::
           P(b[k], k, h))
      == maps(for ⌊counter(0, 1, n)⌋, hs yield k, h :: P(a[k], k, h))

lemma {:rw} maps_threeway_read_one(a: array<int, int>, p: int, n: Nat,
                                   es: List<int>, ls: List<int>,
                                   P: (int, int) -> bool)
  ensures
    maps(for ⌊counter(0, 1, n)⌋, ⌊threeway(a, p, n, es, ls)⌋
         yield k, b ::
           P(b[k], k))
      == maps(for ⌊counter(0, 1, n)⌋ yield k :: P(a[k], k))

function below(a: array<int, int>, p: int, n: Nat): int

function beloweq(a: array<int, int>, p: int, n: Nat, hs: List<int>): int

lemma {:rw} below_def(a: array<int, int>, p: int, n: Nat)
  ensures
    count(true, maps(for ⌊counter(0, 1, n)⌋ yield k :: a[k] < p))
      == below(a, p, n)

lemma {:rw} beloweq_def(a: array<int, int>, p: int, n: Nat, hs: List<int>)
  ensures
    count(true, maps(for ⌊counter(0, 1, n)⌋, hs
                     yield k, h ::
                       a[k] < p || a[k] == p))
      == beloweq(a, p, n, hs)

lemma {:rw} below_nonnegative(a: array<int, int>, p: int, n: Nat)
  ensures 0 <= below(a, p, n)

lemma {:rw} below_le_beloweq(a: array<int, int>, p: int, n: Nat, hs: List<int>)
  ensures below(a, p, n) <= beloweq(a, p, n, hs)

lemma {:rw} beloweq_le(a: array<int, int>, p: int, n: Nat, hs: List<int>)
  ensures beloweq(a, p, n, hs) <= integer(n)

lemma {:rw} current_threeway_below(a: array<int, int>, p: int, n: Nat,
                                   hs: List<int>, k: int)
  requires 0 <= k
  requires k < below(a, p, n)
  ensures
    current(threeway(a, p, n, ⌊counts(0, true, maps(for ⌊counter(0, 1, n)⌋, hs
                                                    yield k2, h ::
                                                      a[k2] < p
                                                        || a[k2] == p))⌋,
                     ⌊counts(0, true, maps(for ⌊counter(0, 1, n)⌋
                                           yield k2 ::
                                             a[k2] < p))⌋))[k]
      < p
      <==> true

lemma {:rw} current_threeway_equal(a: array<int, int>, p: int, n: Nat,
                                   hs: List<int>, k: int)
  requires below(a, p, n) <= k
  requires k < beloweq(a, p, n, hs)
  ensures
    current(threeway(a, p, n, ⌊counts(0, true, maps(for ⌊counter(0, 1, n)⌋, hs
                                                    yield k2, h ::
                                                      a[k2] < p
                                                        || a[k2] == p))⌋,
                     ⌊counts(0, true, maps(for ⌊counter(0, 1, n)⌋
                                           yield k2 ::
                                             a[k2] < p))⌋))[k]
      == p
      <==> true

lemma {:rw} current_threeway_above(a: array<int, int>, p: int, n: Nat,
                                   hs: List<int>, k: int)
  requires beloweq(a, p, n, hs) <= k
  requires k < integer(n)
  ensures
    p
      < current(threeway(a, p, n, ⌊counts(0, true, maps(for ⌊counter(0, 1, n)⌋,
                                                            hs
                                                        yield k2, h ::
                                                          a[k2] < p
                                                            || a[k2] == p))⌋,
                         ⌊counts(0, true, maps(for ⌊counter(0, 1, n)⌋
                                               yield k2 ::
                                                 a[k2] < p))⌋))[k]
      <==> true

lemma {:rw} perm_threeway(a: array<int, int>, c: array<int, int>, p: int,
                          n: Nat, es: List<int>, ls: List<int>)
  ensures perm(current(threeway(a, p, n, es, ls)), c) <==> perm(a, c)

lemma {:rw} perm_refl(a: array<int, int>)
  ensures perm(a, a) <==> true

goal
  forall a: array<int, int>, p: int, b₁₃: array<int, int>, eq₁₄: int, j₁₆: int,
         lt₁₇: int, n₈: Nat, K₁₀: Trace<int>,
         S₁₁: Trace<(array<int, int>, int, int, int)> ::
    0 <= j₁₆
      && K₁₀ == counter(0, 1, n₈)
      && S₁₁
        == trace(a, 0, 0, 0,
                 for ⌊K₁₀⌋
                 do b₃, eq₄, j₆, lt₇, k₉ ::
                   case b₃[j₆] < p => b₃[j₆ := b₃[eq₄]][
                     eq₄ :=
                     b₃[j₆ := b₃[eq₄]][lt₇]][
                     lt₇ :=
                     b₃[j₆]]
                   case b₃[j₆] == p => b₃[j₆ := b₃[eq₄]][eq₄ := b₃[j₆]]
                   case p < b₃[j₆] => b₃,
                   case b₃[j₆] < p || b₃[j₆] == p => eq₄ + 1
                   case p < b₃[j₆] => eq₄,
                   j₆ + 1,
                   case b₃[j₆] < p => lt₇ + 1
                   case b₃[j₆] == p || p < b₃[j₆] => lt₇)
      && b₁₃ == current(S₁₁).0
      && eq₁₄ == beloweq(a, p, n₈, ⌊counter(0, 1, n₈)⌋)
      && n₈ == natural(j₁₆)
      && lt₁₇ == below(a, p, n₈)
      ==> eq₁₄ <= j₁₆
        && (forall k: int :: 0 <= k < lt₁₇ ==> b₁₃[k] < p)
        && (forall k: int :: lt₁₇ <= k < eq₁₄ ==> b₁₃[k] == p)
        && (forall k: int :: eq₁₄ <= k < j₁₆ ==> p < b₁₃[k])

