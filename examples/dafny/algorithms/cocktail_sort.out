function sorted(a: array<int, int>, lo: int, hi: int): bool

function perm(a: array<int, int>, b: array<int, int>): bool

lemma {:rw} perm_refl(a: array<int, int>)
  ensures perm(a, a) <==> true

lemma {:rw} invs_sums_counter(ks: List<int>, Ks: List<Trace<int>>,
                              Ns: List<Nat>, Js: List<Trace<int>>,
                              X: int -> int, c: int)
  requires invs(for ks, Ks, Ns check k, K, nn :: K == counter(0, 1, nn))
  ensures
    invs(for ks, Ks, Js
         check k, K, J ::
           J == sums(X(k), maps(for ⌊K⌋ yield i :: c)))
      <==> invs(for ks, Ns, Js check k, nn, J :: J == counter(X(k), c, nn))

function {:fold} bubble_pass(b: array<int, int>,
                             js: List<int>): Trace<array<int, int>> {
  trace(b, for js
           do x, j ::
             case x[j + 1] < x[j] => x[j := x[j + 1]][j + 1 := x[j]]
             case x[j] <= x[j + 1] => x)
}

function {:fold} bubble_pass_back(b: array<int, int>, js: List<int>,
                                  ps: List<int>): Trace<array<int, int>> {
  trace(b, for js, ps
           do x, j, p ::
             case x[j] < x[p] => x[j := x[p]][p := x[j]] case x[p] <= x[j] => x)
}

function shake(b: array<int, int>, k: int, n: int): array<int, int>

lemma {:rw} current_results_shake(a: array<int, int>, len: int, len2: int,
                                  len3: int, d: int, ks: List<int>,
                                  bs: List<array<int, int>>,
                                  Bs: List<Trace<array<int, int>>>,
                                  cs: List<array<int, int>>,
                                  Cs: List<Trace<array<int, int>>>,
                                  Js: List<Trace<int>>, Ns: List<Nat>,
                                  js: List<int>, Js2: List<Trace<int>>,
                                  Ps: List<Trace<int>>, Ns2: List<Nat>,
                                  Js3: List<Trace<int>>, ps: List<int>,
                                  Ps3: List<Trace<int>>, js4: List<int>,
                                  Js4: List<Trace<int>>, js5: List<int>,
                                  Ns5: List<Nat>, js6: List<int>,
                                  Ns6: List<Nat>, Ns7: List<Nat>, X: int -> int,
                                  Y: int -> int)
  requires invs(for ks, cs, Cs check k, c, C :: c == current(C))
  requires
    invs(for ks, ⌊results(a, ks, bs)⌋, Cs, Js
         check k, x, C, J ::
           C == bubble_pass(x, ⌊J⌋))
  requires invs(for ks, Ns, Js check k, nn, J :: J == counter(k, 1, nn))
  requires invs(for ks, js check k, j :: len <= j + k + 1)
  requires
    invs(for ks, Js2 check k, J :: invs(for ⌊J⌋ check j :: j + k + 1 < len2))
  requires Js2 == Js
  requires len2 == len
  requires invs(for ks, Ns5, js5 check k, nn, j :: j == integer(nn) + k)
  requires js5 == js
  requires Ns5 == Ns
  requires invs(for ks, bs, Bs check k, b, B :: b == current(B))
  requires
    invs(for ks, cs, Bs, Js3, Ps3
         check k, c, B, J, P ::
           B == bubble_pass_back(c, ⌊J⌋, ⌊P⌋))
  requires invs(for ks, Ns2, Js3 check k, nn, J :: J == counter(X(k), d, nn))
  requires d == -1
  requires invs(for ks check k :: X(k) == len - k - 2)
  requires invs(for ks, Ns2, Ps check k, nn, P :: P == counter(Y(k), d, nn))
  requires Ps == Ps3
  requires invs(for ks check k :: Y(k) == len - k - 3)
  requires invs(for ks, Js4 check k, J :: invs(for ⌊J⌋ check j :: k < j))
  requires Js4 == Js3
  requires invs(for ks, js4 check k, j :: j <= k)
  requires
    invs(for ks, Ns6, ps check k, nn, p :: integer(nn) + p + k + 3 == len)
  requires Ns6 == Ns2
  requires
    invs(for ks, Ns7, js6 check k, nn, j :: integer(nn) + j + k + 2 == len)
  requires js6 == js4
  requires Ns7 == Ns2
  ensures
    current(results(a, ks, bs))
      == current(trace(a, for ks do b, k :: shake(b, k, len)))

function shaken(b: array<int, int>, k: int, n: int): bool

lemma {:rw} shaken_shake(b: array<int, int>, k: int, len: int)
  requires shaken(b, k, len)
  ensures shaken(shake(b, k, len), k + 1, len) <==> true

lemma {:rw} sorted_shaken_steps(a: array<int, int>, len: int, m: Nat, l: int,
                                F: (array<int, int>, int) -> array<int, int>)
  requires l == integer(m)
  requires len <= integer(m) + l + 1
  requires
    forall b: array<int, int>, k: int ::
      0 <= k < integer(m) && shaken(b, k, len) ==> shaken(F(b, k), k + 1, len)
  ensures
    sorted(current(trace(a, for ⌊counter(0, 1, m)⌋ do b, k :: F(b, k))), 0, len)
      <==> true

lemma {:rw} perm_shake(b: array<int, int>, c: array<int, int>, k: int, len: int)
  ensures perm(shake(b, k, len), c) <==> perm(b, c)

lemma {:rw} perm_steps(a: array<int, int>, c: array<int, int>, ks: List<int>,
                       F: (array<int, int>, int) -> array<int, int>)
  requires forall b: array<int, int>, k: int :: perm(F(b, k), b)
  ensures perm(current(trace(a, for ks do b, k :: F(b, k))), c) <==> perm(a, c)

