function nodup(a: array<int, int>, k: int, h: int): bool

lemma {:rw} current_flag_nodup(a: array<int, int>, d: bool, k: int, nn: Nat)
  ensures
    current(trace(d, for ⌊counter(0, 1, nn)⌋, ⌊counter(k + 1, 1, nn)⌋
                  do x, i, j ::
                    case a[k] == a[j] => false case a[k] != a[j] => x))
      == (d && nodup(a, k, k + 1 + integer(nn)))

lemma {:rw} current_distinct_steps(a: array<int, int>, len: int, m: Nat,
                                   ns: List<Nat>)
  requires
    invs(for ⌊counter(0, 1, m)⌋, ns check k, nn :: len <= integer(nn) + k + 1)
  requires
    invs(for ⌊counter(0, 1, m)⌋, ns
         check k, nn ::
           nn == zero || k + 1 < len && integer(nn) + k < len)
  requires len == integer(m)
  ensures
    current(trace(true, for ⌊counter(0, 1, m)⌋, ns
                  do d, k, nn ::
                    d && nodup(a, k, k + 1 + integer(nn))))
      == distincts(selects(a, ⌊counter(0, 1, natural(len))⌋))

