function sorted(a: array<int, int>, lo: int, hi: int): bool

lemma {:rw} current_trace_flag_bool(x0: bool, c: bool, n: Nat, hs: List<int>,
                                    D: (int, int) -> bool)
  ensures
    current(trace(x0, for ⌊counter(0, 1, n)⌋, hs
                  do f, k, h ::
                    case D(k, h) => c case !D(k, h) => f))
      == (if invs(for ⌊counter(0, 1, n)⌋, hs check k, h :: !D(k, h))
          then x0
          else c)

lemma {:rw} sorted_def(a: array<int, int>, n: Nat)
  ensures
    invs(for ⌊counter(0, 1, n)⌋, ⌊counter(1, 1, n)⌋ check k, i :: a[k] <= a[i])
      <==> sorted(a, 0, integer(n) + 1)

lemma {:rw} sorted_short(a: array<int, int>, lo: int, hi: int)
  requires hi <= lo + 1
  ensures sorted(a, lo, hi) <==> true

goal
  forall a: array<int, int>, s₉: bool, n₄: Nat ::
    !sorted(a, 0, integer(n₄) + 1) && n₄ == zero ==> s₉

