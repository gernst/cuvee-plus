function sorted(a: array<int, int>, lo: int, hi: int): bool

function perm(a: array<int, int>, b: array<int, int>): bool

lemma {:rw} perm_refl(a: array<int, int>)
  ensures perm(a, a) <==> true

lemma {:rw} sorted_gnome(a: array<int, int>, n: int, u: int, d: int, x: int,
                         Kv: Trace<int>, Iv: Trace<int>, Iv2: Trace<int>,
                         Kv2: Trace<int>, Bv: Trace<array<int, int>>,
                         Bv2: Trace<array<int, int>>,
                         G: (int, array<int, int>) -> bool, P: int -> int,
                         Q: int -> int)
  requires
    Bv
      == trace(a, for ⌊Kv⌋, ⌊Iv2⌋
                  do b, k, i ::
                    case G(i, b) => b
                    case !G(i, b) => b[Q(i) := b[P(i)]][P(i) := b[Q(i)]])
  requires Iv2 == Iv
  requires
    Iv2
      == trace(1, for ⌊Kv2⌋, ⌊Bv2⌋
                  do i, k, b ::
                    case G(i, b) => i + u case !G(i, b) => i + d)
  requires Kv2 == Kv
  requires Bv2 == Bv
  requires u == 1
  requires d == -1
  requires
    forall i: int, b: array<int, int> :: G(i, b) <==> i == 0 || b[i - 1] <= b[i]
  requires forall i: int :: P(i) == i - 1
  requires forall i: int :: Q(i) == i
  requires x == current(Iv)
  requires n <= x
  ensures
    sorted(current(trace(a, for ⌊Kv⌋, ⌊Iv⌋
                            do b, k, i ::
                              case G(i, b) => b
                              case !G(i, b) => b[Q(i) := b[P(i)]][
                                P(i) :=
                                b[Q(i)]])), 0, n)
      <==> true

lemma {:rw} perm_gnome(a: array<int, int>, c: array<int, int>, ks: List<int>,
                       is: List<int>, G: (int, array<int, int>) -> bool,
                       P: int -> int, Q: int -> int)
  ensures
    perm(current(trace(a, for ks, is
                          do b, k, i ::
                            case G(i, b) => b
                            case !G(i, b) => b[Q(i) := b[P(i)]][
                              P(i) :=
                              b[Q(i)]])), c)
      <==> perm(a, c)

