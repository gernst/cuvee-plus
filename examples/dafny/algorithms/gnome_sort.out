lemma {:rw} sorted_gnome(a: array<int, int>, ks: List<int>, n: int, x: int,
                         Sv: Trace<(int, array<int, int>)>)
  requires
    Sv
      == trace(1, a,
               for ks
               do i, b, k ::
                 case i == 0 || b[i - 1] <= b[i] => i + 1
                 case !(i == 0 || b[i - 1] <= b[i]) => i - 1,
                 case i == 0 || b[i - 1] <= b[i] => b
                 case !(i == 0 || b[i - 1] <= b[i]) => b[i := b[i - 1]][
                   i - 1 :=
                   b[i]])
  requires x == current(Sv).0
  requires 0 <= n
  requires n <= x
  ensures sorted(current(Sv).1, 0, n) <==> true

lemma {:rw} perm_gnome(a: array<int, int>, c: array<int, int>, ks: List<int>,
                       is: List<int>, G: (int, array<int, int>) -> bool,
                       P: int -> int, Q: int -> int)
  ensures
    perm(current(trace(a, for ks, is
                       do b, k, i ::
                         case G(i, b) => b
                         case !G(i, b) => b[Q(i) := b[P(i)]][P(i) := b[Q(i)]])),
         c)
      <==> perm(a, c)

