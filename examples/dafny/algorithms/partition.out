function perm(a: array<int, int>, b: array<int, int>): bool

function lomuto(a: array<int, int>, p: int, n: Nat,
                is: List<int>): Trace<array<int, int>>

lemma {:rw} lomuto_def(a: array<int, int>, p: int, n: Nat, is: List<int>,
                       js: List<int>)
  ensures
    trace(a, for ⌊counter(0, 1, n)⌋, is, js
             do b, k, i, j ::
               case b[k] < p => b[i := b[k]][k := b[i]] case p <= b[k] => b)
      == lomuto(a, p, n, is)

lemma {:rw} maps_lomuto_read(a: array<int, int>, p: int, n: Nat, is: List<int>,
                             hs: List<int>, P: (int, int, int) -> bool)
  ensures
    maps(for ⌊counter(0, 1, n)⌋, ⌊lomuto(a, p, n, is)⌋, hs
         yield k, b, h ::
           P(b[k], k, h))
      == maps(for ⌊counter(0, 1, n)⌋, hs yield k, h :: P(a[k], k, h))

function below(a: array<int, int>, p: int, n: Nat, hs: List<int>): int

lemma {:rw} below_def(a: array<int, int>, p: int, n: Nat, hs: List<int>)
  ensures
    count(true, maps(for ⌊counter(0, 1, n)⌋, hs yield k, h :: a[k] < p))
      == below(a, p, n, hs)

lemma {:rw} below_nonnegative(a: array<int, int>, p: int, n: Nat, hs: List<int>)
  ensures 0 <= below(a, p, n, hs)

lemma {:rw} below_le(a: array<int, int>, p: int, n: Nat, hs: List<int>)
  ensures below(a, p, n, hs) <= integer(n)

lemma {:rw} current_lomuto_below(a: array<int, int>, p: int, n: Nat,
                                 hs: List<int>, k: int)
  requires 0 <= k
  requires k < below(a, p, n, hs)
  ensures
    current(lomuto(a, p, n, ⌊counts(0, true, maps(for ⌊counter(0, 1, n)⌋, hs
                                                  yield k2, h ::
                                                    a[k2] < p))⌋))[k]
      < p
      <==> true

lemma {:rw} current_lomuto_above(a: array<int, int>, p: int, n: Nat,
                                 hs: List<int>, k: int)
  requires below(a, p, n, hs) <= k
  requires k < integer(n)
  ensures
    p
      <= current(lomuto(a, p, n, ⌊counts(0, true, maps(for ⌊counter(0, 1, n)⌋,
                                                           hs
                                                       yield k2, h ::
                                                         a[k2] < p))⌋))[k]
      <==> true

lemma {:rw} perm_lomuto(a: array<int, int>, c: array<int, int>, p: int, n: Nat,
                        is: List<int>)
  ensures perm(current(lomuto(a, p, n, is)), c) <==> perm(a, c)

lemma {:rw} perm_refl(a: array<int, int>)
  ensures perm(a, a) <==> true

