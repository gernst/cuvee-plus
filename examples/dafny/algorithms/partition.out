function lomuto(a: array<int, int>, p: int, n: Nat,
                is: List<int>): Trace<array<int, int>>

lemma {:rw} lomuto_def(a: array<int, int>, p: int, n: Nat, is: List<int>,
                       js: List<int>)
  ensures
    trace(a, for ⌊counter(0, 1, n)⌋, is, js
          do b, k, i, j ::
            case b[k] < p => b[i := b[k]][k := b[i]] case p <= b[k] => b)
      == lomuto(a, p, n, is)

lemma {:rw} maps_lomuto_read(a: array<int, int>, p: int, n: Nat, is: List<int>,
                             hs: List<int>, P: (int, int, int) -> bool)
  ensures
    maps(for ⌊counter(0, 1, n)⌋, ⌊lomuto(a, p, n, is)⌋, hs
         yield k, b, h ::
           P(b[k], k, h))
      == maps(for ⌊counter(0, 1, n)⌋, hs yield k, h :: P(a[k], k, h))

function {:fold} below(a: array<int, int>, p: int, n: Nat, hs: List<int>): int {
  count(true, maps(for ⌊counter(0, 1, n)⌋, hs yield k, h :: a[k] < p))
}

lemma {:rw} below_nonnegative(a: array<int, int>, p: int, n: Nat, hs: List<int>)
  ensures 0 <= below(a, p, n, hs)

lemma {:rw} below_le_natural(a: array<int, int>, p: int, n: Nat, hs: List<int>,
                             m: int)
  requires n == natural(m)
  requires 0 <= m
  ensures below(a, p, n, hs) <= m <==> true

lemma {:rw} partition_below(a: array<int, int>, p: int, n: Nat, k: int)
  requires 0 <= k
  requires k < below(a, p, n, ⌊counter(0, 1, n)⌋)
  ensures
    current(trace(a, 0, 0,
                  for ⌊counter(0, 1, n)⌋
                  do b, i, j, kk ::
                    case b[j] < p => b[i := b[j]][j := b[i]]
                    case p <= b[j] => b,
                    case b[j] < p => i + 1 case p <= b[j] => i,
                    j + 1)).0[k]
      < p
      <==> true

lemma {:rw} partition_above(a: array<int, int>, p: int, n: Nat, k: int)
  requires below(a, p, n, ⌊counter(0, 1, n)⌋) <= k
  requires k < integer(n)
  ensures
    p
      <= current(trace(a, 0, 0,
                       for ⌊counter(0, 1, n)⌋
                       do b, i, j, kk ::
                         case b[j] < p => b[i := b[j]][j := b[i]]
                         case p <= b[j] => b,
                         case b[j] < p => i + 1 case p <= b[j] => i,
                         j + 1)).0[k]
      <==> true

lemma {:rw} perm_lomuto(a: array<int, int>, c: array<int, int>, p: int, n: Nat,
                        is: List<int>)
  ensures perm(current(lomuto(a, p, n, is)), c) <==> perm(a, c)

