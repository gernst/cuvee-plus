function sorted(a: array<int, int>, lo: int, hi: int): bool

function perm(a: array<int, int>, b: array<int, int>): bool

lemma {:rw} perm_refl(a: array<int, int>)
  ensures perm(a, a) <==> true

function {:fold} bubble_pass(b: array<int, int>,
                             js: List<int>): Trace<array<int, int>> {
  trace(b, for js
        do x, j ::
          case x[j + 1] < x[j] => x[j := x[j + 1]][j + 1 := x[j]]
          case x[j] <= x[j + 1] => x)
}

lemma {:rw} perm_bubble_pass(b: array<int, int>, c: array<int, int>,
                             js: List<int>)
  ensures perm(current(bubble_pass(b, js)), c) <==> perm(b, c)

lemma {:rw} perm_steps_choice(a: array<int, int>, c: array<int, int>,
                              ks: List<int>, ns: List<Nat>,
                              F: (array<int, int>, int, Nat) -> array<int, int>)
  requires forall b: array<int, int>, k: int, nn: Nat :: perm(F(b, k, nn), b)
  ensures
    perm(current(trace(a, for ks, ns do b, k, nn :: F(b, k, nn))), c)
      <==> perm(a, c)

function bubbled(b: array<int, int>, k: int, len: int): bool

lemma {:rw} bubbled_pass_nat(b: array<int, int>, nn: Nat, k: int, len: int)
  requires integer(nn) == len - k - 1
  requires bubbled(b, k, len)
  ensures
    bubbled(current(bubble_pass(b, ⌊counter(0, 1, nn)⌋)), k + 1, len) <==> true

lemma {:rw} sorted_bubbled_steps_choice(a: array<int, int>, len: int, m: Nat,
                                        ns: List<Nat>,
                                        F: (array<int, int>, int, Nat) -> array<int, int>)
  requires len <= integer(m) + 1
  requires
    maps(for ⌊counter(0, 1, m)⌋, ns yield k, nn :: integer(nn) + k + 1)
      == ⌊consts(m, len)⌋
  requires
    forall b: array<int, int>, k: int, nn: Nat ::
      0 <= k < integer(m) && integer(nn) + k + 1 == len && bubbled(b, k, len)
        ==> bubbled(F(b, k, nn), k + 1, len)
  ensures
    sorted(current(trace(a, for ⌊counter(0, 1, m)⌋, ns
                         do b, k, nn ::
                           F(b, k, nn))), 0, len)
      <==> true

