function sorted(a: array<int, int>, lo: int, hi: int): bool

lemma {:rw} sorted_merge(a: array<int, int>, m: int, b: array<int, int>, n: int,
                         c0: array<int, int>, nn: Nat, s: int, Kv: Trace<int>,
                         Sv: Trace<(int, int)>, Cv: Trace<array<int, int>>)
  requires
    Cv
      == trace(c0, for ⌊Kv⌋, ⌊Sv⌋.0, ⌊Sv⌋.1
               do c, k, i, j ::
                 case n <= j || i < m && a[i] <= b[j] => c[k := a[i]]
                 case !(n <= j || i < m && a[i] <= b[j]) => c[k := b[j]])
  requires
    Sv
      == trace(0, 0,
               for ⌊Kv⌋
               do i, j, k ::
                 case n <= j || i < m && a[i] <= b[j] => i + 1
                 case !(n <= j || i < m && a[i] <= b[j]) => i,
                 case n <= j || i < m && a[i] <= b[j] => j
                 case !(n <= j || i < m && a[i] <= b[j]) => j + 1)
  requires Kv == counter(0, 1, nn)
  requires s == m + n
  requires m + n <= integer(nn)
  requires 0 <= m
  requires 0 <= n
  requires sorted(a, 0, m)
  requires sorted(b, 0, n)
  ensures sorted(current(Cv), 0, s) <==> true

function merged(a: array<int, int>, m: int, b: array<int, int>,
                n: int): List<int>

lemma {:rw} selects_merge(a: array<int, int>, m: int, b: array<int, int>,
                          n: int, c0: array<int, int>, nn: Nat, s: int,
                          Kv: Trace<int>, Sv: Trace<(int, int)>,
                          Cv: Trace<array<int, int>>)
  requires
    Cv
      == trace(c0, for ⌊Kv⌋, ⌊Sv⌋.0, ⌊Sv⌋.1
               do c, k, i, j ::
                 case n <= j || i < m && a[i] <= b[j] => c[k := a[i]]
                 case !(n <= j || i < m && a[i] <= b[j]) => c[k := b[j]])
  requires
    Sv
      == trace(0, 0,
               for ⌊Kv⌋
               do i, j, k ::
                 case n <= j || i < m && a[i] <= b[j] => i + 1
                 case !(n <= j || i < m && a[i] <= b[j]) => i,
                 case n <= j || i < m && a[i] <= b[j] => j
                 case !(n <= j || i < m && a[i] <= b[j]) => j + 1)
  requires Kv == counter(0, 1, nn)
  requires s == m + n
  requires m + n <= integer(nn)
  requires 0 <= m
  requires 0 <= n
  ensures
    selects(current(Cv), ⌊counter(0, 1, natural(s))⌋) == merged(a, m, b, n)

lemma {:rw} count_merged(a: array<int, int>, m: int, b: array<int, int>, n: int,
                         x: int)
  requires 0 <= m
  requires 0 <= n
  ensures
    count(x, merged(a, m, b, n))
      == count(x, selects(a, ⌊counter(0, 1, natural(m))⌋))
        + count(x, selects(b, ⌊counter(0, 1, natural(n))⌋))

