function sorted(a: array<int, int>, lo: int, hi: int): bool

lemma {:rw} sorted_merge_loop(a: array<int, int>, m: int, b: array<int, int>,
                              n: int, c0: array<int, int>, nn: Nat,
                              is: List<int>, js: List<int>, s: int,
                              G: (int, int) -> bool, U: (int, int) -> int,
                              V: (int, int) -> int, Iv: Trace<int>,
                              Jv: Trace<int>)
  requires s == m + n
  requires m + n <= integer(nn)
  requires 0 <= m
  requires 0 <= n
  requires sorted(a, 0, m)
  requires sorted(b, 0, n)
  requires forall i: int, j: int :: G(i, j) <==> n <= j || i < m && a[i] <= b[j]
  requires forall i: int, j: int :: U(i, j) == a[i]
  requires forall i: int, j: int :: V(i, j) == b[j]
  requires
    Iv
      == trace(0, for ⌊counter(0, 1, nn)⌋, js
                  do i, k, j ::
                    case G(i, j) => i + 1 case !G(i, j) => i)
  requires is == ⌊Iv⌋
  requires
    Jv
      == trace(0, for ⌊counter(0, 1, nn)⌋, is
                  do j, k, i ::
                    case G(i, j) => j case !G(i, j) => j + 1)
  requires js == ⌊Jv⌋
  ensures
    sorted(current(trace(c0, for ⌊counter(0, 1, nn)⌋, is, js
                             do c, k, i, j ::
                               case G(i, j) => c[k := U(i, j)]
                               case !G(i, j) => c[k := V(i, j)])), 0, s)
      <==> true

function merged(a: array<int, int>, m: int, b: array<int, int>,
                n: int): List<int>

lemma {:rw} selects_merge_loop(a: array<int, int>, m: int, b: array<int, int>,
                               n: int, c0: array<int, int>, nn: Nat,
                               is: List<int>, js: List<int>, s: int,
                               G: (int, int) -> bool, U: (int, int) -> int,
                               V: (int, int) -> int, Iv: Trace<int>,
                               Jv: Trace<int>)
  requires s == m + n
  requires m + n <= integer(nn)
  requires 0 <= m
  requires 0 <= n
  requires forall i: int, j: int :: G(i, j) <==> n <= j || i < m && a[i] <= b[j]
  requires forall i: int, j: int :: U(i, j) == a[i]
  requires forall i: int, j: int :: V(i, j) == b[j]
  requires
    Iv
      == trace(0, for ⌊counter(0, 1, nn)⌋, js
                  do i, k, j ::
                    case G(i, j) => i + 1 case !G(i, j) => i)
  requires is == ⌊Iv⌋
  requires
    Jv
      == trace(0, for ⌊counter(0, 1, nn)⌋, is
                  do j, k, i ::
                    case G(i, j) => j case !G(i, j) => j + 1)
  requires js == ⌊Jv⌋
  ensures
    selects(current(trace(c0, for ⌊counter(0, 1, nn)⌋, is, js
                              do c, k, i, j ::
                                case G(i, j) => c[k := U(i, j)]
                                case !G(i, j) => c[k := V(i, j)])), ⌊counter(0,
                                                                             1,
                                                                             natural(s))⌋)
      == merged(a, m, b, n)

lemma {:rw} count_merged(a: array<int, int>, m: int, b: array<int, int>, n: int,
                         x: int)
  requires 0 <= m
  requires 0 <= n
  ensures
    count(x, merged(a, m, b, n))
      == count(x, selects(a, ⌊counter(0, 1, natural(m))⌋))
        + count(x, selects(b, ⌊counter(0, 1, natural(n))⌋))

