function argmin(b: array<int, int>, lo: int, hi: int): int

lemma {:rw} current_selection(b: array<int, int>, i: int, nn: Nat)
  ensures
    current(trace(i, for ⌊counter(0, 1, nn)⌋, ⌊counter(i + 1, 1, nn)⌋
                  do m, k, j ::
                    case b[j] < b[m] => j case b[m] <= b[j] => m))
      == argmin(b, i, i + 1 + integer(nn))

lemma {:rw} sorted_swap_argmin_nat(b: array<int, int>, i: int, nn: Nat, n: int)
  requires partitioned(b, 0, i, n)
  requires i < n
  requires n <= integer(nn) + i + 1
  requires nn == zero || i + 1 < n && integer(nn) + i < n
  requires sorted(b, 0, i)
  ensures
    sorted(b[i := b[argmin(b, i, i + 1 + integer(nn))]][
             argmin(b, i, i + 1 + integer(nn)) :=
             b[i]], 0, i + 1)
      <==> true

lemma {:rw} partitioned_swap_argmin_nat(b: array<int, int>, i: int, nn: Nat,
                                        n: int)
  requires partitioned(b, 0, i, n)
  requires i < n
  requires n <= integer(nn) + i + 1
  requires nn == zero || i + 1 < n && integer(nn) + i < n
  requires sorted(b, 0, i)
  ensures
    partitioned(b[i := b[argmin(b, i, i + 1 + integer(nn))]][
                  argmin(b, i, i + 1 + integer(nn)) :=
                  b[i]], 0, i + 1, n)
      <==> true

lemma {:rw} sorted_selection_steps(a: array<int, int>, n: int, m: Nat,
                                   ns: List<Nat>, ks: List<int>, is: List<int>,
                                   ns2: List<Nat>, ks3: List<int>,
                                   is3: List<int>, ns3: List<Nat>,
                                   F: (array<int, int>, int, Nat) -> array<int, int>)
  requires n == integer(m)
  requires invs(for ks, is, ns2 check k, i, nn :: n <= integer(nn) + i + 1)
  requires is == ⌊counter(0, 1, m)⌋
  requires ns2 == ns
  requires
    invs(for ks3, is3, ns3
         check k, i, nn ::
           nn == zero || i + 1 < n && integer(nn) + i < n)
  requires is3 == ⌊counter(0, 1, m)⌋
  requires ns3 == ns
  requires
    forall b: array<int, int>, i: int, nn: Nat ::
      0 <= i < n <= integer(nn) + i + 1
        && (nn == zero || i + 1 < n && integer(nn) + i < n)
        && sorted(b, 0, i)
        && partitioned(b, 0, i, n)
        ==> sorted(F(b, i, nn), 0, i + 1)
          && partitioned(F(b, i, nn), 0, i + 1, n)
  ensures
    sorted(current(trace(a, for ⌊counter(0, 1, m)⌋, ns, ⌊counter(0, 1, m)⌋
                         do b, k, nn, i ::
                           F(b, i, nn))), 0, n)
      <==> true

lemma {:rw} perm_swap_any(x: array<int, int>, p: int, q: int)
  ensures perm(x[p := x[q]][q := x[p]], x) <==> true

lemma {:rw} perm_steps_choice(a: array<int, int>, c: array<int, int>,
                              ks: List<int>, ns: List<Nat>, is: List<int>,
                              F: (array<int, int>, int, Nat) -> array<int, int>)
  requires forall b: array<int, int>, i: int, nn: Nat :: perm(F(b, i, nn), b)
  ensures
    perm(current(trace(a, for ks, ns, is do b, k, nn, i :: F(b, i, nn))), c)
      <==> perm(a, c)

