function sorted(a: array<int, int>, lo: int, hi: int): bool

goal
  forall a: array<int, int>, n: int, x: int, lo₁₂: int, hi₁₃: int, n₆: Nat,
         K₈: Trace<int>, S₉: Trace<(int, int)> ::
    0 <= n
      && sorted(a, 0, n)
      && K₈ == counter(0, 1, n₆)
      && S₉
        == trace(0, n,
                 for ⌊K₈⌋
                 do lo₄, hi₅, k₇ ::
                   case a[(hi₅ + lo₄) / 2] < x => (hi₅ + lo₄) / 2 + 1
                   case x <= a[(hi₅ + lo₄) / 2] => lo₄,
                   case a[(hi₅ + lo₄) / 2] < x => hi₅
                   case x <= a[(hi₅ + lo₄) / 2] => (hi₅ + lo₄) / 2)
      && lo₁₂ == current(S₉).0
      && hi₁₃ == current(S₉).1
      && invs(for ⌊K₈⌋, ⌊S₉⌋.0, ⌊S₉⌋.1 check k₇, lo₄, hi₅ :: lo₄ < hi₅)
      && 0 <= integer(n₆)
      && hi₁₃ <= lo₁₂
      ==> 0 <= lo₁₂ <= n
        && (forall k: int :: 0 <= k < lo₁₂ ==> a[k] < x)
        && (forall k: int :: lo₁₂ <= k < n ==> x <= a[k])

