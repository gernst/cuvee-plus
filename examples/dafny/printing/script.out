logic LIA

option {:produce-witnesses true}

info {:format-version "1.0"}

option {:produce-witnesses}

var g: int

method {:tag "main"} main(n: int) returns (result: int)
  modifies g
{
  var i: int;
  i := 0;
  while {:tag "loop"} i < n {
    i := i + 1;
    g := g + 1;
  }
  while {:tag "loop"} 0 < i {
    i := i - 1;
  }
  result := 0;
  return;
}

annotate "loop" {:modifies g} {:invariant 0 <= i}

push 1

verify main(3)

pop 1

witness

