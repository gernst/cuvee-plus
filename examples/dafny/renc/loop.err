            !(x₁ + -1 * `x!4` >= 0),
            !(x₀ + -1 * `x!7` <= 0),
            !(2 * x₀ + -2 * `x!7` + -2 * `x!4` + `x!5` <= -1),
            !(`x!7` + -1 * `x!4` >= 1),
            !(x₁ + -1 * `x!4` <= 0),
            !(2 * `x!4` + -1 * `x!5` <= -1);
            `a!1`
              && `a!2`
              && `a!3`
              && `a!4`
              && (!`x!6` || `a!5`)
              && (`a!6` || `a!7`)
              && (`x!4` != x₁ || `a!8` || `a!9`)
              && (`x!6` || `a!10` || `a!11`)
              && (!`x!6` || `a!12`)
              && x₃ == 1 + `x!10`
              && x₀ <= `x!7`
              && `x!4` != x₁
              && `x!9` == `x!8`;
          `a!1` || `a!2` || `a!3`)
}
