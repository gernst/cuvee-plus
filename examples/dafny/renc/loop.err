                      x₂₂: int, x₂₃: int, x₂₄: int, x₂₅: int, x₂₆: bool,
                      x₂₇: int, x₂₈: bool, x₂₉: bool, x₃₀: int): bool {
  var `a!1`: bool,
  `a!2`: bool,
  `a!3`: bool,
  `a!4`: bool,
  `a!5`: bool,
  `a!6`: bool,
  `a!7`: bool,
  `a!8`: bool,
  `a!9`: bool,
  `a!10`: bool := !(x₁ + -1 * x₁₈ <= -1),
  !(2 * x₁ + -1 * x₁₅ >= 1),
  !(2 * x₁ + -1 * x₁₉ <= -1),
  !(x₁ + -1 * x₁₈ >= 0),
  !(x₀ + -1 * x₁ <= 0),
  !(x₈ + -1 * x₁₈ >= 1),
  !(x₁₄ + -1 * x₁₈ <= -1),
  !(2 * x₁ + -1 * x₁₅ <= -1),
  !(x₁ + -1 * x₈ <= 0),
  !(2 * x₁ + -1 * x₁₉ >= 1);
  (x₁ != x₁₄ || `a!1` || `a!2`)
    && (`a!3` || `a!4`)
    && `a!5`
    && `a!6`
    && (x₁₆ || `a!7` || x₁ != x₁₄)
    && (`a!8` || `a!1` || x₁ != x₁₄)
    && (`a!9` || `a!10`)
}
