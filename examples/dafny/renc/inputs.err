    if (if `x!21` == x₀ then x₀ else `x!21`) == x₁
    then x₃
    else if `x!21` == x₀ then x₂ else `x!22`;
    x₀ == `a!1`
      && x₀ != x₁
      && `a!2`
      && x₇ == `a!3`
      && x₅ == 1
      && x₆ == x₀
      && x₈
      && x₁₁ == x₀
      && x₁₂ == x₇
      && x₁₃
      && x₁₄ == x₀
      && x₁₅ == x₀
      && x₁₆ == x₁
      && x₁₇ == x₂
      && x₁₈ == x₃
      && x₁₉ == x₉
      && x₂₀ == x₇,
  exists `x!21`: int, `x!22`: int ::
    var `a!1`: int,
    `a!2`: int,
    `a!3`: bool := if (if `x!21` == x₀ then x₀ else `x!21`) == x₁
    then x₁
    else if `x!21` == x₀ then x₀ else `x!21`,
    if (if `x!21` == x₀ then x₀ else `x!21`) == x₁
    then x₃
    else if `x!21` == x₀ then x₂ else `x!22`,
    `x!21` == x₀ || (if `x!21` == x₀ then x₀ else `x!21`) == x₁;
    x₀ != x₁
      && x₆ == `a!1`
      && x₇ == `a!2`
      && x₈ == `a!3`
      && x₅ == 1
      && x₁₁ == x₆
      && x₁₂ == x₇
      && x₈
      && x₁₁ == x₀
      && x₁₅ == x₀
      && x₁₆ == x₁
      && x₁₇ == x₂
      && x₁₈ == x₃
      && x₁₉ == x₉;
  `a!1` || `a!2` && x₁₃ && x₁₄ == x₁₁ && x₂₀ == x₁₂
}

function main_block_3(x₀: int, x₁: int, x₂: int, x₃: int, x₄: int, x₅: int,
                      x₆: int, x₇: int, x₈: bool, x₉: int, x₁₀: int, x₁₁: int,
                      x₁₂: bool): bool {
  x₀ != x₁ && x₅ == 0 && !x₁₂
}
