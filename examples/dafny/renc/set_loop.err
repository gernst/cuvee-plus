      && x₁₅ == x₁
      && x₁₆ == x₇,
  exists `x!19`: int ::
    var `a!1`: bool,
    `a!2`: bool := !(2 * x₁₅ + -2 * x₁₆ <= -1),
    !(2 * x₁₄ + -2 * x₁₅ <= 1);
    (x₁₈ || `a!1`) && `a!2` && x₃ == 1 + `x!19` && x₁₄ <= x₁₆,
  exists `x!19`: int ::
    var `a!1`: bool,
    `a!2`: bool,
    `a!4`: bool,
    `a!5`: bool := x₁ + -1 * (x₄ / 2) <= 0,
    !(x₄ + -2 * x₇ <= -1),
    x₁ + -1 * (x₄ / 2) >= 0,
    !(2 * x₀ + -1 * x₄ <= 1);
    var `a!3`: bool,
    `a!6`: bool := x₅ || x₄ % 2 != 0 || !`a!1` || `a!2`,
    !`a!4` || x₄ % 2 != 0 || `a!5`;
    `a!3`
      && `a!6`
      && x₄ != x₁₃
      && x₃ == 1 + `x!19`
      && x₀ <= x₇
      && x₁₃ == 2 * x₁
      && x₁₀ == x₄
      && x₁₁ == x₅
      && x₁₂ == x₆
      && x₁₄ == x₀
      && x₁₅ == x₁
      && x₁₆ == x₇
      && x₁₇ == x₈;
  `a!1` || `a!2` && `a!3`
}

function main_exit_13(x₀: int, x₁: int, x₂: int, x₃: int, x₄: int, x₅: bool,
                      x₆: int, x₇: int, x₈: bool): bool {
  var `a!1`: bool,
  `a!2`: bool,
  `a!4`: bool,
  `a!5`: bool := x₁ + -1 * (x₄ / 2) <= 0,
  !(x₄ + -2 * x₇ <= -1),
  !(2 * x₀ + -1 * x₄ <= 1),
  x₁ + -1 * (x₄ / 2) >= 0;
  var `a!3`: bool,
  `a!6`: bool := x₅ || !`a!1` || `a!2` || x₄ % 2 != 0,
  `a!4` || !`a!5` || x₄ % 2 != 0;
  `a!3` && `a!6` && x₀ <= x₇
}
