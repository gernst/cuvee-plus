  !(x₀ + -1 * x₁₈ <= -1),
  !(x₀ + -1 * x₁₈ >= 1),
  !(x₁₅ + -1 * x₁₈ <= -1);
  `a!1` && `a!2` && `a!3` && `a!4`
}

function main_assign_29(x₀: int, x₁: int, x₂: int, x₃: int, x₄: int, x₅: bool,
                        x₆: int, x₇: int, x₈: int): bool {
  var `a!1`: bool,
  `a!2`: bool,
  `a!3`: bool := exists `x!9`: int, `x!10`: int ::
    var `a!1`: bool := !(x₀ + -1 * `x!10` <= -1);
    !(`x!10` >= 1)
      && !(`x!9` >= 1)
      && !(`x!9` <= -1)
      && `a!1`
      && !(`x!10` <= -1)
      && x₃ != `x!9`
      && x₆ == x₂
      && x₇ == 0,
  !(x₀ + -1 * x₄ <= -1),
  exists `x!9`: int, `x!10`: int ::
    var `a!1`: bool := !(x₀ + -1 * `x!10` <= -1);
    !(`x!10` >= 1)
      && !(`x!9` >= 1)
      && !(`x!9` <= -1)
      && `a!1`
      && !(`x!10` <= -1)
      && x₃ != `x!9`
      && x₆ == x₂;
  var `a!4`: bool := !(x₄ >= 1)
    && !(x₃ >= 1)
    && !(x₃ <= -1)
    && `a!2`
    && !(x₄ <= -1)
    && x₅
    && x₆ == x₂
    || `a!3`;
  `a!1`
    || !(x₄ >= 1)
      && !(x₃ >= 1)
      && !(x₃ <= -1)
      && `a!2`
      && !(x₄ <= -1)
      && x₅
      && x₆ == x₂
      && x₇ == 0
    || `a!4` && x₇ == 0
}
