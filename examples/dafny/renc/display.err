function `Map_R<Int,Int>`(x₀: int, x₁: int, x₂: int): bool {
  var `a!1`: bool := exists `x!3`: int, `x!4`: int, `x!5`: bool, `x!6`: int,
                            `x!7`: int, `x!8`: int, `x!9`: bool, `x!10`: int ::
    x₁ == 1
      && `x!3` != 1
      && !`x!5`
      && `x!7` == `x!3`
      && `x!8` == `x!4`
      && `x!7` == 1
      && x₀ == `x!6`
      && !`x!9`
      && `x!10` == `x!7`
      || x₁ == 1
        && `x!3` == 1
        && `x!4` == 10
        && `x!5`
        && `x!7` == 1
        && `x!8` == 10
        && x₀ == `x!6`
        && `x!9`
        && `x!10` == `x!7`
        && x₂ == `x!8`
      || x₁ == 1
        && `x!3` == 1
        && `x!4` == 10
        && `x!5`
        && `x!7` == 1
        && `x!8` == 10
        && `x!9`
        && `x!10` == 1
        && x₀ == `x!6`
        && x₂ == 10;
  x₂ == 10 && x₁ == 1 || `a!1`
}
