    var `a!2`: bool := !(x₁₄ >= 11)
      && !(`x!17` <= 2)
      && (!(x₁₀ <= 19) || x₉ != x₁₃)
      && (`a!1` || x₁₁)
      && !(x₆ <= 9)
      && (x₉ != x₁₃ || !(x₁₀ >= 21))
      && (!(x₁₄ <= 10) || !(x₆ >= 11));
    (`a!2` || `a!3`) && x₁ == 1 + `x!17`,
  exists `x!17`: int ::
    var `a!1`: bool,
    `a!3`: bool,
    `a!4`: bool := x₁₃ + -1 * x₉ != 0,
    exists `x!18`: int ::
      !(x₆ >= 11)
        && !(`x!18` <= 1)
        && !(`x!18` >= 3)
        && x₄
        && !(x₂ >= 2)
        && (x₄ || x₂ != 2)
        && (!(x₃ <= 19) || x₂ != 2)
        && !(x₆ <= 9)
        && (x₂ != 2 || !(x₃ >= 21))
        && `x!17` == 1 + `x!18`,
    exists `x!18`: int, `x!19`: int, `x!20`: bool, `x!21`: int ::
      var `a!1`: bool := exists `x!22`: int ::
        !(`x!19` >= 11)
          && !(`x!22` <= 1)
          && !(`x!22` >= 3)
          && x₄
          && !(x₂ >= 2)
          && (x₄ || x₂ != 2)
          && (!(x₃ <= 19) || x₂ != 2)
          && !(`x!19` <= 9)
          && (x₂ != 2 || !(x₃ >= 21))
          && `x!17` == 1 + `x!22`
          && `x!20`
          && `x!21` == `x!18`
          && x₆ == `x!19`;
      `a!1`
        && x₉ == x₂
        && x₁₀ == x₃
        && x₁₁ == x₄
        && x₁₂ == x₅
        && x₁₃ == 2
        && x₁₄ == x₆
        && x₁₅ == x₇;
    var `a!2`: bool := !(x₁₄ >= 11)
      && !(`x!17` <= 2)
      && (!(x₁₀ <= 19) || x₉ != x₁₃)
      && (x₁₁ || `a!1`)
      && !(x₆ <= 9)
      && (x₉ != x₁₃ || !(x₁₀ >= 21))
      && (!(x₁₄ <= 10) || !(x₆ >= 11));
    (`a!2`
       || `a!3`
         && x₉ == x₂
         && x₁₀ == x₃
         && x₁₁ == x₄
         && x₁₂ == x₅
         && x₁₃ == 2
         && x₁₄ == x₆
         && x₁₅ == x₇
       || `a!4`)
      && x₁ == 1 + `x!17`;
  `a!1` || `a!2`
}
