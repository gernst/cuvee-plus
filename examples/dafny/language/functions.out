const inc: int -> int := (x: int) => x + 1

const add: (int, int) -> int := (x: int, y: int) => x + y

const constant: (int -> int) -> int -> int := (f: int -> int) => (x: int) => x

const first: ((int, bool)) -> (int, bool) := (p: (int, bool)) => p

lemma inc_1()
  ensures inc == ((y: int) => y + 1)
{}

function twice(f: int -> int, x: int): int {
  f(f(x))
}

const three: int := add(1, inc(1))

function g(x: int): int {
  x
}

function shadow(g: int -> int): int {
  g(1)
}

