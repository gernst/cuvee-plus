type Trace<a₀>

function counter(x₀: int, x₁: int, x₂: int): Trace<int>

function steps(xs: seq<int>): int

function p(t: Trace<int>): bool

const J: Trace<int>

const n: int

const W: seq<int>

const done: bool

function r(x: int, y: int): bool

function either(a: bool, b: bool): bool

function fold(i: int, xs: seq<int>, f: (int, int) -> int): Trace<int>

lemma {:rw}
  forall Xs: seq<int>, P: int -> bool, Q: int -> bool ::
    invs(for Xs check x :: P(x) || Q(x))
      == either(invs(for Xs check x :: P(x)), invs(for Xs check x :: Q(x)))

lemma {:rw}
  forall Xs: seq<int>, F: int -> int ::
    invs(for Xs check x :: r(F(x), F(x))) == done

lemma {:rw}
  forall i: int, Xs: seq<int>, F: (int, int) -> int ::
    trace(i, for Xs do x, v :: F(x, v)) == fold(i, Xs, F)

axiom either(invs(for ⌊J⌋ check x :: x < n), invs(for ⌊J⌋ check x :: 0 <= x))

axiom invs(for ⌊J⌋, W check j, w :: j < n || w < j)

axiom done

axiom invs(for ⌊J⌋ check j :: r(j + 1, j + 2))

axiom p(fold(0, ⌊J⌋, (s: int, j: int) => j * s + 1))

