type Trace<a₀>

type List<a₀>

type Nat

function counter(x₀: int, x₁: int, x₂: Nat): Trace<int>

function earlier<a₀>(x₀: Nat, x₁: List<a₀>): a₀

function integer(x₀: Nat): int

function natural(x₀: int): Nat

function p(s: List<int>): bool

const J: List<int>

const K: List<int>

const n: Nat

const b: bool

const c: bool

axiom p(maps(for J yield j :: j))

axiom p(maps(for ⌊counter(0, 1, n)⌋, J yield k, j :: j))

axiom invs(for J check j :: integer(n) < 2 * j)

axiom invs(for K check k :: 0 < k) && invs(for J check j :: 0 < j)

axiom p(maps(for ⌊counter(0, 1, n)⌋, J yield k, j :: j))

axiom invs(for J check j :: 0 <= j)

axiom p(maps(for J yield j :: case b => j case c => j + 1))

