type Trace<a₀>

function counter(x₀: int, x₁: int, x₂: int): Trace<int>

function steps(xs: seq<int>): int

function p(t: Trace<int>): bool

const J: Trace<int>

const n: int

function r(x: int, y: int): bool

function le(x: int, y: int): bool

lemma {:rw}
  forall len: int, K: Trace<int> ::
    invs(for ⌊K⌋ check k :: k < len) == le(steps(⌊K⌋), len)

lemma {:rw}
  forall c: int, K: Trace<int> :: invs(for ⌊K⌋ check k :: r(c, k)) == true

axiom le(steps(⌊J⌋), n)

axiom invs(for ⌊J⌋ check j :: r(j, j))

