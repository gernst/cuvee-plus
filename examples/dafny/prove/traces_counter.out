type Trace<a₀>

type List<a₀>

function counter(x₀: int, x₁: int, x₂: int): Trace<int>

function steps(xs: List<int>): int

function p(t: Trace<int>): bool

const J: Trace<int>

const n: int

lemma {:rw} trace_1(i: int, c: int, K: Trace<int>)
  ensures trace(i, for ⌊K⌋ do x, k :: x + c) == counter(i, c, steps(⌊K⌋))
{}

axiom p(counter(0, 1, steps(⌊J⌋)))

axiom J == counter(0, 1, n) ==> p(counter(0, 1, steps(⌊J⌋)))

axiom
  J == counter(0, 1, n)
    ==> p(trace(0, for ⌊J⌋ do s, j :: case j < 5 => s + 1 case 5 <= j => s + 2))

