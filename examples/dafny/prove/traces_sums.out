type Trace<a₀>

type List<a₀>

function counter(x₀: int, x₁: int, x₂: int): Trace<int>

function steps(xs: List<int>): int

function p(t: Trace<int>): bool

const J: Trace<int>

const n: int

function sums(i: int, V: List<int>): Trace<int>

const W: List<int>

const arr: array<int, int>

lemma {:rw} trace_1(i: int, V: List<int>)
  ensures trace(i, for V do x, v :: x + v) == sums(i, V)
{}

axiom J == counter(0, 1, n) ==> p(sums(0, maps(for ⌊J⌋ yield j :: arr[j])))

axiom J == counter(0, 1, n) ==> p(sums(0, W))

axiom J == counter(0, 1, n) ==> p(trace(0, for ⌊J⌋ do s, j :: j * s + s))

