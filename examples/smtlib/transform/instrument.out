(declare-fun twice (Int) Int)

(define-fun double ((x Int)) Int (* 2 x))

(declare-fun some (Int Int) Int)

(declare-proc
  between
  ((lo Int) (hi Int))
  ((x Int))
  :implement
  (some lo hi)
  :requires
  (<= lo hi)
  :ensures
  (and (<= lo x) (<= x hi)))

(declare-fun other (Int) Int)

(define-proc
  main
  ((n Int))
  ((r Int))
  ()
  (sequence
    (assign (r (double n)))
    (block
      (locals (test$1 Int) (test$2 Int))
      (call between (0 r) (test$1))
      (block
        (locals (y$3 Int) (z$4 Int))
        (assign (y$3 r))
        (sequence
          (assign (z$4 (+ y$3 1))))
        (assign (test$2 z$4)))
      (assign
        (r (+ test$1 test$2))))))

