; bitvectors of fixed width, whose functions are instantiated for the widths of their arguments
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(declare-const a (Array Int (_ BitVec 8)))
(assert (= (bvadd x #x01) (bvsub y #b00000001)))
(assert (bvult x (select a 0)))
(assert (= ((_ extract 3 0) (concat x y)) ((_ extract 3 0) y)))
(assert (= ((_ zero_extend 8) x) (concat #x00 x)))
(assert (= (_ bv5 8) (bvand x (bvnot y))))
(check-sat)
