method m(x: int, y: int) returns (a: int, b: int) {
  a, b := y, x;
  assume a < b;
  a, b := *, *;
  spec a requires 0 < a ensures a < b;
  if * {
    a := 0;
  } else {
    a := y;
  }
  while true {
    if x < y {
      break;
    } else if y < x {
      continue;
    }
  }
  while *
    invariant a <= y
  {
    a := y;
  }
}

