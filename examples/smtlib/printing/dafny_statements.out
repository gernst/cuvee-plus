function {:smt2} {:c} const<a₀, a₁>(x₀: a₁): array<a₀, a₁>

method m(x: int, y: int) returns (a: int, b: int) {
  a, b := y, x;
  assume a < b;
  havoc a, b;
  spec a requires 0 < a ensures a < b;
  if * {
    a := 0;
  } else {
    a := y;
  }
  while true {
    if x < y {
      break;
    } else if y < x {
      continue;
    }
  }
  while *
    invariant a <= y
  {
    a := y;
  }
}

