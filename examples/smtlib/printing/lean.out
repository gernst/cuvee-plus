-- logic ALL

axiom U : Type

inductive Stack (α : Type) where
  | nil : Stack α
  | cons (top : α) (pop : Stack α) : Stack α

open Stack

axiom top {α : Type} : Stack α → α

axiom top_cons {α : Type} (x₀ : α) (x₁ : Stack α) : top (cons x₀ x₁) = x₀

axiom pop {α : Type} : Stack α → Stack α

axiom pop_cons {α : Type} (x₀ : α) (x₁ : Stack α) : pop (cons x₀ x₁) = x₁

axiom c : U

noncomputable def max (x : Int) (y : Int) : Int :=
  if x < y then y else x

axiom shift (x : Int) : let (x, y) : Int × Int := (x + 1, x); y < x

axiom ax_cf106bf4 :
  (0 : Int) < 1
    ∧ (2.5 : ℝ) = 0.25
    ∧ (1 : Int) ≠ 2 ∧ (1 : Int) ≠ 3 ∧ (2 : Int) ≠ 3

axiom ax_fe79d428 : top (cons c nil) = c

