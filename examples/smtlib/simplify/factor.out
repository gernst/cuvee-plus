(declare-const a Bool)

(declare-const b Bool)

(declare-const c Bool)

(declare-const d Bool)

(define-fun f1 () Bool (or a (and c b)))

(define-fun f2 () Bool (and a (or c b)))

(define-fun f3 () Bool (or a c))

(define-fun
  f4
  ()
  Bool
  (and (or a b) (or c d)))

(define-fun f5 () Bool (and a b))

