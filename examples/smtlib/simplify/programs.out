(define-proc
  skip1
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence (assign (y 0))))

(define-proc skip2 ((p Bool)) ((x Int) (y Int)) () (sequence))

(define-proc skip3 ((p Bool)) ((x Int) (y Int)) () (sequence))

(define-proc
  blocks1
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence (assign (x (+ x 1))) (assign (x 0))))

(define-proc
  blocks2
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence (assign (x (+ x 1)))))

(define-proc
  blocks3
  ((p Bool))
  ((x Int) (y Int))
  ((z Int))
  (sequence (assign (z x)) (assign (x z))))

(define-proc
  blocks4
  ((p Bool))
  ((x Int) (y Int))
  ((z Int))
  (sequence
    (block (locals (z Int)) (assign (z x)))
    (assign (x z))))

(define-proc
  blocks5
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence (assign (x (+ x 1))) (assign (x 0))))

(define-proc
  jumps
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence
    (while
      true
      (sequence (assign (x (+ x 1))) (break)))))

(define-proc
  if1
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence (assign (x (+ x 1)))))

(define-proc
  if2
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence (assign (x 0))))

(define-proc
  if3
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence (assign (x (+ x 1)))))

(define-proc
  if4
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence
    (if p (assign (x 0)) (assign (x (+ x 1))))))

(define-proc while ((p Bool)) ((x Int) (y Int)) () (sequence))

(define-proc
  choice1
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence
    (choice (assign (x (+ x 1))) (assign (x 0)))))

(define-proc
  choice2
  ((p Bool))
  ((x Int) (y Int))
  ()
  (sequence (assign (x (+ x 1)))))

