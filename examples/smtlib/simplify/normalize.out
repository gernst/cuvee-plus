(declare-fun p (Int) Bool)

(declare-fun q (Int Int) Bool)

(declare-const r Bool)

(assert
  (forall
    ((x Int) (y Int))
    (=> (and (q x y) (p x)) r)))

(assert
  (forall
    ((x Int))
    (=> (p x) (or (q x x) r))))

(assert
  (forall ((x Int)) (not (and r (p x)))))

(assert
  (forall
    ((y Int) (x$1 Int))
    (=>
      (and (= (+ y 1) x$1) (p y))
      (q x$1 x$1))))

