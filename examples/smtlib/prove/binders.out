(declare-fun p (Int) Bool)

(assert
  (forall
    ((y Int))
    (exists
      ((x$1 Int))
      (and (= x$1 y) (p x$1)))))

(assert false)

(assert
  (forall ((x$3 Int)) (p x$3)))

(assert
  (forall ((x$4 Int)) (p x$4)))

(assert
  (forall
    ((x Int))
    (=>
      (p x)
      (exists ((z Int)) (and (p z) (< x z))))))

