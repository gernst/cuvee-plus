; ./Cuvee.sh -prove examples/smtlib/prove/rewrite_arithmetic.smt2
; sums match modulo associativity, commutativity, and the neutral element 0, where the last variable takes
; the rest of the summands, a negated variable takes negative summands only, and comparisons match modulo moving
; summands between the sides, where < on Int is <= with 1 added, and on Real the strictness must agree
(declare-fun p (Int) Bool)
(declare-fun f (Int) Int)
(declare-fun g (Int) Int)
(declare-fun n (Int) Int)
(declare-fun d (Int) Int)
(declare-fun lt (Int Int) Bool)
(declare-fun le (Int Int) Bool)
(declare-fun le0 (Int Int) Bool)
(declare-fun ltr (Real Real) Bool)
(declare-const a Int)
(declare-const b Int)
(declare-const c Real)
(declare-const e Real)
(assert (! (forall ((x Int)) (= (f (+ x 1)) (g x))) :rw))
(assert (p (f (+ 1 a))))
(assert (p (f (+ a 1 b))))
(assert (p (f (- 1 a))))
(assert (p (f a)))
(assert (! (forall ((x Int)) (= (n (- x)) (g x))) :rw))
(assert (p (n (- a))))
(assert (p (n (- (- a) b))))
(assert (p (n (+ a 1))))
(assert (! (forall ((x Int) (y Int)) (= (d (- x y)) (g y))) :rw))
(assert (p (d (+ a (- b)))))
(assert (! (forall ((x Int) (y Int)) (= (<= (+ x 1) y) (lt x y))) :rw))
(assert (< a b))
(assert (! (forall ((x Real) (y Real)) (= (< x y) (ltr x y))) :rw))
(assert (< c e))
(assert (<= c e))
