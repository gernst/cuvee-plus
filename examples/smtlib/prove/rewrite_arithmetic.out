(declare-fun p (Int) Bool)

(declare-fun f (Int) Int)

(declare-fun g (Int) Int)

(declare-fun n (Int) Int)

(declare-fun d (Int) Int)

(declare-fun lt (Int Int) Bool)

(declare-fun le (Int Int) Bool)

(declare-fun le0 (Int Int) Bool)

(declare-fun ltr (Real Real) Bool)

(declare-const a Int)

(declare-const b Int)

(declare-const c Real)

(declare-const e Real)

(assert
  (!
    (forall
      ((x Int))
      (= (f (+ x 1)) (g x)))
    :rw))

(assert (p (g a)))

(assert (p (g (+ a b))))

(assert (p (g (- a))))

(assert (p (f a)))

(assert
  (!
    (forall ((x Int)) (= (n (- x)) (g x)))
    :rw))

(assert (p (g a)))

(assert (p (g (+ a b))))

(assert (p (n (+ a 1))))

(assert
  (!
    (forall
      ((x Int) (y Int))
      (= (d (- x y)) (g y)))
    :rw))

(assert (p (g b)))

(assert
  (!
    (forall
      ((x Int) (y Int))
      (= (<= (+ x 1) y) (lt x y)))
    :rw))

(assert (lt a b))

(assert
  (!
    (forall
      ((x Real) (y Real))
      (= (< x y) (ltr x y)))
    :rw))

(assert (ltr c e))

(assert (<= c e))

