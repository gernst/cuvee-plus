; ./Cuvee.sh examples/svlib/parsing/invalid_recurring.svlib
; the liveness properties are not supported

(define-proc main
  ((n Int))
  ((i Int))
  ()
  (! (sequence
       (assign (i 0))
       (! (while (< i n) (assign (i (+ i 1)))) :tag loop))
     :tag main))

(annotate-tag loop :not-recurring)
