; ./Cuvee.sh examples/svlib/parsing/invalid_scope.svlib
; the variables of an annotation are resolved in the scope of the tagged statement, the input y0 of add is not
; in scope at the body of main, which has the same tag

(define-proc add
  ((x0 Int) (y0 Int))
  ((x Int))
  ((y Int))
  (! (sequence
       (assign (x x0) (y y0))
       (while (< 0 y) (assign (x (+ x 1)) (y (- y 1)))))
     :tag body))

(define-proc main
  ()
  ((r Int))
  ()
  (! (call add (1 2) (r)) :tag body))

(annotate-tag body :check-true (<= 0 y0))
