(set-logic HORN)

(declare-fun count_pre (Int) Bool)

(declare-fun count_post (Int Int) Bool)

(declare-fun count_join_1 (Int Int Int) Bool)

(declare-fun count_assign_2 (Int Int Int) Bool)

(declare-fun count_call_3 (Int Int Int) Bool)

(declare-fun count_assign_4 (Int Int Int) Bool)

(assert
  (forall
    ((n Int))
    (=> (count_pre n) (<= 0 n))))

(assert
  (forall
    ((n Int) (r Int))
    (=> (count_post n r) (= r n))))

(assert
  (forall
    ((n Int) (r1$1 Int))
    (=>
      (and (count_pre n) (<= n 0))
      (count_assign_2 n 0 r1$1))))

(assert
  (forall
    ((n Int) (r Int) (r1$1 Int))
    (=>
      (count_assign_2 n r r1$1)
      (count_join_1 n r r1$1))))

(assert
  (forall
    ((n Int))
    (=>
      (and (count_pre n) (not (<= n 0)))
      (count_pre (- n 1)))))

(assert
  (forall
    ((n Int))
    (=>
      (and (count_pre n) (not (<= n 0)))
      (and (<= 0 n) (< (- n 1) n)))))

(assert
  (forall
    ((n Int) (r Int) (r1$2 Int))
    (=>
      (and
        (count_pre n)
        (not (<= n 0))
        (count_post (- n 1) r1$2))
      (count_call_3 n r r1$2))))

(assert
  (forall
    ((n Int) (r Int) (r1$1 Int))
    (=>
      (count_call_3 n r r1$1)
      (count_assign_4 n (+ 1 r1$1) r1$1))))

(assert
  (forall
    ((n Int) (r Int) (r1$1 Int))
    (=>
      (count_assign_4 n r r1$1)
      (count_join_1 n r r1$1))))

(assert
  (forall
    ((n Int) (r Int) (r1$1 Int))
    (=>
      (count_join_1 n r r1$1)
      (count_post n r))))

(declare-const main_pre Bool)

(declare-fun main_post (Int) Bool)

(declare-fun main_call_1 (Int Int) Bool)

(declare-fun main_spec_2 (Int Int) Bool)

(declare-fun main_assign_3 (Int Int) Bool)

(assert
  (=> main_pre (count_pre 3)))

(assert
  (forall
    ((result Int) (r2$4 Int))
    (=>
      (and main_pre (count_post 3 r2$4))
      (main_call_1 result r2$4))))

(assert
  (forall
    ((result Int) (r2$3 Int))
    (=>
      (main_call_1 result r2$3)
      (= r2$3 3))))

(assert
  (forall
    ((result Int) (r2$3 Int))
    (=>
      (and
        (main_call_1 result r2$3)
        true)
      (main_spec_2 result r2$3))))

(assert
  (forall
    ((result Int) (r2$3 Int))
    (=>
      (main_spec_2 result r2$3)
      (main_assign_3 0 r2$3))))

(assert
  (forall
    ((result Int) (r2$3 Int))
    (=>
      (main_assign_3 result r2$3)
      (main_post result))))

(assert (=> true main_pre))

(assert
  (=> (not true) false))

(check-sat)

(get-model)

