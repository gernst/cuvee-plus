(set-logic LIA)

(define-proc
  main
  ((l Int) (n Int))
  ((result Int))
  ((i Int))
  (!
    (sequence
      (assign (i l))
      (if
        (not (< 0 l))
        (sequence (assign (result 0)) (return)))
      (!
        (while (< i n) (assign (i (+ i 1))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1 :check-true (< 0 i))
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= 1 l))

(annotate-tag main-while-1 :invariant (<= l i))

(verify-call main (1 5))

(get-info :witness)

