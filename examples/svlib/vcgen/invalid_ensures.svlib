; ./Cuvee.sh -verify -z3 examples/svlib/vcgen/invalid_ensures.svlib
; the postcondition is wrong by one, the goal of the procedure does not hold

(set-logic LIA)

(define-proc add
  ((x0 Int) (y0 Int))
  ((x Int))
  ((y Int))
  (! (sequence
       (assign (x x0) (y y0))
       (! (while (< 0 y)
            (assign (x (+ x 1)) (y (- y 1))))
          :tag while-loop))
     :tag proc-add))

(annotate-tag proc-add
  :requires (<= 0 y0)
  :ensures (= x (+ x0 y0 1)))

(annotate-tag while-loop
  :invariant (and (<= 0 y) (= (+ x y) (+ x0 y0)))
  :decreases y)

(declare-const x1 Int)
(declare-const y1 Int)

(assert (<= 0 y1))

(verify-call add (x1 y1))
