; ./Cuvee.sh -vcgen -z3 examples/svlib/vcgen/invalid_invariant.svlib
; the invariant is not strong enough for the postcondition, which needs (<= 0 y) at the exit of the loop

(set-logic LIA)

(define-proc add
  ((x0 Int) (y0 Int))
  ((x Int))
  ((y Int))
  (! (sequence
       (assign (x x0) (y y0))
       (! (while (< 0 y)
            (assign (x (+ x 1)) (y (- y 1))))
          :tag while-loop))
     :tag proc-add))

(annotate-tag proc-add
  :requires (<= 0 y0)
  :ensures (= x (+ x0 y0)))

(annotate-tag while-loop
  :invariant (= (+ x y) (+ x0 y0)))

(declare-const x1 Int)
(declare-const y1 Int)

(assert (<= 0 y1))

(verify-call add (x1 y1))
