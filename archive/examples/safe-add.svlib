; addition by a loop, as in the SV-LIB report, without an invariant, which -teq and -chc do not need
(set-logic LIA)

(define-proc add
  ((x0 Int) (y0 Int))
  ((x Int))
  ((y Int))
  (! (sequence
       (assign (x x0) (y y0))
       (while (< 0 y)
         (assign (x (+ x 1)) (y (- y 1)))))
     :tag proc-add))

(annotate-tag proc-add
  :requires (<= 0 y0)
  :ensures (= x (+ x0 y0)))

(declare-const x1 Int)
(declare-const y1 Int)

(verify-call add (x1 y1))
