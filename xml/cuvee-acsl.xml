<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<!-- Cuvée on the SV-COMP tasks annotated by hand with ACSL (benchmarks/acsl): the verification conditions of the
     annotations, solved by z3 -->
<benchmark tool="cuvee" displayName="Cuvée (ACSL)" timelimit="15 min" hardtimelimit="16 min" memlimit="7 GB" cpuCores="2">

  <require cpuModel="Intel Core i9-9900 @ 3.10 GHz"/>

  <option name="-vcgen"/>
  <option name="-z3"/>
  <!-- z3 is limited by the time limit only, which this covers, since -timeout defaults to 1 s per query -->
  <option name="-timeout">900000</option>

  <!-- the categories ReachSafety-Arrays and ReachSafety-Loops of SV-COMP, by the folders of their sets
       (sv-benchmarks/c/Arrays.set, Loops.set) that benchmarks/acsl contains -->
  <rundefinition name="ACSL_unreach-call">
    <tasks name="C.unreach-call.Arrays">
      <include>../benchmarks/acsl/array-*/*.yml</include>
      <include>../benchmarks/acsl/reducercommutativity/*.yml</include>
      <propertyfile>../benchmarks/acsl/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="C.unreach-call.Loops">
      <include>../benchmarks/acsl/loop*/*.yml</include>
      <include>../benchmarks/acsl/nla-digbench*/*.yml</include>
      <propertyfile>../benchmarks/acsl/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>
</benchmark>
