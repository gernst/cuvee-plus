<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<!-- Cuvée as in cuvee.xml, on samples of ReachSafety-Arrays and -Loops (benchmarks/sv-comp/samples) with short
     limits, for runs during development (doc/benchmarks.md): 2 min, 2 cores, 7 GB, so that four runs share a machine -->
<benchmark tool="cuvee" displayName="Cuvée" timelimit="2 min" hardtimelimit="3 min" memlimit="7 GB" cpuCores="2">

  <require cpuModel="Intel Core i7-6700 @ 3.40 GHz"/>

  <resultfiles>**/witness.*</resultfiles>

  <option name="-teq"/>
  <!-- the lemma database teq.dfy of -teq and the optional modules migrated so far (doc/teq.md) -->
  <option name="-include">teq:aggregation</option>
  <option name="-include">teq:arithmetic</option>
  <option name="-include">teq:arrays</option>
  <option name="-include">teq:counters</option>
  <option name="-include">teq:search</option>
  <option name="-include">teq:sorted</option>
  <option name="-include">teq:strides</option>
  <option name="-include">teq:unsigned</option>
  <option name="-prove"/>
  <option name="-split"/>
  <option name="-prove"/>
  <!-- a second round splits the disjunctions that the rules introduce, e.g. n == zero || integer(n) < 1 of mods -->
  <option name="-split"/>
  <option name="-prove"/>
  <!-- the rules applied to each goal, for the statistics of scripts/rules.py -->
  <option name="-rules"/>
  <!-- the answers correct, incorrect, or unknown, which cuvee.py reads -->
  <option name="-verify"/>
  <!-- the witness of SV-COMP for the answer to a C program, without invariants or with the target only (yml.Witness) -->
  <option name="-witness">witness.yml</option>

  <rundefinition name="sample_unreach-call">
    <tasks name="C.unreach-call.Arrays-sample">
      <includesfile>../benchmarks/sv-comp/samples/Arrays.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="C.unreach-call.Loops-sample">
      <includesfile>../benchmarks/sv-comp/samples/Loops.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>
</benchmark>
