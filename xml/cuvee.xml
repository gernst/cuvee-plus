<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<!-- Cuvée with trace equation systems, simplification, and splitting of the remaining goals -->
<benchmark tool="cuvee" displayName="Cuvée" timelimit="15 min" hardtimelimit="16 min" memlimit="7 GB" cpuCores="2">

  <require cpuModel="Intel Core i9-9900 @ 3.10 GHz"/>

  <resultfiles>**/witness.*</resultfiles>

  <option name="-teq"/>
  <!-- the lemma database teq.dfy of -teq and the optional modules migrated so far (doc/teq.md) -->
  <option name="-include">teq:aggregation</option>
  <option name="-include">teq:arithmetic</option>
  <option name="-include">teq:arrays</option>
  <option name="-include">teq:counters</option>
  <option name="-include">teq:search</option>
  <option name="-include">teq:sorted</option>
  <option name="-include">teq:strides</option>
  <option name="-include">teq:unsigned</option>
  <option name="-prove"/>
  <option name="-split"/>
  <option name="-prove"/>
  <!-- a second round splits the disjunctions that the rules introduce, e.g. n == zero || integer(n) < 1 of mods -->
  <option name="-split"/>
  <option name="-prove"/>
  <!-- the rules applied to each goal, for the statistics of scripts/rules.py -->
  <option name="-rules"/>
  <!-- the witness of SV-COMP for the answer to a C program, without invariants or with the target only (yml.Witness) -->
  <option name="-witness">witness.yml</option>

  <!-- the categories ReachSafety-Arrays and ReachSafety-Loops of SV-COMP (sv-benchmarks) -->
  <rundefinition name="SV-COMP27_unreach-call">
    <tasks name="C.unreach-call.Arrays">
      <includesfile>../sv-benchmarks/c/Arrays.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="C.unreach-call.Loops">
      <includesfile>../sv-benchmarks/c/Loops.set</includesfile>
      <includesfile>../sv-benchmarks/c/VerifyThis-Loops.set</includesfile>
      <propertyfile>../sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>

  <!-- the SV-COMP tests of the CAV 2023 paper on MonoCera, converted for Cuvée (benchmarks/monocera/convert_cuvee.py),
       by the operator that MonoCera instruments -->
  <!-- as in the paper, which runs all tools with mathematical integers (TriCera's default -arithMode:math) -->
  <rundefinition name="MonoCera_unreach-call">
    <tasks name="C.unreach-call.MonoCera-Forall">
      <option name="-unbounded"/>
      <include>../benchmarks/monocera/polished_tests/cuvee/forall/*.yml</include>
      <propertyfile>../benchmarks/monocera/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="C.unreach-call.MonoCera-Max">
      <option name="-unbounded"/>
      <include>../benchmarks/monocera/polished_tests/cuvee/max/*.yml</include>
      <propertyfile>../benchmarks/monocera/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="C.unreach-call.MonoCera-Min">
      <option name="-unbounded"/>
      <include>../benchmarks/monocera/polished_tests/cuvee/min/*.yml</include>
      <propertyfile>../benchmarks/monocera/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="C.unreach-call.MonoCera-Sum">
      <option name="-unbounded"/>
      <include>../benchmarks/monocera/polished_tests/cuvee/sum/*.yml</include>
      <propertyfile>../benchmarks/monocera/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>

  <!-- the categories SV-LIB.correct-tags.* of SV-COMP (sv-benchmarks/sv-lib) for verifiers; not CoreValidation,
       whose tasks are for validators, nor the translations of BTOR2, which are on bitvectors -->
  <rundefinition name="SV-LIB_correct-tags">
    <tasks name="SV-LIB.correct-tags.CoreVerification">
      <includesfile>../sv-benchmarks/sv-lib/CoreVerification.set</includesfile>
      <propertyfile>../sv-benchmarks/sv-lib/properties/correct-annotations.prp</propertyfile>
    </tasks>
    <tasks name="SV-LIB.correct-tags.CTranslated">
      <includesfile>../sv-benchmarks/sv-lib/CTranslated.set</includesfile>
      <propertyfile>../sv-benchmarks/sv-lib/properties/correct-annotations.prp</propertyfile>
    </tasks>
  </rundefinition>

  <!-- the RAPID benchmarks: array programs in Boogie with quantified postconditions (benchmarks/rapid, adjusted to
       standard Boogie), whose single procedure is main, the entry point -->
  <rundefinition name="RAPID_unreach-call">
    <tasks name="Boogie.unreach-call.RAPID">
      <option name="-entry">main</option>
      <includesfile>../benchmarks/rapid/rapid.set</includesfile>
      <propertyfile>../benchmarks/rapid/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>
</benchmark>
