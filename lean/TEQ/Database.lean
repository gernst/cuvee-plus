def Stmt.prefix_counts : Prop :=
  ∀ {α : Type} [Inhabited α] (k : Int) (x : Int) (e : α) (vs : List α) (n : Int) (hvs : length vs = n),
    «prefix» k (butlast (counts x e vs)) = butlast (counts x e («prefix» k vs))

def Stmt.sum_selects_update : Prop :=
  ∀ {α : Type} [Inhabited α] (a : α → Int) (k : α) (v : Int) (keys : List α) (n : Int) (hkeys : length keys = n),
    distincts keys
      → sum (elems (selects (fun j => if j = k then v else a j) keys))
        = (if occurs k keys then
             sum (elems (selects a keys)) + v - a k
           else
             if ¬occurs k keys then sum (elems (selects a keys)) else unspecified)

def Stmt.parity_selects_update : Prop :=
  ∀ {α : Type} [Inhabited α] (a : α → Int) (k : α) (v : Int) (keys : List α) (n : Int) (hkeys : length keys = n),
    distincts keys
      → parity (elems (selects (fun j => if j = k then v else a j) keys))
        = (if occurs k keys then
             parity (elems (selects a keys))
               + (if v % 2 = 0 then 1 else if v % 2 ≠ 0 then -1 else unspecified)
               - (if a k % 2 = 0 then
                    1
                  else
                    if a k % 2 ≠ 0 then -1 else unspecified)
           else
             if ¬occurs k keys then
               parity (elems (selects a keys))
             else
               unspecified)

def Stmt.count_selects_update : Prop :=
  ∀ {α β : Type} [Inhabited α] [Inhabited β] (a : α → β) (k : α) (w : β) (e : β) (keys : List α) (n : Int) (hkeys : length keys = n),
    distincts keys
      → Bag.count (elems (selects (fun j => if j = k then w else a j) keys)) e
        = (if occurs k keys then
             Bag.count (elems (selects a keys)) e
               + (if w = e then 1 else if w ≠ e then 0 else unspecified)
               - (if a k = e then 1 else if a k ≠ e then 0 else unspecified)
           else
             if ¬occurs k keys then
               Bag.count (elems (selects a keys)) e
             else
               unspecified)

def Stmt.sums_consts : Prop :=
  ∀ (x : Int) (n : Int) (c : Int),
    sums x (butlast (consts n c)) = counter x c n

def Stmt.sum_above : Prop :=
  ∀ (n : Int) (hs : List Int) (V : Int → Int → Int) (e : Int) (hhs : length hs = n),
    (0 < n ∨ e ≤ 0)
      ∧ invs (List.zip (butlast (counter 0 1 n)) hs) (fun ⟨k, h⟩ => e ≤ n * V k h)
      → e
        ≤ sum
          (elems
             (maps (List.zip (butlast (counter 0 1 n)) hs) (fun ⟨k, h⟩ => V k h)))

def Stmt.sum_below : Prop :=
  ∀ (n : Int) (hs : List Int) (V : Int → Int → Int) (e : Int) (hhs : length hs = n),
    (0 < n ∨ 0 ≤ e)
      ∧ invs (List.zip (butlast (counter 0 1 n)) hs) (fun ⟨k, h⟩ => n * V k h ≤ e)
      → sum
        (elems
           (maps (List.zip (butlast (counter 0 1 n)) hs) (fun ⟨k, h⟩ => V k h)))
        ≤ e

def Stmt.sum_mod_multiples : Prop :=
  ∀ (n : Int) (hs : List Int) (V : Int → Int → Int) (m : Int) (hhs : length hs = n),
    0 < m
      ∧ invs (List.zip (butlast (counter 0 1 n)) hs) (fun ⟨k, h⟩ => V k h % m = 0)
      → sum
        (elems
           (maps (List.zip (butlast (counter 0 1 n)) hs) (fun ⟨k, h⟩ => V k h)))
        % m
        = 0

def Stmt.sum_mod_below : Prop :=
  ∀ (n : Int) (m : Int) (e : Int),
    0 ≤ n ∧ 0 < m ∧ n * (m - 1) ≤ e
      → sum
        (elems
           (maps
              (butlast (counter 0 1 n))
              (fun k =>
                 if 0 < k then k % m else if k ≤ 0 then 0 else unspecified)))
        ≤ e

def Stmt.sum_neg : Prop :=
  ∀ (values : List Int) (n : Int) (hvalues : length values = n),
    sum (elems (maps values (fun v => -v))) = -sum (elems values)

def Stmt.sum_scale : Prop :=
  ∀ (values : List Int) (a : Int) (n : Int) (hvalues : length values = n),
    sum (elems (maps values (fun v => a * v))) = a * sum (elems values)

def Stmt.sum_add : Prop :=
  ∀ (xs : List Int) (ys : List Int) (n : Int) (hxs : length xs = n) (hys : length ys = n),
    sum (elems (maps (List.zip xs ys) (fun ⟨v, w⟩ => v + w)))
      = sum (elems xs) + sum (elems ys)

def Stmt.sum_indicator_true : Prop :=
  ∀ {α : Type} [Inhabited α] (xs : List α) (P : α → Prop) (n : Int) (hxs : length xs = n),
    sum
      (elems
         (maps xs (fun x => if P x then 1 else if ¬P x then 0 else unspecified)))
      = Bag.count (elems (maps xs (fun x => P x))) True

def Stmt.sum_indicator_false : Prop :=
  ∀ {α : Type} [Inhabited α] (xs : List α) (P : α → Prop) (n : Int) (hxs : length xs = n),
    sum
      (elems
         (maps xs (fun x => if P x then 0 else if ¬P x then 1 else unspecified)))
      = Bag.count (elems (maps xs (fun x => P x))) False

def Stmt.sum_parity_indicator : Prop :=
  ∀ {α : Type} [Inhabited α] (xs : List α) (F : α → Int) (n : Int) (hxs : length xs = n),
    sum
      (elems
         (maps
            xs
            (fun x =>
               if F x % 2 = 0 then
                 1
               else
                 if F x % 2 ≠ 0 then -1 else unspecified)))
      = parity (elems (maps xs (fun x => F x)))

def Stmt.count_consts : Prop :=
  ∀ {α : Type} [Inhabited α] (n : Int) (e : α) (v : α),
    0 ≤ n
      → Bag.count (elems (butlast (consts n v))) e
        = (if v = e then n else if v ≠ e then 0 else unspecified)

def Stmt.count_true_below : Prop :=
  ∀ (m : Int) (i : Int) (n : Int),
    i ≤ m ∧ m ≤ i + n
      → Bag.count (elems (maps (butlast (counter i 1 n)) (fun k => k < m))) True
        = m - i

def Stmt.count_true_above : Prop :=
  ∀ (m : Int) (i : Int) (n : Int),
    i ≤ m ∧ m ≤ i + n
      → Bag.count (elems (maps (butlast (counter i 1 n)) (fun k => m ≤ k))) True
        = i + n - m

def Stmt.count_nonnegative : Prop :=
  ∀ {α : Type} [Inhabited α] (e : α) (vs : List α),
    0 ≤ Bag.count (elems vs) e

def Stmt.count_remainder : Prop :=
  ∀ (n : Int) (m : Int) (r : Int),
    0 ≤ n ∧ 0 < m ∧ 0 ≤ r ∧ r < m
      → Bag.count (elems (maps (butlast (counter 0 1 n)) (fun k => k % m))) r
        = (n + m - 1 - r) / m

def Stmt.count_false_true : Prop :=
  ∀ (i : Int) (c : Int) (n : Int) (hs : List Int) (P : Int → Int → Prop) (hhs : length hs = n),
    0 ≤ n
      → Bag.count
        (elems
           (maps (List.zip (butlast (counter i c n)) hs) (fun ⟨k, h⟩ => P k h)))
        False
        = n
          - Bag.count
            (elems
               (maps
                  (List.zip (butlast (counter i c n)) hs)
                  (fun ⟨k, h⟩ => P k h)))
            True

def Stmt.count_true_eq : Prop :=
  ∀ (ks : List Int) (r : Int) (hs : List Int) (F : Int → Int → Int) (n : Int) (hks : length ks = n) (hhs : length hs = n),
    Bag.count (elems (maps (List.zip ks hs) (fun ⟨k, h⟩ => F k h = r))) True
      = Bag.count (elems (maps (List.zip ks hs) (fun ⟨k, h⟩ => F k h))) r

def Stmt.max_initial : Prop :=
  ∀ (x : Int) (values : List Int),
    x ≤ max x (elems values)

def Stmt.max_earlier : Prop :=
  ∀ (k : Int) (x : Int) (values : List Int),
    0 ≤ k ∧ k < length values →
      (earlier k values ≤ max x (elems values))

def Stmt.max_prefix_earlier : Prop :=
  ∀ (k : Int) (x : Int) (n : Int) (xs : List Int) (hxs : k < length xs),
    0 ≤ k ∧ k < n → earlier k xs ≤ max x (elems («prefix» n xs))

def Stmt.min_initial : Prop :=
  ∀ (x : Int) (values : List Int),
    min x (elems values) ≤ x

def Stmt.min_earlier : Prop :=
  ∀ (k : Int) (x : Int) (values : List Int),
    0 ≤ k ∧ k < length values →
      (min x (elems values) ≤ earlier k values)

def Stmt.min_prefix_earlier : Prop :=
  ∀ (k : Int) (x : Int) (n : Int) (xs : List Int) (hxs : k < length xs),
    0 ≤ k ∧ k < n → min x (elems («prefix» n xs)) ≤ earlier k xs

def Stmt.max_seeded_earlier : Prop :=
  ∀ (j : Int) (h : Int) (i : Int) (n : Int) (xs : List Int),
    h = i - 1 ∧ h ≤ j ∧ j < i + n
      → earlier j xs
        ≤ max
          (earlier h xs)
          (elems (maps (butlast (counter i 1 n)) (fun v => earlier v xs)))

def Stmt.min_seeded_earlier : Prop :=
  ∀ (j : Int) (h : Int) (i : Int) (n : Int) (xs : List Int),
    h = i - 1 ∧ h ≤ j ∧ j < i + n
      → min
        (earlier h xs)
        (elems (maps (butlast (counter i 1 n)) (fun v => earlier v xs)))
        ≤ earlier j xs

noncomputable def bands (x : Int) (values : List Int) : Trace Int :=
  trace x values (fun r v => bitand r v)

def Stmt.length_bands : Prop :=
  ∀ (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    length (butlast (bands x values)) = length values

def Stmt.current_bands : Prop :=
  ∀ (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    current (bands x values) = bitand x (band (elems values))

def Stmt.earlier_bands : Prop :=
  ∀ (j : Int) (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    0 ≤ j ∧ j < n →
      (earlier j (butlast (bands x values))
         = bitand x (band (elems («prefix» j values))))

noncomputable def bors (x : Int) (values : List Int) : Trace Int :=
  trace x values (fun r v => bitor r v)

def Stmt.length_bors : Prop :=
  ∀ (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    length (butlast (bors x values)) = length values

def Stmt.current_bors : Prop :=
  ∀ (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    current (bors x values) = bitor x (bor (elems values))

def Stmt.earlier_bors : Prop :=
  ∀ (j : Int) (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    0 ≤ j ∧ j < n →
      (earlier j (butlast (bors x values))
         = bitor x (bor (elems («prefix» j values))))

def Stmt.band_seed_selects : Prop :=
  ∀ (a : Int → Int) (q : Int) (n : Int) (v : Int),
    0 ≤ n ∧ v = a (q - 1)
      → bitand v (band (elems (selects a (butlast (counter q 1 n)))))
        = band (elems (selects a (butlast (counter (q - 1) 1 (n + 1)))))

def Stmt.band_seed_earlier : Prop :=
  ∀ (xs : List Int) (n : Int) (hxs : n + 1 ≤ length xs),
    0 ≤ n
      → bitand
        (earlier 0 xs)
        (band
           (elems (maps (butlast (counter 0 1 n)) (fun k => earlier (k + 1) xs))))
        = band (elems («prefix» (n + 1) xs))

def Stmt.bor_seed_selects : Prop :=
  ∀ (a : Int → Int) (q : Int) (n : Int) (v : Int),
    0 ≤ n ∧ v = a (q - 1)
      → bitor v (bor (elems (selects a (butlast (counter q 1 n)))))
        = bor (elems (selects a (butlast (counter (q - 1) 1 (n + 1)))))

def Stmt.bor_seed_earlier : Prop :=
  ∀ (xs : List Int) (n : Int) (hxs : n + 1 ≤ length xs),
    0 ≤ n
      → bitor
        (earlier 0 xs)
        (bor
           (elems (maps (butlast (counter 0 1 n)) (fun k => earlier (k + 1) xs))))
        = bor (elems («prefix» (n + 1) xs))

def Stmt.elems_selects_swap : Prop :=
  ∀ (a : Int → Int) (p : Int) (q : Int) (v : Int) (w : Int) (keys : List Int) (n : Int) (hkeys : length keys = n),
    distincts keys ∧ occurs p keys ∧ occurs q keys ∧ v = a q ∧ w = a p
      → elems
        (selects
           (fun j => if j = q then w else (fun j => if j = p then v else a j) j)
           keys)
        = elems (selects a keys)

def Stmt.elems_selects_shift : Prop :=
  ∀ (a : Int → Int) (i : Int) (n : Int) (m : Int),
    0 ≤ n ∧ m = n + 1
      → elems
        (selects
           (current (shifts a (butlast (counter i 1 n))))
           (butlast (counter i 1 m)))
        = elems (selects a (butlast (counter i 1 m))) - {a i} + {a (i + n)}

def Stmt.elems_selects_rotate : Prop :=
  ∀ (a : Int → Int) (i : Int) (n : Int) (m : Int) (l : Int) (v : Int),
    0 ≤ n ∧ m = n + 1 ∧ l = i + n ∧ v = a i
      → elems
        (selects
           (fun j =>
              if j = l then v else current (shifts a (butlast (counter i 1 n))) j)
           (butlast (counter i 1 m)))
        = elems (selects a (butlast (counter i 1 m)))

noncomputable def compacts (c0 : Int → Int) (ks : List Int)
                           (P : Int → Prop) : Trace (Int → Int) :=
  trace
    c0
    (List.zip ks (butlast (counts 0 True (maps ks (fun k => P k)))))
    (fun c ⟨k, j⟩ =>
       if P k then
         fun j1 => if j1 = j then k else c j1
       else
         if ¬P k then c else unspecified)

def Stmt.length_compacts : Prop :=
  ∀ (c0 : Int → Int) (ks : List Int) (P : Int → Prop) (n : Int) (hks : length ks = n),
    length (butlast (compacts c0 ks P)) = length ks

def Stmt.select_current_compacts_lower : Prop :=
  ∀ (c0 : Int → Int) (K : Trace Int) (n : Int) (m : Int) (x : Int) (P : Int → Prop),
    K = counter 0 1 n
      ∧ m = Bag.count (elems (maps (butlast K) (fun k => P k))) True
      ∧ 0 ≤ x
      ∧ x < m
      → x ≤ current (compacts c0 (butlast K) P) x

def Stmt.select_current_compacts_upper : Prop :=
  ∀ (c0 : Int → Int) (K : Trace Int) (n : Int) (m : Int) (x : Int) (P : Int → Prop),
    K = counter 0 1 n
      ∧ m = Bag.count (elems (maps (butlast K) (fun k => P k))) True
      ∧ 0 ≤ x
      ∧ x < m
      → current (compacts c0 (butlast K) P) x + m ≤ x + n

noncomputable def filters_above (c0 : Int → Int) (ks : List Int) (b : Int)
                                (F : Int → Int) : Trace (Int → Int) :=
  trace
    c0
    (List.zip ks (butlast (counts 0 True (maps ks (fun k => b ≤ F k)))))
    (fun c ⟨k, j⟩ =>
       if b ≤ F k then
         fun j1 => if j1 = j then F k else c j1
       else
         if F k < b then c else unspecified)

def Stmt.length_filters_above : Prop :=
  ∀ (c0 : Int → Int) (ks : List Int) (b : Int) (F : Int → Int) (n : Int) (hks : length ks = n),
    length (butlast (filters_above c0 ks b F)) = length ks

def Stmt.select_current_filters_above : Prop :=
  ∀ (c0 : Int → Int) (ks : List Int) (b : Int) (F : Int → Int) (m : Int) (x : Int) (n : Int) (hks : length ks = n),
    m = Bag.count (elems (maps ks (fun k => b ≤ F k))) True ∧ 0 ≤ x ∧ x < m
      → b ≤ current (filters_above c0 ks b F) x

noncomputable def filters_below (c0 : Int → Int) (ks : List Int) (b : Int)
                                (F : Int → Int) : Trace (Int → Int) :=
  trace
    c0
    (List.zip ks (butlast (counts 0 False (maps ks (fun k => b ≤ F k)))))
    (fun c ⟨k, j⟩ =>
       if b ≤ F k then
         c
       else
         if F k < b then
           fun j1 => if j1 = j then F k else c j1
         else
           unspecified)

def Stmt.length_filters_below : Prop :=
  ∀ (c0 : Int → Int) (ks : List Int) (b : Int) (F : Int → Int) (n : Int) (hks : length ks = n),
    length (butlast (filters_below c0 ks b F)) = length ks

def Stmt.select_current_filters_below : Prop :=
  ∀ (c0 : Int → Int) (K : Trace Int) (n : Int) (b : Int) (F : Int → Int) (m : Int) (x : Int),
    K = counter 0 1 n
      ∧ Bag.count (elems (maps (butlast K) (fun k => b ≤ F k))) True + m = n
      ∧ 0 ≤ x
      ∧ x < m
      → current (filters_below c0 (butlast K) b F) x < b

noncomputable def parities (x : Int) (values : List Int) : Trace Int :=
  trace
    x
    values
    (fun s v =>
       if v % 2 = 0 then s + 1 else if v % 2 ≠ 0 then s - 1 else unspecified)

def Stmt.length_parities : Prop :=
  ∀ (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    length (butlast (parities x values)) = length values

def Stmt.current_parities : Prop :=
  ∀ (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    current (parities x values) = x + parity (elems values)

def Stmt.earlier_parities : Prop :=
  ∀ (j : Int) (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    0 ≤ j ∧ j < n →
      (earlier j (butlast (parities x values))
         = x + parity (elems («prefix» j values)))

def Stmt.prefix_parities : Prop :=
  ∀ (k : Int) (x : Int) (values : List Int) (n : Int) (hvalues : length values = n),
    «prefix» k (butlast (parities x values))
      = butlast (parities x («prefix» k values))

def Stmt.select_current_trace_reset_add : Prop :=
  ∀ (a0 : Int → Int) (j : Int) (n : Int) (c : Int) (G : Int → Int),
    current
      (trace
         a0
         (butlast (counter 0 1 n))
         (fun a k =>
            if k = 0 then
              fun j1 => if j1 = j then c else a j1
            else
              if 0 < k then
                fun j1 => if j1 = j then a j + G k else a j1
              else
                unspecified))
      j
      = (if n ≤ 0 then
           a0 j
         else
           if 0 < n then
             c
               + sum
                 (elems
                    (maps
                       (butlast (counter 0 1 n))
                       (fun k =>
                          if 0 < k then
                            G k
                          else
                            if k ≤ 0 then 0 else unspecified)))
           else
             unspecified)

def Stmt.select_current_trace_reset_add_keep : Prop :=
  ∀ (a0 : Int → Int) (j : Int) (n : Int) (c : Int) (P : Int → Prop) (G : Int → Int),
    current
      (trace
         a0
         (butlast (counter 0 1 n))
         (fun a k =>
            if k = 0 then
              fun j1 => if j1 = j then c else a j1
            else
              if 0 < k ∧ P k then
                fun j1 => if j1 = j then a j + G k else a j1
              else
                if 0 < k ∧ ¬P k then a else unspecified))
      j
      = (if n ≤ 0 then
           a0 j
         else
           if 0 < n then
             c
               + sum
                 (elems
                    (maps
                       (butlast (counter 0 1 n))
                       (fun k =>
                          if 0 < k ∧ P k then
                            G k
                          else
                            if k ≤ 0 ∨ ¬P k then 0 else unspecified)))
           else
             unspecified)

def Stmt.current_trace_reset_add_keep : Prop :=
  ∀ (x0 : Int) (n : Int) (c : Int) (P : Int → Prop) (G : Int → Int),
    current
      (trace
         x0
         (butlast (counter 0 1 n))
         (fun x k =>
            if k = 0 then
              c
            else
              if 0 < k ∧ P k then
                x + G k
              else
                if 0 < k ∧ ¬P k then x else unspecified))
      = (if n ≤ 0 then
           x0
         else
           if 0 < n then
             c
               + sum
                 (elems
                    (maps
                       (butlast (counter 0 1 n))
                       (fun k =>
                          if 0 < k ∧ P k then
                            G k
                          else
                            if k ≤ 0 ∨ ¬P k then 0 else unspecified)))
           else
             unspecified)

noncomputable def scans (a : Int → Int) (keys : List Int)
                        (values : List Int) : Trace (Int → Int) :=
  trace
    a
    (List.zip keys values)
    (fun b ⟨p, v⟩ => fun j => if j = p + 1 then b p + v else b j)

def Stmt.length_scans : Prop :=
  ∀ (a : Int → Int) (keys : List Int) (values : List Int) (n : Int) (hkeys : length keys = n) (hvalues : length values = n),
    length (butlast (scans a keys values)) = length keys

def Stmt.earlier_scans : Prop :=
  ∀ (j : Int) (a : Int → Int) (keys : List Int) (values : List Int) (n : Int) (hkeys : length keys = n) (hvalues : length values = n),
    0 ≤ j ∧ j < n →
      (earlier j (butlast (scans a keys values))
         = current (scans a («prefix» j keys) («prefix» j values)))

def Stmt.prefix_scans : Prop :=
  ∀ (k : Int) (a : Int → Int) (keys : List Int) (values : List Int) (n : Int) (hkeys : length keys = n) (hvalues : length values = n),
    «prefix» k (butlast (scans a keys values))
      = butlast (scans a («prefix» k keys) («prefix» k values))

def Stmt.select_current_scans : Prop :=
  ∀ (b0 : Int → Int) (i : Int) (n : Int) (values : List Int) (j : Int) (hvalues : length values = n),
    0 ≤ n
      → current (scans b0 (butlast (counter i 1 n)) values) j
        = (if i ≤ j ∧ j ≤ i + n then
             b0 i + sum (elems («prefix» (j - i) values))
           else
             if ¬(i ≤ j ∧ j ≤ i + n) then b0 j else unspecified)

def Stmt.select_current_trace_recurrence : Prop :=
  ∀ (a0 : Int → Int) (n : Int) (c : Int) (j : Int) (G : Int → Int),
    current
      (trace
         a0
         (butlast (counter 0 1 n))
         (fun a i =>
            if i = 0 then
              fun j => if j = 0 then c else a j
            else
              if 0 < i then
                fun j => if j = i then a (i - 1) + G i else a j
              else
                unspecified))
      j
      = (if 0 ≤ j ∧ j < n then
           c + sum (elems (maps (butlast (counter 1 1 j)) (fun k => G k)))
         else
           if ¬(0 ≤ j ∧ j < n) then a0 j else unspecified)

noncomputable def pow (c : Int) (n : Int) : Int :=
  if n ≤ 0 then 1 else c * pow c (n - 1)
termination_by n.toNat
decreasing_by all_goals omega

def Stmt.pow_zero : Prop :=
  ∀ (c : Int) (n : Int),
    n ≤ 0 → pow c n = 1

def Stmt.pow_one : Prop :=
  ∀ (c : Int),
    pow c 1 = c

def Stmt.square_eq_self : Prop :=
  ∀ (c : Int),
    c * c = c ↔ c = 0 ∨ c = 1

def Stmt.mod_self : Prop :=
  ∀ (x : Int),
    0 < x → x % x = 0

def Stmt.double_eq_half : Prop :=
  ∀ (n : Int) (s : Int),
    2 * s = n + n * n ↔ s = (n + n * n) / 2

def Stmt.div_below : Prop :=
  ∀ (b : Int) (x : Int) (d : Int),
    0 < d ∧ 0 ≤ x ∧ x < d * (b + 1) → (b < x / d ↔ False)

def Stmt.div_nonpos : Prop :=
  ∀ (x : Int) (c : Int),
    0 < c → (x / c ≤ 0 ↔ x < c)

def Stmt.mul_lt_cancel : Prop :=
  ∀ (k : Int) (a : Int) (b : Int),
    0 ≤ k → (k * a < k * b ↔ 0 < k ∧ a < b)

def Stmt.triangle_bound : Prop :=
  ∀ (n : Int),
    n ≤ (-n + n * n) / 2 + 1

def Stmt.triangle_nonneg : Prop :=
  ∀ (x : Int),
    0 ≤ (x + x * x) / 2

def Stmt.triangle_nonneg_below : Prop :=
  ∀ (x : Int),
    0 ≤ (-x + x * x) / 2

def Stmt.triangle_even : Prop :=
  ∀ (x : Int),
    2 * ((x + x * x) / 2) = x + x * x

def Stmt.triangle_even_below : Prop :=
  ∀ (x : Int),
    2 * ((-x + x * x) / 2) = -x + x * x

def Stmt.triangle_even_scaled : Prop :=
  ∀ (a : Int) (x : Int),
    2 * ((a * x + a * x * x) / 2) = a * x + a * x * x

def Stmt.triangle_even_below_scaled : Prop :=
  ∀ (a : Int) (x : Int),
    2 * ((-a * x + a * x * x) / 2) = -a * x + a * x * x

def Stmt.invs_agree_prefix : Prop :=
  ∀ (n : Int) (xs : List Int) (ys : List Int) (hxs : n ≤ length xs) (hys : n ≤ length ys),
    invs (butlast (counter 0 1 n)) (fun k => earlier k xs = earlier k ys)
      ↔ «prefix» n xs = «prefix» n ys

def Stmt.earlier_eq_prefix : Prop :=
  ∀ (j : Int) (n : Int) (xs : List Int) (ys : List Int),
    «prefix» n xs = «prefix» n ys ∧ 0 ≤ j ∧ j < n
      → (earlier j xs = earlier j ys ↔ True)

def Stmt.not_occurs_prefix : Prop :=
  ∀ (n : Int) (e : Int) (xs : List Int) (hxs : n ≤ length xs),
    invs (butlast (counter 0 1 n)) (fun k => earlier k xs ≠ e)
      ↔ ¬occurs e («prefix» n xs)

noncomputable def above_iterations (n : Int) (ts : List Int) : Prop :=
  invs (List.zip (butlast (counter 0 1 n)) ts) (fun ⟨k, t⟩ => k < t)

def Stmt.earlier_eq_not_occurs_prefix : Prop :=
  ∀ (j : Int) (n : Int) (e : Int) (xs : List Int) (hxs : n ≤ length xs),
    ¬occurs e («prefix» n xs) ∧ 0 ≤ j ∧ j < n → (earlier j xs = e ↔ False)

def Stmt.earlier_above_iterations : Prop :=
  ∀ (j : Int) (n : Int) (ts : List Int) (n1 : Int) (hts : length ts = n1) (hn : n1 = n),
    above_iterations n ts ∧ 0 ≤ j ∧ j < n → (j < earlier j ts ↔ True)

def Stmt.invs_select_store_ne : Prop :=
  ∀ (x : Int) (a : Int → Int) (j : Int) (i : Int) (n : Int),
    invs
      (butlast (counter i 1 n))
      (fun k => (fun j1 => if j1 = j then x else a j1) k ≠ x)
      ↔ ¬(i ≤ j ∧ j < i + n) ∧ invs (butlast (counter i 1 n)) (fun k => a k ≠ x)

def Stmt.not_occurs_selects : Prop :=
  ∀ (a : Int → Int) (x : Int) (i : Int) (n : Int),
    invs (butlast (counter i 1 n)) (fun k => a k ≠ x)
      ↔ ¬occurs x (selects a (butlast (counter i 1 n)))

def Stmt.select_eq_not_occurs_selects : Prop :=
  ∀ (k : Int) (a : Int → Int) (x : Int) (i : Int) (n : Int),
    ¬occurs x (selects a (butlast (counter i 1 n))) ∧ i ≤ k ∧ k < i + n
      → (a k = x ↔ False)

noncomputable def bisection (l0 : Int) (h0 : Int) (ks : List Int)
                            (M : Int → Int → Int) (G : Int → Prop)
                            (H : Int → Prop) : Trace (Int × Int) :=
  trace
    (l0,
     h0)
    ks
    (fun ⟨lo, hi⟩ k =>
       (if G (M lo hi) ∧ lo < hi then
          M lo hi + 1
        else
          if H (M lo hi) ∧ ¬G (M lo hi) ∧ lo < hi then
            lo
          else
            if ¬lo < hi ∨ ¬(G (M lo hi) ∨ H (M lo hi)) then lo else unspecified,
        if G (M lo hi) ∧ lo < hi then
          hi
        else
          if H (M lo hi) ∧ ¬G (M lo hi) ∧ lo < hi then
            M lo hi
          else
            if ¬lo < hi ∨ ¬(G (M lo hi) ∨ H (M lo hi)) then
              hi
            else
              unspecified))

def Stmt.bisection_lo : Prop :=
  ∀ (l0 : Int) (h0 : Int) (ks : List Int) (M : Int → Int → Int) (G : Int → Prop) (H : Int → Prop) (n : Int) (hks : length ks = n),
    l0 ≤ h0
      ∧ (∀ (l : Int) (h : Int), l < h → l ≤ M l h ∧ M l h < h)
      ∧ (∀ (p : Int) (q : Int), l0 ≤ p ∧ p ≤ q ∧ q < h0 ∧ G q → G p)
      → l0 ≤ (current (bisection l0 h0 ks M G H)).1
        ∧ (current (bisection l0 h0 ks M G H)).1 ≤ cut G l0 h0

def Stmt.bisection_hi : Prop :=
  ∀ (l0 : Int) (h0 : Int) (ks : List Int) (M : Int → Int → Int) (G : Int → Prop) (H : Int → Prop) (n : Int) (hks : length ks = n),
    l0 ≤ h0
      ∧ (∀ (l : Int) (h : Int), l < h → l ≤ M l h ∧ M l h < h)
      ∧ (∀ (p : Int) (q : Int), l0 ≤ p ∧ p ≤ q ∧ q < h0 ∧ H p → H q)
      → cut (fun (j : Int) => ¬H j) l0 h0 ≤ (current (bisection l0 h0 ks M G H)).2
        ∧ (current (bisection l0 h0 ks M G H)).2 ≤ h0

noncomputable def sorted (a : Int → Int) (lo : Int) (hi : Int) : Prop :=
  ∀ (i : Int) (j : Int), lo ≤ i ∧ i ≤ j ∧ j < hi → a i ≤ a j

noncomputable def perm (a : Int → Int) (b : Int → Int) : Prop :=
  ∃ (f : Int → Int) (g : Int → Int),
    (∀ (i : Int), g (f i) = i)
      ∧ (∀ (i : Int), f (g i) = i)
      ∧ (∀ (i : Int), a i = b (f i))

noncomputable def partitioned (a : Int → Int) (lo : Int) (mid : Int)
                              (hi : Int) : Prop :=
  ∀ (i : Int) (j : Int), lo ≤ i ∧ i < mid ∧ mid ≤ j ∧ j < hi → a i ≤ a j

def Stmt.sorted_empty : Prop :=
  ∀ (a : Int → Int) (lo : Int),
    sorted a lo lo ↔ True

def Stmt.sorted_short : Prop :=
  ∀ (a : Int → Int) (lo : Int) (hi : Int),
    hi ≤ lo + 1 → (sorted a lo hi ↔ True)

def Stmt.partitioned_empty : Prop :=
  ∀ (a : Int → Int) (lo : Int) (hi : Int),
    partitioned a lo lo hi ↔ True

def Stmt.partitioned_whole : Prop :=
  ∀ (a : Int → Int) (lo : Int) (hi : Int),
    partitioned a lo hi hi ↔ True

def Stmt.sorted_adjacent : Prop :=
  ∀ (a : Int → Int) (n : Int),
    invs
      (List.zip (butlast (counter 0 1 n)) (butlast (counter 1 1 n)))
      (fun ⟨k, i⟩ => a k ≤ a i)
      ↔ sorted a 0 (n + 1)

def Stmt.perm_refl : Prop :=
  ∀ (a : Int → Int),
    perm a a ↔ True

noncomputable def swap (a : Int → Int) (p : Int) (q : Int) : Int → Int :=
  fun j => if j = q then a p else (fun j => if j = p then a q else a j) j

def Stmt.select_swap : Prop :=
  ∀ (a : Int → Int) (p : Int) (q : Int) (j : Int),
    swap a p q j
      = (if j = q then
           a p
         else
           if j ≠ q ∧ j = p then
             a q
           else
             if j ≠ q ∧ j ≠ p then a j else unspecified)

def Stmt.perm_swap : Prop :=
  ∀ (a : Int → Int) (b : Int → Int) (p : Int) (q : Int),
    perm (swap a p q) b ↔ perm a b

def Stmt.perm_swaps : Prop :=
  ∀ (a : Int → Int) (b : Int → Int) (ks : List Int) (hs : List Int) (P : (Int → Int) → Int → Int → Int) (Q : (Int → Int) → Int → Int → Int) (n : Int) (hks : length ks = n) (hhs : length hs = n),
    perm
      (current
         (trace a (List.zip ks hs) (fun x ⟨k, h⟩ => swap x (P x k h) (Q x k h))))
      b
      ↔ perm a b

def Stmt.perm_steps_three : Prop :=
  ∀ (a : Int → Int) (c : Int → Int) (ks : List Int) (ns : List Int) (is : List Int) (F : (Int → Int) → Int → Int → Int → Int → Int) (n : Int) (hks : length ks = n) (hns : length ns = n) (his : length is = n),
    (∀ (b : Int → Int) (k : Int) (nn : Int) (i : Int), perm (F b k nn i) b)
      → (perm
           (current
              (trace
                 a
                 (List.zip ks (List.zip ns is))
                 (fun b ⟨k, nn, i⟩ => F b k nn i)))
           c
           ↔ perm a c)

def Stmt.sorted_prefix_steps : Prop :=
  ∀ (a : Int → Int) (n : Int) (m : Int) (F : (Int → Int) → Int → Int → Int),
    n = m
      ∧ (∀ (b : Int → Int) (k : Int),
           0 ≤ k ∧ k < n ∧ sorted b 0 k ∧ partitioned b 0 k n
             → sorted (F b k) 0 (k + 1) ∧ partitioned (F b k) 0 (k + 1) n)
      → (sorted
           (current (trace a (butlast (counter 0 1 m)) (fun b k => F b k)))
           0
           n
           ↔ True)

def Stmt.sorted_prefix_steps_two : Prop :=
  ∀ (a : Int → Int) (n : Int) (m : Int) (F : (Int → Int) → Int → Int → Int → Int),
    n ≤ m + 1
      ∧ (∀ (b : Int → Int) (k : Int) (i : Int),
           0 ≤ i ∧ sorted b 0 i → sorted (F b k i) 0 (i + 1))
      → (sorted
           (current
              (trace
                 a
                 (List.zip (butlast (counter 0 1 m)) (butlast (counter 1 1 m)))
                 (fun b ⟨k, i⟩ => F b k i)))
           0
           n
           ↔ True)

noncomputable def lower (ar : Int → Int) (len : Int) (y : Int) : Int :=
  cut (fun (j : Int) => ar j < y) 0 len

noncomputable def upper (ar : Int → Int) (len : Int) (y : Int) : Int :=
  cut (fun (j : Int) => ar j ≤ y) 0 len

def Stmt.lower_rule : Prop :=
  ∀ (ar : Int → Int) (len : Int) (y : Int) (m : Int),
    sorted ar 0 len ∧ 0 ≤ m ∧ m < len → (ar m < y ↔ m < lower ar len y)

def Stmt.upper_rule : Prop :=
  ∀ (ar : Int → Int) (len : Int) (y : Int) (m : Int),
    sorted ar 0 len ∧ 0 ≤ m ∧ m < len → (y < ar m ↔ upper ar len y ≤ m)

def Stmt.lower_le : Prop :=
  ∀ (ar : Int → Int) (len : Int) (y : Int) (m : Int),
    sorted ar 0 len ∧ 0 ≤ m ∧ m < len → (y ≤ ar m ↔ lower ar len y ≤ m)

def Stmt.equal : Prop :=
  ∀ (ar : Int → Int) (len : Int) (y : Int) (m : Int),
    sorted ar 0 len ∧ 0 ≤ m ∧ m < len
      → (ar m = y ↔ lower ar len y ≤ m ∧ m < upper ar len y)

def Stmt.bounds : Prop :=
  ∀ (ar : Int → Int) (len : Int) (y : Int),
    sorted ar 0 len ∧ 0 ≤ len
      → 0 ≤ lower ar len y
        ∧ lower ar len y ≤ upper ar len y
        ∧ upper ar len y ≤ len

def Stmt.cut_lower : Prop :=
  ∀ (ar : Int → Int) (len : Int) (y : Int),
    sorted ar 0 len ∧ 0 ≤ len
      → cut (fun (j : Int) => ar j < y) 0 len = lower ar len y

def Stmt.lower_succ : Prop :=
  ∀ (ar : Int → Int) (len : Int) (y : Int),
    sorted ar 0 len → lower ar len (y + 1) = upper ar len y

def Stmt.trace_read_initial : Prop :=
  ∀ {α β : Type} [Inhabited α] [Inhabited β] (a : α → β) (keys : List α) (fs : List (β → β)) (n : Int) (hkeys : length keys = n) (hfs : length fs = n),
    distincts keys
      → trace
        a
        (List.zip keys fs)
        (fun b ⟨k, f⟩ => fun j => if j = k then f (b k) else b j)
        = trace
          a
          (List.zip keys fs)
          (fun b ⟨k, f⟩ => fun j => if j = k then f (a k) else b j)

def Stmt.current_trace_row : Prop :=
  ∀ (A0 : Int → Int → Int) (r : Int) (n : Int) (V : Int → Int),
    current
      (trace
         A0
         (butlast (counter 0 1 n))
         (fun A j =>
            fun j1 =>
              if j1 = r then fun j1 => if j1 = j then V j else A r j1 else A j1))
      = (fun j =>
           if j = r then
             current
               (trace
                  (A0 r)
                  (butlast (counter 0 1 n))
                  (fun b j => fun j1 => if j1 = j then V j else b j1))
           else
             A0 j)

def Stmt.stores_cases : Prop :=
  ∀ (a0 : Int → Int) (n : Int) (c : Int) (P : Int → Prop) (G : Int → Int),
    trace
      a0
      (butlast (counter 0 1 n))
      (fun a k =>
         if P (a k) then
           fun j => if j = k then c else a j
         else
           if ¬P (a k) then
             fun j => if j = k then G (a k) else a j
           else
             unspecified)
      = stores
        a0
        (butlast (counter 0 1 n))
        (maps
           (butlast (counter 0 1 n))
           (fun k =>
              if P (a0 k) then
                c
              else
                if ¬P (a0 k) then G (a0 k) else unspecified))

def Stmt.stores_read_unmodified : Prop :=
  ∀ (a0 : Int → Int) (n : Int) (hs : List Int) (F : Int → Int → Int) (hhs : length hs = n),
    invs (List.zip (butlast (counter 0 1 n)) hs) (fun ⟨k, h⟩ => n ≤ F k h)
      → trace
        a0
        (List.zip (butlast (counter 0 1 n)) hs)
        (fun a ⟨k, h⟩ => fun j => if j = k then a (F k h) else a j)
        = stores
          a0
          (butlast (counter 0 1 n))
          (maps
             (List.zip (butlast (counter 0 1 n)) hs)
             (fun ⟨k, h⟩ => a0 (F k h)))

def Stmt.select_current_trace_reset_keep : Prop :=
  ∀ (a0 : Int → Int) (j : Int) (n : Int) (c : Int),
    current
      (trace
         a0
         (butlast (counter 0 1 n))
         (fun a k =>
            if k = 0 then
              fun j1 => if j1 = j then c else a j1
            else
              if 0 < k then a else unspecified))
      j
      = (if n ≤ 0 then a0 j else if 0 < n then c else unspecified)

def Stmt.select_current_shifts : Prop :=
  ∀ (a : Int → Int) (i : Int) (n : Int) (j : Int),
    0 ≤ n
      → current (shifts a (butlast (counter i 1 n))) j
        = (if i ≤ j ∧ j < i + n then
             a (j + 1)
           else
             if ¬(i ≤ j ∧ j < i + n) then a j else unspecified)

def Stmt.selects_stores_counter : Prop :=
  ∀ (a : Int → Int) (i : Int) (c : Int) (n : Int) (vs : List Int) (hvs : length vs = n),
    c ≠ 0
      → selects
        (current (stores a (butlast (counter i c n)) vs))
        (butlast (counter i c n))
        = vs

noncomputable def stores_where (a : Int → Int) (i : Int) (c : Int) (n : Int)
                               (guards : List Prop)
                               (values : List Int) : Trace (Int → Int) :=
  trace
    a
    (List.zip (butlast (counter i c n)) (List.zip guards values))
    (fun b ⟨k, g, v⟩ =>
       if g then
         fun j => if j = k then v else b j
       else
         if ¬g then b else unspecified)

def Stmt.length_stores_where : Prop :=
  ∀ (a : Int → Int) (i : Int) (c : Int) (n : Int) (guards : List Prop) (values : List Int) (n1 : Int) (hguards : length guards = n1) (hvalues : length values = n1) (hn : n1 = n),
    0 ≤ n → length (butlast (stores_where a i c n guards values)) = n

def Stmt.earlier_stores_where : Prop :=
  ∀ (j : Int) (a : Int → Int) (i : Int) (c : Int) (n : Int) (guards : List Prop) (values : List Int) (n1 : Int) (hguards : length guards = n1) (hvalues : length values = n1) (hn : n1 = n),
    0 ≤ j ∧ j < n →
      (earlier j (butlast (stores_where a i c n guards values))
         = current (stores_where a i c j («prefix» j guards) («prefix» j values)))

def Stmt.prefix_stores_where : Prop :=
  ∀ (k : Int) (a : Int → Int) (i : Int) (c : Int) (n : Int) (guards : List Prop) (values : List Int) (n1 : Int) (hguards : length guards = n1) (hvalues : length values = n1) (hn : n1 = n),
    «prefix» k (butlast (stores_where a i c n guards values))
      = butlast (stores_where a i c k («prefix» k guards) («prefix» k values))

def Stmt.select_current_stores_where : Prop :=
  ∀ (a0 : Int → Int) (i : Int) (c : Int) (n : Int) (guards : List Prop) (values : List Int) (j : Int) (n1 : Int) (hguards : length guards = n1) (hvalues : length values = n1) (hn : n1 = n),
    c ≠ 0
      → current (stores_where a0 i c n guards values) j
        = (if occurs j (butlast (counter i c n))
             ∧ earlier (indexof j (butlast (counter i c n))) guards then
             earlier (indexof j (butlast (counter i c n))) values
           else
             if ¬(occurs j (butlast (counter i c n))
                    ∧ earlier (indexof j (butlast (counter i c n))) guards) then
               a0 j
             else
               unspecified)

def Stmt.select_current_trace_cap : Prop :=
  ∀ (a0 : Int → Int) (n : Int) (j : Int) (b : Int),
    current
      (trace
         a0
         (butlast (counter 0 1 n))
         (fun a k =>
            if a k < b then
              a
            else
              if b ≤ a k then fun j => if j = k then b else a j else unspecified))
      j
      = (if 0 ≤ j ∧ j < n ∧ b ≤ a0 j then
           b
         else
           if ¬(0 ≤ j ∧ j < n ∧ b ≤ a0 j) then a0 j else unspecified)

noncomputable def copies (a : Int → Int) (ks : List Int) (ls : List Int)
                         (S : Int → Int) : Trace (Int → Int) :=
  trace
    a
    (List.zip ks ls)
    (fun b ⟨p, q⟩ =>
       fun j => if j = q then S q else (fun j => if j = p then S p else b j) j)

def Stmt.length_copies : Prop :=
  ∀ (a : Int → Int) (ks : List Int) (ls : List Int) (S : Int → Int) (n : Int) (hks : length ks = n) (hls : length ls = n),
    length (butlast (copies a ks ls S)) = length ks

def Stmt.earlier_copies : Prop :=
  ∀ (j : Int) (a : Int → Int) (ks : List Int) (ls : List Int) (S : Int → Int) (n : Int) (hks : length ks = n) (hls : length ls = n),
    0 ≤ j ∧ j < n →
      (earlier j (butlast (copies a ks ls S))
         = current (copies a («prefix» j ks) («prefix» j ls) S))

def Stmt.prefix_copies : Prop :=
  ∀ (k : Int) (a : Int → Int) (ks : List Int) (ls : List Int) (S : Int → Int) (n : Int) (hks : length ks = n) (hls : length ls = n),
    «prefix» k (butlast (copies a ks ls S))
      = butlast (copies a («prefix» k ks) («prefix» k ls) S)

def Stmt.select_current_copies : Prop :=
  ∀ (a0 : Int → Int) (ks : List Int) (ls : List Int) (S : Int → Int) (j : Int) (n : Int) (hks : length ks = n) (hls : length ls = n),
    current (copies a0 ks ls S) j
      = (if occurs j ks ∨ occurs j ls then
           S j
         else
           if ¬(occurs j ks ∨ occurs j ls) then a0 j else unspecified)

def Stmt.store_select_other : Prop :=
  ∀ (a : Int → Int) (i : Int) (j : Int) (v : Int),
    i ≠ j
      → (fun j1 => if j1 = j then a j else (fun j => if j = i then v else a j) j1)
        = (fun j => if j = i then v else a j)

def Stmt.current_trace_constant : Prop :=
  ∀ {α : Type} [Inhabited α] (x : α) (y : α) (i : Int) (c : Int) (n : Int),
    current (trace x (butlast (counter i c n)) (fun z v => y))
      = (if n ≤ 0 then x else if 0 < n then y else unspecified)

def Stmt.current_trace_last : Prop :=
  ∀ {α : Type} [Inhabited α] (x0 : α) (n : Int) (hs : List Int) (F : Int → Int → α) (hhs : length hs = n),
    current
      (trace x0 (List.zip (butlast (counter 0 1 n)) hs) (fun x ⟨k, h⟩ => F k h))
      = (if n ≤ 0 then
           x0
         else
           if 0 < n then F (n - 1) (earlier (n - 1) hs) else unspecified)

def Stmt.length_phases : Prop :=
  ∀ (x0 : Int) (m : Int) (n : Int) (F : Int → Int → Int) (G : Int → Int → Int),
    0 ≤ n → length (butlast (phases x0 m n F G)) = n

def Stmt.earlier_phases : Prop :=
  ∀ (j : Int) (x0 : Int) (m : Int) (n : Int) (F : Int → Int → Int) (G : Int → Int → Int),
    0 ≤ j ∧ j < n →
      (earlier j (butlast (phases x0 m n F G)) = current (phases x0 m j F G))

def Stmt.prefix_phases : Prop :=
  ∀ (k : Int) (x0 : Int) (m : Int) (n : Int) (F : Int → Int → Int) (G : Int → Int → Int),
    k ≤ n →
      («prefix» k (butlast (phases x0 m n F G)) = butlast (phases x0 m k F G))

def Stmt.trace_threshold : Prop :=
  ∀ (x0 : Int) (n : Int) (b : Int) (c : Int),
    x0 ≤ b ∧ 0 ≤ c
      → trace
        x0
        (butlast (counter 0 1 n))
        (fun x k => if x < b then x + 1 else if b ≤ x then x + c else unspecified)
        = phases
          x0
          (b - x0)
          n
          (fun (y : Int) (l : Int) => y + 1)
          (fun (y : Int) (l : Int) => y + c)

def Stmt.current_phases : Prop :=
  ∀ (x0 : Int) (m : Int) (n : Int) (F : Int → Int → Int) (G : Int → Int → Int),
    0 ≤ m ∧ 0 ≤ n
      → current (phases x0 m n F G)
        = (if n ≤ m then
             current (trace x0 (butlast (counter 0 1 n)) (fun x k => F x k))
           else
             if m < n then
               current
                 (trace
                    (current
                       (trace x0 (butlast (counter 0 1 m)) (fun x k => F x k)))
                    (butlast (counter 0 1 (n - m)))
                    (fun x k => G x (k + m)))
             else
               unspecified)

def Stmt.invs_phases_upper : Prop :=
  ∀ (x0 : Int) (m : Int) (n : Int) (F : Int → Int → Int) (G : Int → Int → Int) (B : Int),
    0 ≤ m ∧ (∀ (y : Int) (l : Int), y ≤ F y l ∧ y ≤ G y l)
      → (invs
           (List.zip (butlast (counter 0 1 n)) (butlast (phases x0 m n F G)))
           (fun ⟨k, x⟩ => x < B)
           ↔ n ≤ 0 ∨ current (phases x0 m (n - 1) F G) < B)

def Stmt.current_trace_catch_up : Prop :=
  ∀ (y0 : Int) (x0 : Int) (n : Int),
    0 ≤ n ∧ x0 ≤ y0
      → current
        (trace
           y0
           (List.zip (butlast (counter 0 1 n)) (butlast (counter x0 1 n)))
           (fun y ⟨k, x⟩ =>
              if y ≤ x then y + 1 else if x < y then y else unspecified))
        = (if x0 + n ≤ y0 then
             y0
           else
             if y0 < x0 + n then x0 + n else unspecified)

def Stmt.current_trace_flag : Prop :=
  ∀ {α : Type} [Inhabited α] (x0 : α) (c : α) (n : Int) (hs : List Int) (D : Int → Int → Prop) (hhs : length hs = n),
    current
      (trace
         x0
         (List.zip (butlast (counter 0 1 n)) hs)
         (fun f ⟨k, h⟩ => if D k h then c else if ¬D k h then f else unspecified))
      = (if invs
           (List.zip (butlast (counter 0 1 n)) hs)
           (fun ⟨k, h⟩ => ¬D k h) then
           x0
         else
           if ¬invs
             (List.zip (butlast (counter 0 1 n)) hs)
             (fun ⟨k, h⟩ => ¬D k h) then
             c
           else
             unspecified)

def Stmt.current_trace_bounded : Prop :=
  ∀ (x0 : Int) (n : Int) (lo : Int) (hi : Int) (C1 : Int → Prop) (C2 : Int → Prop) (C3 : Int → Prop) (F1 : Int → Int) (F2 : Int → Int) (F3 : Int → Int),
    lo ≤ x0
      ∧ x0 ≤ hi
      ∧ (∀ (y : Int), lo ≤ y ∧ y ≤ hi ∧ C1 y → lo ≤ F1 y ∧ F1 y ≤ hi)
      ∧ (∀ (y : Int), lo ≤ y ∧ y ≤ hi ∧ C2 y → lo ≤ F2 y ∧ F2 y ≤ hi)
      ∧ (∀ (y : Int), lo ≤ y ∧ y ≤ hi ∧ C3 y → lo ≤ F3 y ∧ F3 y ≤ hi)
      → (lo
           ≤ current
             (trace
                x0
                (butlast (counter 0 1 n))
                (fun x k =>
                   if C1 x then
                     F1 x
                   else
                     if C2 x then
                       F2 x
                     else
                       if C3 x then
                         F3 x
                       else
                         if ¬(C1 x ∨ C2 x ∨ C3 x) then x else unspecified))
           ∧ current
             (trace
                x0
                (butlast (counter 0 1 n))
                (fun x k =>
                   if C1 x then
                     F1 x
                   else
                     if C2 x then
                       F2 x
                     else
                       if C3 x then
                         F3 x
                       else
                         if ¬(C1 x ∨ C2 x ∨ C3 x) then x else unspecified))
             ≤ hi
           ↔ True)

def Stmt.occurs_counter_step : Prop :=
  ∀ (i : Int) (d : Int) (n : Int) (j : Int),
    0 ≤ n ∧ 0 < d
      → (occurs j (butlast (counter i d n))
           ↔ i ≤ j ∧ j < i + n * d ∧ (j - i) % d = 0)

def Stmt.indexof_counter_step : Prop :=
  ∀ (j : Int) (i : Int) (d : Int) (n : Int),
    0 < d ∧ i ≤ j ∧ j < i + n * d ∧ (j - i) % d = 0
      → indexof j (butlast (counter i d n)) = (j - i) / d

noncomputable def strides₂ (a : Int → Int) (keys : List Int) (xs₀ : List Int)
                           (xs₁ : List Int) : Trace (Int → Int) :=
  trace
    a
    (List.zip keys (List.zip xs₀ xs₁))
    (fun b ⟨p, x₀, x₁⟩ =>
       fun j =>
         if j = p + 1 then x₁ else (fun j => if j = p then x₀ else b j) j)

noncomputable def strides₃ (a : Int → Int) (keys : List Int) (xs₀ : List Int)
                           (xs₁ : List Int)
                           (xs₂ : List Int) : Trace (Int → Int) :=
  trace
    a
    (List.zip keys (List.zip xs₀ (List.zip xs₁ xs₂)))
    (fun b ⟨p, x₀, x₁, x₂⟩ =>
       fun j =>
         if j = p + 2 then
           x₂
         else
           (fun j =>
              if j = p + 1 then x₁ else (fun j => if j = p then x₀ else b j) j)
             j)

noncomputable def strides₄ (a : Int → Int) (keys : List Int) (xs₀ : List Int)
                           (xs₁ : List Int) (xs₂ : List Int)
                           (xs₃ : List Int) : Trace (Int → Int) :=
  trace
    a
    (List.zip keys (List.zip xs₀ (List.zip xs₁ (List.zip xs₂ xs₃))))
    (fun b ⟨p, x₀, x₁, x₂, x₃⟩ =>
       fun j =>
         if j = p + 3 then
           x₃
         else
           (fun j =>
              if j = p + 2 then
                x₂
              else
                (fun j =>
                   if j = p + 1 then
                     x₁
                   else
                     (fun j => if j = p then x₀ else b j) j)
                  j)
             j)

noncomputable def strides₅ (a : Int → Int) (keys : List Int) (xs₀ : List Int)
                           (xs₁ : List Int) (xs₂ : List Int) (xs₃ : List Int)
                           (xs₄ : List Int) : Trace (Int → Int) :=
  trace
    a
    (List.zip keys (List.zip xs₀ (List.zip xs₁ (List.zip xs₂ (List.zip xs₃ xs₄)))))
    (fun b ⟨p, x₀, x₁, x₂, x₃, x₄⟩ =>
       fun j =>
         if j = p + 4 then
           x₄
         else
           (fun j =>
              if j = p + 3 then
                x₃
              else
                (fun j =>
                   if j = p + 2 then
                     x₂
                   else
                     (fun j =>
                        if j = p + 1 then
                          x₁
                        else
                          (fun j => if j = p then x₀ else b j) j)
                       j)
                  j)
             j)

def Stmt.select_current_strides₂ : Prop :=
  ∀ (a0 : Int → Int) (o : Int) (s : Int) (n : Int) (xs₀ : List Int) (xs₁ : List Int) (j : Int) (hxs₀ : length xs₀ = n) (hxs₁ : length xs₁ = n),
    2 ≤ s
      → current (strides₂ a0 (butlast (counter o s n)) xs₀ xs₁) j
        = (if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 0 then
             earlier ((j - o) / s) xs₀
           else
             if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 1 then
               earlier ((j - o) / s) xs₁
             else
               if j - o < 0 ∨ s * n ≤ j - o ∨ 2 ≤ (j - o) % s then
                 a0 j
               else
                 unspecified)

def Stmt.select_current_strides₃ : Prop :=
  ∀ (a0 : Int → Int) (o : Int) (s : Int) (n : Int) (xs₀ : List Int) (xs₁ : List Int) (xs₂ : List Int) (j : Int) (hxs₀ : length xs₀ = n) (hxs₁ : length xs₁ = n) (hxs₂ : length xs₂ = n),
    3 ≤ s
      → current (strides₃ a0 (butlast (counter o s n)) xs₀ xs₁ xs₂) j
        = (if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 0 then
             earlier ((j - o) / s) xs₀
           else
             if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 1 then
               earlier ((j - o) / s) xs₁
             else
               if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 2 then
                 earlier ((j - o) / s) xs₂
               else
                 if j - o < 0 ∨ s * n ≤ j - o ∨ 3 ≤ (j - o) % s then
                   a0 j
                 else
                   unspecified)

def Stmt.select_current_strides₄ : Prop :=
  ∀ (a0 : Int → Int) (o : Int) (s : Int) (n : Int) (xs₀ : List Int) (xs₁ : List Int) (xs₂ : List Int) (xs₃ : List Int) (j : Int) (hxs₀ : length xs₀ = n) (hxs₁ : length xs₁ = n) (hxs₂ : length xs₂ = n) (hxs₃ : length xs₃ = n),
    4 ≤ s
      → current (strides₄ a0 (butlast (counter o s n)) xs₀ xs₁ xs₂ xs₃) j
        = (if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 0 then
             earlier ((j - o) / s) xs₀
           else
             if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 1 then
               earlier ((j - o) / s) xs₁
             else
               if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 2 then
                 earlier ((j - o) / s) xs₂
               else
                 if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 3 then
                   earlier ((j - o) / s) xs₃
                 else
                   if j - o < 0 ∨ s * n ≤ j - o ∨ 4 ≤ (j - o) % s then
                     a0 j
                   else
                     unspecified)

def Stmt.select_current_strides₅ : Prop :=
  ∀ (a0 : Int → Int) (o : Int) (s : Int) (n : Int) (xs₀ : List Int) (xs₁ : List Int) (xs₂ : List Int) (xs₃ : List Int) (xs₄ : List Int) (j : Int) (hxs₀ : length xs₀ = n) (hxs₁ : length xs₁ = n) (hxs₂ : length xs₂ = n) (hxs₃ : length xs₃ = n) (hxs₄ : length xs₄ = n),
    5 ≤ s
      → current (strides₅ a0 (butlast (counter o s n)) xs₀ xs₁ xs₂ xs₃ xs₄) j
        = (if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 0 then
             earlier ((j - o) / s) xs₀
           else
             if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 1 then
               earlier ((j - o) / s) xs₁
             else
               if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 2 then
                 earlier ((j - o) / s) xs₂
               else
                 if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 3 then
                   earlier ((j - o) / s) xs₃
                 else
                   if 0 ≤ j - o ∧ j - o < s * n ∧ (j - o) % s = 4 then
                     earlier ((j - o) / s) xs₄
                   else
                     if j - o < 0 ∨ s * n ≤ j - o ∨ 5 ≤ (j - o) % s then
                       a0 j
                     else
                       unspecified)

def Stmt.select_current_tiles : Prop :=
  ∀ (a0 : Int → Int) (n : Int) (m : Int) (hs : List Int) (V : Int → List Int) (j : Int) (hhs : length hs = n) (hV : ∀ k, 0 ≤ k ∧ k < n → m ≤ length (V k)),
    0 < m
      → current
        (trace
           a0
           (List.zip (butlast (counter 0 1 n)) hs)
           (fun b ⟨k, h⟩ =>
              current
                (stores
                   b
                   (maps (butlast (counter 0 1 m)) (fun l => l + m * k))
                   (V k))))
        j
        = (if 0 ≤ j ∧ j < m * n then
             earlier (j % m) (V (j / m))
           else
             if ¬(0 ≤ j ∧ j < m * n) then a0 j else unspecified)

def Stmt.select_current_trace_ahead : Prop :=
  ∀ (a0 : Int → Int) (n : Int) (m : Int) (F : Int → Int) (G : Int → Int) (j : Int),
    n ≤ m
      → current
        (trace
           a0
           (butlast (counter 0 1 n))
           (fun a k =>
              if k + 1 < m then
                fun j =>
                  if j = k then
                    G k
                  else
                    (fun j => if j = k + 1 then F k else a j) j
              else
                if m = k + 1 then
                  fun j => if j = k then G k else a j
                else
                  unspecified))
        j
        = (if 0 ≤ j ∧ j < n then
             G j
           else
             if j = n ∧ 0 < j ∧ j < m then
               F (j - 1)
             else
               if ¬(0 ≤ j ∧ j < n) ∧ ¬(j = n ∧ 0 < j ∧ j < m) then
                 a0 j
               else
                 unspecified)

def Stmt.select_current_trace_ahead_down : Prop :=
  ∀ (a0 : Int → Int) (n : Int) (s : Int) (d : Int) (P : Int → Prop) (F : Int → Int) (G : Int → Int) (j : Int),
    d = s - 1
      → current
        (trace
           a0
           (List.zip (butlast (counter 0 1 n)) (butlast (counter s (-1) n)))
           (fun a ⟨k, i⟩ =>
              if P k then
                fun j =>
                  if j = i then
                    G i
                  else
                    (fun j => if j = d - k then F k else a j) j
              else
                if ¬P k then
                  fun j => if j = i then G i else a j
                else
                  unspecified))
        j
        = (if s - n < j ∧ j ≤ s then
             G j
           else
             if j = s - n ∧ 0 < n ∧ P (n - 1) then
               F (n - 1)
             else
               if ¬(s - n < j ∧ j ≤ s) ∧ ¬(j = s - n ∧ 0 < n ∧ P (n - 1)) then
                 a0 j
               else
                 unspecified)

noncomputable def mods (i : Int) (c : Int) (m : Int) (n : Int) : Trace Int :=
  trace i (butlast (counter 0 1 n)) (fun x k => (x + c) % m)

def Stmt.length_mods : Prop :=
  ∀ (i : Int) (c : Int) (m : Int) (n : Int),
    0 ≤ n → length (butlast (mods i c m n)) = n

def Stmt.invs_mods_upper : Prop :=
  ∀ (b : Int) (i : Int) (c : Int) (m : Int) (n : Int),
    0 ≤ i ∧ i < b ∧ 0 < c ∧ b + c ≤ m
      → (invs (butlast (mods i c m n)) (fun x => x < b) ↔ i + (n - 1) * c < b)

def Stmt.invs_mods_upper_cases : Prop :=
  ∀ (b : Int) (i : Int) (c : Int) (m : Int) (n : Int),
    0 ≤ i ∧ i < m ∧ 0 < c ∧ b + c ≤ m
      → (invs (butlast (mods i c m n)) (fun x => x < b)
           ↔ n ≤ 0 ∨ i + (n - 1) * c < b)

def Stmt.invs_mods_down : Prop :=
  ∀ (i : Int) (c : Int) (m : Int) (n : Int),
    0 < i ∧ i < m ∧ c < m ∧ i % (m - c) = 0
      → (invs (butlast (mods i c m n)) (fun x => 0 < x)
           ↔ 0 < i - (n - 1) * (m - c))

def Stmt.invs_mods_down_cases : Prop :=
  ∀ (i : Int) (c : Int) (m : Int) (n : Int),
    0 ≤ i ∧ i < m ∧ c < m ∧ i % (m - c) = 0
      → (invs (butlast (mods i c m n)) (fun x => 0 < x)
           ↔ n ≤ 0 ∨ 0 < i - (n - 1) * (m - c))

def Stmt.current_mods_up : Prop :=
  ∀ (i : Int) (c : Int) (m : Int) (n : Int),
    0 ≤ n ∧ 0 ≤ i + n * c ∧ i + n * c < m → current (mods i c m n) = i + n * c

def Stmt.current_mods : Prop :=
  ∀ (i : Int) (c : Int) (m : Int) (n : Int),
    0 ≤ n ∧ 0 ≤ i ∧ i < m → current (mods i c m n) = (i + n * c) % m

def Stmt.butlast_mods_up : Prop :=
  ∀ (i : Int) (c : Int) (m : Int) (n : Int),
    0 ≤ i ∧ 0 ≤ c ∧ i + (n - 1) * c < m
      → butlast (mods i c m n) = butlast (counter i c n)

def Stmt.invs_counter_mod_upper_zero : Prop :=
  ∀ (b : Int) (m : Int) (n : Int),
    0 < b ∧ b < m
      → (invs (butlast (counter 0 1 n)) (fun k => k % m < b) ↔ n - 1 < b)

def Stmt.invs_counter_mod_upper_cases : Prop :=
  ∀ (b : Int) (i : Int) (m : Int) (n : Int),
    0 ≤ i ∧ i < m ∧ b < m
      → (invs (butlast (counter 0 1 n)) (fun k => (k + i) % m < b)
           ↔ n ≤ 0 ∨ i + n - 1 < b)

def Stmt.current_trace_mod_add_const : Prop :=
  ∀ (x0 : Int) (n : Int) (m : Int) (c : Int),
    0 ≤ x0 ∧ x0 < m
      → current (trace x0 (butlast (counter 0 1 n)) (fun x k => (k + x + c) % m))
        = current (trace x0 (butlast (counter 0 1 n)) (fun x k => k + x + c)) % m

def Stmt.current_trace_mod_add_cases : Prop :=
  ∀ (x0 : Int) (n : Int) (m : Int) (C : Int → Prop) (F : Int → Int),
    0 ≤ x0 ∧ x0 < m
      → current
        (trace
           x0
           (butlast (counter 0 1 n))
           (fun x k =>
              if C k then (x + F k) % m else if ¬C k then x else unspecified))
        = current
          (trace
             x0
             (butlast (counter 0 1 n))
             (fun x k =>
                if C k then x + F k else if ¬C k then x else unspecified))
          % m

def Stmt.current_trace_mod_affine_wrapped : Prop :=
  ∀ (y : Int) (m : Int) (n : Int) (hs : List Int) (A : Int → Int → Int) (B : Int → Int → Int) (hhs : length hs = n),
    0 < m
      → current
        (trace
           (y % m)
           (List.zip (butlast (counter 0 1 n)) hs)
           (fun x ⟨k, h⟩ => (x * A k h + B k h) % m))
        = current
          (trace
             y
             (List.zip (butlast (counter 0 1 n)) hs)
             (fun x ⟨k, h⟩ => x * A k h + B k h))
          % m

def Stmt.current_trace_mod_affine : Prop :=
  ∀ (x0 : Int) (m : Int) (n : Int) (hs : List Int) (A : Int → Int → Int) (B : Int → Int → Int) (hhs : length hs = n),
    0 < m ∧ 0 ≤ x0 ∧ x0 < m
      → current
        (trace
           x0
           (List.zip (butlast (counter 0 1 n)) hs)
           (fun x ⟨k, h⟩ => (x * A k h + B k h) % m))
        = current
          (trace
             x0
             (List.zip (butlast (counter 0 1 n)) hs)
             (fun x ⟨k, h⟩ => x * A k h + B k h))
          % m

def Stmt.current_trace_mod_mul : Prop :=
  ∀ (x0 : Int) (m : Int) (n : Int) (hs : List Int) (A : Int → Int → Int) (hhs : length hs = n),
    0 < m ∧ 0 ≤ x0 ∧ x0 < m
      → current
        (trace
           x0
           (List.zip (butlast (counter 0 1 n)) hs)
           (fun x ⟨k, h⟩ => x * A k h % m))
        = current
          (trace
             x0
             (List.zip (butlast (counter 0 1 n)) hs)
             (fun x ⟨k, h⟩ => x * A k h))
          % m

noncomputable def squares (i : Int) (n : Int) : Int :=
  sum (elems (maps (butlast (counter i 1 n)) (fun k => k * k)))

noncomputable def cubes (i : Int) (n : Int) : Int :=
  sum (elems (maps (butlast (counter i 1 n)) (fun k => k * k * k)))

noncomputable def fourths (i : Int) (n : Int) : Int :=
  sum (elems (maps (butlast (counter i 1 n)) (fun k => k * k * k * k)))

noncomputable def fifths (i : Int) (n : Int) : Int :=
  sum (elems (maps (butlast (counter i 1 n)) (fun k => k * k * k * k * k)))

def Stmt.squares_zero : Prop :=
  ∀ (i : Int) (n : Int),
    n ≤ 0 → squares i n = 0

def Stmt.cubes_zero : Prop :=
  ∀ (i : Int) (n : Int),
    n ≤ 0 → cubes i n = 0

def Stmt.fourths_zero : Prop :=
  ∀ (i : Int) (n : Int),
    n ≤ 0 → fourths i n = 0

def Stmt.fifths_zero : Prop :=
  ∀ (i : Int) (n : Int),
    n ≤ 0 → fifths i n = 0

def Stmt.squares_closed : Prop :=
  ∀ (i : Int) (n : Int),
    0 ≤ n
      → 6 * squares i n
        = (i + n - 1) * (i + n) * (2 * (i + n) - 1) - (i - 1) * i * (2 * i - 1)

def Stmt.cubes_closed : Prop :=
  ∀ (i : Int) (n : Int),
    0 ≤ n
      → 4 * cubes i n
        = (i + n) * (i + n) * (i + n - 1) * (i + n - 1)
          - i * i * (i - 1) * (i - 1)

def Stmt.fourths_closed : Prop :=
  ∀ (i : Int) (n : Int),
    0 ≤ n
      → 30 * fourths i n
        = (i + n) * (i + n - 1) * (2 * (i + n) - 1)
          * (3 * (i + n) * (i + n) - 3 * (i + n) - 1)
          - i * (i - 1) * (2 * i - 1) * (3 * i * i - 3 * i - 1)

def Stmt.fifths_closed : Prop :=
  ∀ (i : Int) (n : Int),
    0 ≤ n
      → 12 * fifths i n
        = (i + n) * (i + n) * (i + n - 1) * (i + n - 1)
          * (2 * (i + n) * (i + n) - 2 * (i + n) - 1)
          - i * i * (i - 1) * (i - 1) * (2 * i * i - 2 * i - 1)

noncomputable def series (x0 : Int) (z : Int) (a : Int) (n : Int) : Trace Int :=
  trace x0 (butlast (counter 0 1 n)) (fun x k => x * z + a)

def Stmt.length_series : Prop :=
  ∀ (x0 : Int) (z : Int) (a : Int) (n : Int),
    0 ≤ n → length (butlast (series x0 z a n)) = n

def Stmt.current_series_zero : Prop :=
  ∀ (x0 : Int) (z : Int) (a : Int) (n : Int),
    n ≤ 0 → current (series x0 z a n) = x0

def Stmt.current_series_one : Prop :=
  ∀ (x0 : Int) (z : Int) (a : Int),
    current (series x0 z a 1) = x0 * z + a

def Stmt.current_series : Prop :=
  ∀ (x0 : Int) (z : Int) (a : Int) (n : Int),
    (z - 1) * current (series x0 z a n) + a = ((z - 1) * x0 + a) * pow z n

def Stmt.current_trace_geometric : Prop :=
  ∀ (y0 : Int) (z : Int) (n : Int),
    current (trace y0 (butlast (counter 0 1 n)) (fun y k => y * z)) = y0 * pow z n

