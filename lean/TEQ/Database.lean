def Stmt.current_trace_add_at : Prop :=
  ∀ {α : Type} [Inhabited α] (a : α → Int) (k : α) (values : List Int) (n : Nat) (hvalues : length values = n),
    current (trace a values (fun b v => fun j => if j = k then b k + v else b j))
