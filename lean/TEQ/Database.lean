def Stmt.div_nonpos : Prop :=
  ∀ (x : Int) (c : Int),
    0 < c → (x / c ≤ 0 ↔ x < c)

def Stmt.mul_lt_cancel : Prop :=
  ∀ (k : Int) (a : Int) (b : Int),
    0 ≤ k → (k * a < k * b ↔ 0 < k ∧ a < b)

def Stmt.pow_two_mod_three : Prop :=
