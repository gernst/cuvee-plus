          (maps (List.zip (butlast (counter i c n)) hs) (fun ⟨k, h⟩ => P k h))

def Stmt.count_true_eq : Prop :=
  ∀ (ks : List Int) (r : Int) (hs : List Int) (F : Int → Int → Int) (n : Nat) (hks : length ks = n) (hhs : length hs = n),
