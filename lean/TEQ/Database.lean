noncomputable def pow (c : Int) (n : Nat) : Int :=
  match n with
  | .zero => 1
  | .succ m => c * pow c m

def Stmt.mod_self : Prop :=
  ∀ (x : Int),
    0 < x → x % x = 0

def Stmt.double_eq_half : Prop :=
  ∀ (n : Int) (s : Int),
    2 * s = n + n * n ↔ s = (n + n * n) / 2

def Stmt.div_below : Prop :=
  ∀ (b : Int) (x : Int) (d : Int),
