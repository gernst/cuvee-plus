def Stmt.current_stores : Prop :=
  ∀ {α β : Type} [Inhabited α] [Inhabited β] (k : α) (a : α → β) (keys : List α) (values : List β) (n : Nat) (hkeys : length keys = n) (hvalues : length values = n),
