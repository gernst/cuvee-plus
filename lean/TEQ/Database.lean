def Stmt.prefix_counter : Prop :=
  ∀ (k : Nat) (i : Int) (c : Int) (n : Nat),
    integer k ≤ integer n →
      («prefix» k (butlast (counter i c n)) = butlast (counter i c k))

def Stmt.occurs_counter_up : Prop :=
  ∀ (j : Int) (i : Int) (n : Nat),
