  ∀ {α β : Type} [Inhabited α] [Inhabited β] (k : α) (j : Nat) (a : α → β) (keys : List α) (values : List β) (n : Nat) (hkeys : length keys = n) (hvalues : length values = n),
    integer j < integer n →
