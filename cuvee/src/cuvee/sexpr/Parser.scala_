package cuvee.sexpr

import java.io.Reader
import java.io.StringReader
import java.io.File
import java.io.FileReader

import scala.collection.mutable

import cuvee.Error

class Parser(scanner: Scanner):
  var _tok: Any = null
  var _peek: Any = null

  def shift() =
    val r = scanner.next
    r

  def peek() =
    if (_peek == null) // consume next token only when needed
      _peek = shift()
    _peek

  def next() =
    if _peek == null
    then
      _tok = shift()
      _tok
    else
      _tok = _peek
      _peek = null
      _tok

  def check(tok: Tok) =
    next() match
      case `tok` =>
      // ok
      case tok =>
        Error.report("unexpected token: " + tok)

  def sexpr(): Any =
    next() match
      case Tok.lp =>
        val args = sexprs()
        check(Tok.rp)
        args

      case atom: Atom =>
        atom

      case tok =>
        Error.report("unexpected token: " + tok)

  def sexprs(): List[Any] =
    val buf = mutable.Buffer[Any]()

    while peek() != Tok.eof && peek() != Tok.rp
    do buf += sexpr()

    buf.toList

  def eof() =
    check(Tok.eof)

  // only one instance per parser
  object iterator extends Iterator[Any]:
    def hasNext =
      peek() != Tok.eof

    def next() =
      sexpr()

object Parser:
  def apply(reader: Reader): Parser =
    val scanner = new Scanner(reader)
    val parser = new Parser(scanner)
    parser

  def apply(str: String): Parser =
    Parser(new StringReader(str))

  def sexpr(str: String) =
    val parser = Parser(str)
    val result = parser.sexpr()
    parser.eof()
    result

  def sexprs(str: String) =
    val parser = Parser(str)
    val result = parser.sexprs()
    parser.eof()
    result
